    # ---- locking and cleanup ------------------------------------------------

    def locked(self):
        return _Lock()

    def cleanup(self):
        """Undo what this process set up for itself, on every way out."""
        umount = self.find_tool("umount")
        for point in list(self.temp_mounts):
            if umount:
                try:
                    self.run_tool([umount, "--lazy", "--", point], None, 60)
                except (OSError, subprocess.SubprocessError):
                    pass
            try:
                os.rmdir(point)
            except OSError:
                pass
        self.temp_mounts = []
        for directory in list(self.fill_dirs):
            self._remove_fill(directory)

    # ---- the protocol ---------------------------------------------------------

    def run_job(self, request):
        """Carry out one operation and send its one final reply."""
        handler = self.OPERATIONS.get(request.get("op"))
        reply = {"id": request.get("id")}
        self.in_hand = request
        try:
            if handler is None:
                raise Refusal("Unknown operation.")
            reply.update(ok=True, result=handler(self, request))
        except Cancelled as exc:
            reply.update(
                ok=False, cancelled=True,
                error=str(exc) or (
                    "Stopped. The device was already being erased, so it "
                    "holds no usable filesystem until it is formatted."
                    if self.destroying else
                    "Stopped before anything on the device was changed."))
        except Refusal as exc:
            reply.update(ok=False, error=str(exc))
        except Exception as exc:
            # Running as root on someone's disk: a traceback must become an
            # answer the user can read, not a process that vanished.
            reply.update(ok=False, error="Internal error: %s: %s"
                         % (type(exc).__name__, exc))
        finally:
            self.flush_output()
            self.in_hand = None
            self.cancellable = False
            self.destroying = False
            self.cancel.clear()
            self.cleanup()
        self.send(reply)

    def handle(self, line):
        """Act on one line from the client."""
        try:
            request = json.loads(line)
            if not isinstance(request, dict):
                raise ValueError("not an object")
        except ValueError:
            self.send({"ok": False, "error": "unreadable request"})
            return
        command = request.get("cmd")
        ident = request.get("id")

        if command == "hello":
            if request.get("version") != PROTOCOL_VERSION:
                self.send({"id": ident, "ok": False,
                           "error": "unsupported protocol version",
                           "version": PROTOCOL_VERSION})
            else:
                self.send({"id": ident, "ok": True,
                           "version": PROTOCOL_VERSION})
        elif command == "ping":
            self.send({"id": ident, "ok": True})
        elif command == "cancel":
            self.cancel.set()
            self.send({"id": ident, "ok": True,
                       "cancellable": self.cancellable})
        elif command == "bye":
            self.finished = True
            self.send({"id": ident, "ok": True})
        elif command == "run":
            if self.job is not None and self.job.is_alive():
                self.send({"id": ident, "ok": False,
                           "error": "Another operation is still running."})
                return
            self.cancel.clear()
            self.job = threading.Thread(target=self.run_job, args=(request,),
                                        name="disk-job")
            self.job.start()
        else:
            self.send({"id": ident, "ok": False, "error": "unknown command"})

    def serve(self, stdin=None):
        """Take requests until the client goes away, then finish the job.

        select() rather than a blocking read so a cancel can arrive while an
        operation runs on its own thread. A client that disappears is not a
        request to stop: the user confirmed the operation, and a window that
        crashed has not changed their mind. The operation is carried through
        and this process exits when it is done.
        """
        stdin = stdin if stdin is not None else sys.stdin
        while not self.finished:
            try:
                ready, _, _ = select.select([stdin], [], [], 1.0)
            except (OSError, ValueError):
                break
            if not ready:
                continue
            line = stdin.readline()
            if not line:                 # EOF: the client exited or was killed
                break
            line = line.strip()
            if line:
                self.handle(line)
        self.wait_for_job()

    def wait_for_job(self):
        job = self.job
        if job is not None:
            job.join()
        self.cleanup()


class _Lock:
    """One disk operation at a time on this machine, across every copy of the
    application: an exclusive lock on a file under /run."""

    def __enter__(self):
        try:
            self.fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT, 0o600)
        except OSError as exc:
            raise Refusal("Cannot create the operation lock: %s" % exc)
        try:
            fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            os.close(self.fd)
            raise Refusal("Another disk operation is already running. Wait "
                          "for it to finish.")
        return self

    def __exit__(self, *_exc):
        try:
            fcntl.flock(self.fd, fcntl.LOCK_UN)
        finally:
            os.close(self.fd)
        return False


def _sha256_file(path):
    found = hashlib.sha256()
    with open(path, "rb") as handle:
        while True:
            chunk = handle.read(CHUNK)
            if not chunk:
                break
            found.update(chunk)
    return found.hexdigest()


def _megabytes(size):
    if size >= 1000 ** 3:
        return "%.1f GB" % (size / 1000.0 ** 3)
    return "%d MB" % (size // 1000 ** 2)


def main():
    helper = Helper()

    def stop(_signum, _frame):
        # A request to stop, not an order: the job thread honours it only at
        # a point where stopping leaves the disk in a state that makes sense.
        helper.cancel.set()
        helper.finished = True

    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, stop)

    try:
        helper.serve()
    finally:
        helper.wait_for_job()
    return 0


if __name__ == "__main__":
    sys.exit(main())
