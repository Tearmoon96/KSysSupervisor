class _Direct:
    """A device or file read past the page cache, where that is possible.

    What a verification has to read is what is on the medium, not what is
    still in memory from having just been written. Falls back to ordinary
    reads, with the cache told to drop the file first, where direct access
    is not supported.
    """

    def __init__(self, path):
        self.direct = True
        try:
            self.fd = os.open(path, os.O_RDONLY | os.O_DIRECT)
        except OSError:
            self.direct = False
            self.fd = os.open(path, os.O_RDONLY)
            try:
                os.posix_fadvise(self.fd, 0, 0, os.POSIX_FADV_DONTNEED)
            except OSError:
                pass
        self.buffer = mmap.mmap(-1, CHUNK) if self.direct else None

    def read(self, offset, count):
        if not self.direct:
            return os.pread(self.fd, count, offset)
        # Direct reads come in whole sectors; the buffer is page-aligned.
        whole = min(CHUNK, -(-count // 4096) * 4096)
        view = memoryview(self.buffer)[:whole]
        try:
            got = os.preadv(self.fd, [view], offset)
        except OSError as exc:
            if exc.errno != errno.EINVAL:
                raise
            # A filesystem that took the flag and then refuses the read.
            self.direct = False
            return os.pread(self.fd, count, offset)
        finally:
            view.release()
        return bytes(self.buffer[:min(got, count)])

    def close(self):
        os.close(self.fd)
        if self.buffer is not None:
            self.buffer.close()


def _in_ranges(offset, length, ranges):
    """Whether [offset, offset+length) touches any of the (start, length)
    `ranges`."""
    return any(offset < start + size and start < offset + length
               for start, size in ranges)


