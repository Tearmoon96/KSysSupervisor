def photorec_command(kinds=(), keep_damaged=False, loose=False):
    """PhotoRec's command: every family it trusts by default, only the ones
    named, or every one it has (`loose`); files that fail its own check
    skipped unless `keep_damaged`."""
    parts = ["partition_none"]
    if kinds:
        parts += ["fileopt", "everything", "disable"]
        for name in kinds:
            parts += [name, "enable"]
    elif loose:
        parts += ["fileopt", "everything", "enable"]
    if keep_damaged:
        parts += ["options", "keep_corrupted_file"]
    return ",".join(parts + ["wholespace", "search"])
