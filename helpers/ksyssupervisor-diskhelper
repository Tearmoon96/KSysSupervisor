# ---- reading the system --------------------------------------------------------

def _read(path):
    with open(path) as handle:
        return handle.read().strip()


def _read_int(path):
    try:
        return int(_read(path))
    except (OSError, ValueError):
        return None


def _unescape(text):
    """A mountinfo field with its octal escapes (\\040 is a space) undone."""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), text)


def is_system_mount(mountpoint):
    return (mountpoint in SYSTEM_MOUNTS
            or any(mountpoint.startswith(p) for p in SYSTEM_PREFIXES))


def _is_block_device(path, sysfs):
    """Whether `path` is the device node of the sysfs entry `sysfs`.

    Compared by device number against what the kernel publishes, so a regular
    file or a node for something else sitting under that name does not pass.
    """
    try:
        info = os.stat(path)
        if not stat.S_ISBLK(info.st_mode):
            return False
        want = _read(os.path.join(sysfs, "dev"))
    except OSError:
        return False
    return want == "%d:%d" % (os.major(info.st_rdev), os.minor(info.st_rdev))


class Device:
    """One block device as the kernel describes it right now."""

    def __init__(self, name):
        if not NAME_RE.match(name):
            raise Refusal("That is not a device name.")
        entry = os.path.join(SYS_CLASS_BLOCK, name)
        if not os.path.isdir(entry):
            raise Refusal("There is no device called %s any more. It may "
                          "have been unplugged." % name)
        self.name = name
        self.sysfs = os.path.realpath(entry)
        self.path = os.path.join(DEV_ROOT, name)
        self.is_partition = os.path.exists(os.path.join(entry, "partition"))
        self.disk = (os.path.basename(os.path.dirname(self.sysfs))
                     if self.is_partition else name)
        self.number = (_read_int(os.path.join(entry, "partition"))
                       if self.is_partition else None)
        sectors = _read_int(os.path.join(entry, "size"))
        # sysfs counts in 512-byte units whatever the drive's sector size is.
        self.size = None if sectors is None else sectors * 512
        self.start = (_read_int(os.path.join(entry, "start"))
                      if self.is_partition else None)
        self.read_only = _read_int(os.path.join(entry, "ro")) == 1
        self.diskseq = _read_int(
            os.path.join(SYS_CLASS_BLOCK, self.disk, "diskseq"))
        self.logical_sector = _read_int(os.path.join(
            SYS_CLASS_BLOCK, self.disk, "queue", "logical_block_size")) or 512

    @property
    def disk_path(self):
        return os.path.join(DEV_ROOT, self.disk)

    def partitions(self):
        """Names of this disk's partitions, in partition-number order."""
        found = []
        for name in os.listdir(SYS_CLASS_BLOCK):
            entry = os.path.join(SYS_CLASS_BLOCK, name)
            if not os.path.exists(os.path.join(entry, "partition")):
                continue
            if os.path.dirname(os.path.realpath(entry)) == self.sysfs:
                found.append((_read_int(os.path.join(entry, "partition")) or 0,
                              name))
        return [name for _number, name in sorted(found)]

    def family(self):
        """Every block device that is, or is built on, this one: the device,
        a disk's partitions, and anything stacked on any of them (an opened
        LUKS container, an LVM volume, a RAID array)."""
        names = {self.name}
        if not self.is_partition:
            names.update(self.partitions())
        pending = list(names)
        while pending:
            holders = os.path.join(SYS_CLASS_BLOCK, pending.pop(), "holders")
            try:
                found = os.listdir(holders)
            except OSError:
                continue
            for holder in found:
                if holder not in names:
                    names.add(holder)
                    pending.append(holder)
        return names

    def stacked(self):
        """The members of family() that are other storage layers on top."""
        own = {self.name}
        if not self.is_partition:
            own.update(self.partitions())
        return self.family() - own


def _source_name(source):
    """The kernel name of a mount source: /dev/mapper/x -> dm-0."""
    if not source.startswith("/"):
        return None
    try:
        return os.path.basename(os.path.realpath(source))
    except OSError:
        return os.path.basename(source)


def _btrfs_members():
    """{device name: every device of the Btrfs filesystem it belongs to}.

    A Btrfs filesystem over several devices is mounted under the name of one
    of them; the others are in use just the same.
    """
    members = {}
    try:
        filesystems = os.listdir(SYS_BTRFS)
    except OSError:
        return members
    for entry in filesystems:
        try:
            names = set(os.listdir(os.path.join(SYS_BTRFS, entry, "devices")))
        except OSError:
            continue
        for name in names:
            members[name] = names
    return members


def mount_entries():
    """Everything mounted from a block device, one dict per device and mount
    point: name, mountpoint, fstype and the set of its mount options."""
    found = []
    try:
        with open(MOUNTINFO) as handle:
            lines = handle.read().splitlines()
    except OSError:
        return found
    btrfs = None
    for line in lines:
        fields = line.split(" ")
        try:
            dash = fields.index("-")
            mountpoint = _unescape(fields[4])
            fstype, source = fields[dash + 1], _unescape(fields[dash + 2])
            options = set(fields[5].split(","))
            if len(fields) > dash + 3:
                options |= set(fields[dash + 3].split(","))
        except (ValueError, IndexError):
            continue
        name = _source_name(source)
        if not name:
            continue
        names = {name}
        if fstype == "btrfs":
            if btrfs is None:
                btrfs = _btrfs_members()
            names |= btrfs.get(name, set())
        for each in names:
            found.append({"name": each, "mountpoint": mountpoint,
                          "fstype": fstype, "options": options})
    return found


def mount_table():
    """[(device name, mount point)] for everything mounted from a device."""
    return [(entry["name"], entry["mountpoint"]) for entry in mount_entries()]


def swap_devices():
    """Names of the block devices in use as swap."""
    found = set()
    try:
        with open(SWAPS) as handle:
            lines = handle.read().splitlines()[1:]
    except OSError:
        return found
    for line in lines:
        parts = line.split()
        if parts:
            name = _source_name(_unescape(parts[0]))
            if name:
                found.add(name)
    return found


def check_label(fstype, label):
    """The label as it will be written, or a Refusal saying what is wrong.

    Checked here as well as in the dialog: this is the last place a label
    passes before it becomes an argument to a tool run as root.
    """
    if not isinstance(label, str):
        raise Refusal("The label is not text.")
    label = label.strip()
    if any(ord(c) < 32 or ord(c) == 127 for c in label):
        raise Refusal("The label contains a control character.")
    limit, counted = FILESYSTEMS[fstype]["label"]
    if counted == "dos":
        label = label.upper()
        if any(c in FAT_FORBIDDEN for c in label):
            raise Refusal("A FAT label cannot contain any of * ? . , ; : / "
                          "\\ | + = < > [ ] \"")
        try:
            length = len(label.encode("cp850"))
        except UnicodeEncodeError:
            raise Refusal("A FAT label can only use Western European "
                          "characters.")
    elif counted == "utf16":
        length = len(label.encode("utf-16-le")) // 2
    else:
        length = len(label.encode("utf-8"))
    if length > limit:
        raise Refusal("The label is too long for this filesystem (at most "
                      "%d)." % limit)
    if FILESYSTEMS[fstype].get("no_spaces") and " " in label:
        raise Refusal("An XFS label cannot contain a space.")
    if label.startswith("-"):
        # It would be read as an option by the tool it is handed to.
        raise Refusal("The label cannot start with a dash.")
    return label


#: Cluster sizes that can be asked for: the smallest and largest per
#: filesystem, never below the drive's logical sector. The app keeps the same
#: limits (diskfs.CLUSTER_RANGE and the counts below); a test holds the two
#: together.
CLUSTER_RANGE = {
    "exfat": (512, 32 * 1024 * 1024),
    "vfat": (512, 64 * 1024),
    "ntfs": (512, 2 * 1024 * 1024),
}
#: Below this mkfs.fat makes FAT16, which chooses its own cluster size.
FAT32_FROM = 64 * MIB
#: mkfs.fat writes "FAT32" with fewer than 65525 clusters and only warns,
#: but Windows would read that volume as FAT16. A margin at both ends.
FAT32_MIN_CLUSTERS = 65525 + 256
FAT32_MAX_CLUSTERS = 0x0FFFFFF5 - 65536
#: NTFS counts clusters in 32 bits; exFAT's table (4 bytes a cluster) is
#: kept under 1 GiB.
CLUSTER_MAX_COUNT = {"exfat": 2 ** 28, "ntfs": 2 ** 32 - 1}
#: mkntfs fails on a volume of only a few clusters.
CLUSTER_MIN_COUNT = 256


def cluster_ok(fstype, size, logical_sector, cluster):
    """Whether a `size`-byte volume of `fstype` can have `cluster` clusters."""
    if fstype not in CLUSTER_RANGE or not isinstance(cluster, int) \
            or isinstance(cluster, bool) or cluster <= 0 \
            or cluster & (cluster - 1):
        return False
    low, high = CLUSTER_RANGE[fstype]
    if cluster < max(low, logical_sector) or cluster > high:
        return False
    if fstype == "vfat":
        if size < FAT32_FROM:
            return False
        count = (size - 32 * logical_sector - cluster) // (cluster + 8)
        return FAT32_MIN_CLUSTERS <= count <= FAT32_MAX_CLUSTERS
    count = size // cluster
    return CLUSTER_MIN_COUNT <= count <= CLUSTER_MAX_COUNT[fstype]


def check_cluster(fstype, size, logical_sector, cluster):
    """The cluster size to ask mkfs for (None: its own choice), or a
    Refusal. `size` is what the volume will at least be."""
    if cluster is None:
        return None
    if not cluster_ok(fstype, size, logical_sector, cluster):
        raise Refusal("A %s volume of this size cannot have clusters of "
                      "%s bytes." % (fstype, cluster))
    return cluster


def _tail(text, lines=6):
    kept = [line for line in text.strip().splitlines() if line.strip()]
    return "\n".join(kept[-lines:])


def _run_tool(argv, stdin=None, timeout=None):
    """Run one tool to completion. Returns (exit code, stdout, stderr).

    A tool given nothing to read gets /dev/null, never this process's own
    stdin: that is the pipe the client's requests arrive on, and a tool that
    stopped to ask a question would swallow the next one as its answer.
    """
    feed = {"input": stdin} if stdin is not None else \
        {"stdin": subprocess.DEVNULL}
    done = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        timeout=timeout, text=True, errors="replace", **feed, env=TOOL_ENV)
    return done.returncode, done.stdout, done.stderr


def _render(data):
    """Bytes as a terminal shows them: a backspace moves back one place and
    what follows overwrites. mke2fs redraws its counters ("Writing inode
    tables: 120/954") that way, with no newline until the phase is done."""
    if b"\b" not in data:
        return data
    shown, column = bytearray(), 0
    for byte in data:
        if byte == 8:
            column = max(0, column - 1)
            continue
        if column < len(shown):
            shown[column] = byte
        else:
            shown.append(byte)
        column += 1
    return bytes(shown)


def _stream_tool(argv, on_line, should_stop, timeout=None, cwd=None,
                 env=None, stdout=None, on_partial=None):
    """Run a tool that takes a while, handing over its output as it comes.

    Returns (exit status, whether it was stopped). Output is split at
    newlines and at carriage returns, which is how tools redraw a progress
    line. `should_stop` is asked a few times a second; when it says yes the
    tool is told to end and, if it will not, ended.

    `on_partial`, when given, is handed a line the tool has not ended yet,
    each time it changes and the tool redraws it or pauses after it: a
    line redrawn with backspaces only ends when the phase it counts is
    over.
    """
    # `stdout`, when given, is a file the tool's output goes straight into;
    # what is followed is then what it says on its error stream.
    proc = subprocess.Popen(
        argv, stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE if stdout is None else stdout,
        stderr=subprocess.STDOUT if stdout is None else subprocess.PIPE,
        env=env or TOOL_ENV, cwd=cwd, start_new_session=True)
    pipe = proc.stdout if stdout is None else proc.stderr
    fd = pipe.fileno()
    deadline = None if timeout is None else time.monotonic() + timeout
    pending = b""
    partial = ""
    stopped = False

    def emit(data):
        for piece in re.split(b"[\r\n]+", data):
            piece = _render(piece)
            if piece.strip():
                on_line(piece.decode("utf-8", "replace").rstrip())

    try:
        while True:
            ready, _, _ = select.select([fd], [], [], 0.25)
            if ready:
                data = os.read(fd, 65536)
                if not data:
                    break
                pending += data
                cut = max(pending.rfind(b"\n"), pending.rfind(b"\r"))
                if cut >= 0:
                    emit(pending[:cut])
                    pending = pending[cut + 1:]
                    partial = ""
            # An unfinished line is passed on when the tool redraws it, or
            # when the tool has gone quiet after it: "Writing superblocks
            # and filesystem accounting information:" is what mke2fs shows
            # all through its final, longest wait.
            if on_partial is not None and pending \
                    and (b"\b" in pending or not ready):
                text = _render(pending).decode("utf-8", "replace").strip()
                if text and text != partial:
                    partial = text
                    on_partial(text)
            expired = deadline is not None and time.monotonic() > deadline
            if should_stop() or expired:
                stopped = True
                proc.terminate()
                try:
                    proc.wait(15)
                except subprocess.TimeoutExpired:
                    proc.kill()
                if expired:
                    raise subprocess.TimeoutExpired(argv, timeout)
                break
        emit(pending)
    finally:
        pipe.close()
        code = proc.wait()
    return code, stopped


def drive_pattern(name, sys_class_block=None):
    """(regex, [names]) that pick a drive's lines out of the kernel's
    messages. The application has the same in diskactivity.drive_pattern,
    for the messages it reads itself while an operation runs; a test holds
    the two together.

    The drive under its own name, and under the names of the links it hangs
    off: ata3, 2:0:0:0, usb 1-4, nvme0.
    """
    words = {name}
    entry = os.path.join(sys_class_block or SYS_CLASS_BLOCK, name)
    try:
        real = os.path.realpath(entry)
    except OSError:
        real = ""
    for part in real.split("/"):
        if re.match(r"^(ata\d+|nvme\d+|host\d+|\d+:\d+:\d+:\d+|"
                    r"\d+-\d+(\.\d+)*)$", part):
            words.add(part)
    # Its partitions too (sda1, nvme0n1p2), but not a longer name that
    # merely starts the same way (sdab, ata30).
    words.discard(name)
    links = "|".join(re.escape(w) for w in sorted(words)) or "(?!)"
    pattern = re.compile(
        r"(?<![A-Za-z0-9])(?:%s(?:p?\d+)?(?![A-Za-z0-9])|"
        r"(?:%s)(?![A-Za-z0-9]))" % (re.escape(name), links))
    words.add(name)
    return pattern, sorted(words)


def find_tool(*names):
    """Absolute path of the first of `names` that is installed, or None."""
    for name in names:
        for directory in TOOL_DIRS:
            path = os.path.join(directory, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                return path
    return None


def invoking_user():
    """(uid, gid) of the user who authorised this, or None.

    pkexec leaves it in PKEXEC_UID. Used for one thing: making a new Linux
    filesystem writable by the person who asked for it.
    """
    for variable in ("PKEXEC_UID", "SUDO_UID"):
        text = os.environ.get(variable, "")
        if text.isdigit() and int(text) > 0:
            try:
                return int(text), pwd.getpwuid(int(text)).pw_gid
            except KeyError:
                return None
    return None


# ---- the helper ----------------------------------------------------------------

# ---- arrays whose own settings are lost -------------------------------------------
#
# How the drives of a RAID 0 or RAID 5 were put together, worked out from what
# is on them: everything here only reads.

#: How many drives, at most: beyond six the ways of ordering them are too many
#: to try one by one.
RAID_MOST = 6
#: The sizes data is cut into, every one that RAID tools use.
RAID_CHUNKS = tuple(4096 << n for n in range(10))           # 4 KiB .. 2 MiB
#: md's names for where RAID 5 keeps parity (device-mapper takes the same).
RAID5_LAYOUTS = ("raid5_ls", "raid5_la", "raid5_rs", "raid5_ra")
#: How far into each drive the start of the array is looked for: md keeps
#: its own record in front of the data, up to 128 MiB of it.
RAID_START_SEARCH = 256 * MIB
RAID_STARTS = 6
RAID_MOST_TRIES = 20000
#: How much of a filesystem's dense structures is read for each try.
RAID_DENSE = 4 * MIB
#: What one check far from the start counts for, against one of the many
#: small ones close together.
RAID_FAR = 8
#: The share of checks the best guess must pass, how close another may come
#: before the two cannot be told apart, and how many checks there must be.
RAID_GOOD = 0.98
#: How many more failed checks than the best a guess may have and still be
#: as likely: two far checks' worth.
RAID_TIE = 2 * 8
#: And how many fewer files' ends may read as left empty.
RAID_SLACK_TIE = 3
RAID_FEWEST = 32
RAID_SHOWN = 6


def _u16(data, at):
    return int.from_bytes(data[at:at + 2], "little")


def _u32(data, at):
    return int.from_bytes(data[at:at + 4], "little")


def _u64(data, at):
    return int.from_bytes(data[at:at + 8], "little")


def boot_cluster(fstype, boot):
    """The cluster size an exFAT, FAT or NTFS boot sector declares, or 0."""
    if fstype == "ntfs":
        # Up to 0x80 a count of sectors (0x80: 128, 64 KiB on 512-byte
        # sectors); above it a negative power of two, 0xF4 = 2^12.
        per = boot[0x0D]
        return _u16(boot, 0x0B) * (per if per <= 0x80 else 1 << (256 - per))
    if fstype == "exfat":
        return 1 << (boot[108] + boot[109])
    if fstype == "vfat":
        return _u16(boot, 11) * boot[13]
    return 0


def _start_kind(block, place):
    """"table", "fs" or None: whether the 4 KiB at `place` begin the way an
    array's first sector does."""
    sector = block[place:place + 512]
    if len(sector) < 512:
        return None
    if block[place + 512:place + 520] == b"EFI PART":
        return "table"
    boot = sector[510:512] == b"\x55\xaa"
    if boot and sector[3:11] in (b"NTFS    ", b"EXFAT   "):
        return "fs"
    if boot and sector[82:90] == b"FAT32   ":
        return "fs"
    if boot and sector[54:59] == b"FAT16":
        return "fs"
    if boot:
        entries = [sector[446 + 16 * n:462 + 16 * n] for n in range(4)]
        used = [e for e in entries if e[4]]
        if used and all(e[0] in (0, 0x80) and _u32(e, 8) and _u32(e, 12)
                        for e in used):
            return "table"
    if block[place + 1080:place + 1082] == b"\x53\xef":
        return "fs"
    if sector[:4] == b"XFSB":
        return "fs"
    if block[place + 65600:place + 65608] == b"_BHRfS_M":
        return "fs"
    return None


def _parity_holds(fds, size):
    """Whether the drives XOR to zero, as those of a whole RAID 5 do at
    every place: True, False, or None when too few places hold anything to
    tell. Places where all of them are empty prove nothing."""
    if None in fds:
        return None
    tested = held = 0
    near = min(size, 256 * MIB)
    span = min(size, 64 * 1024 * MIB)
    places = sorted({(near * n // 512) // 4096 * 4096 for n in range(512)}
                    | {(span * n // 130) // 4096 * 4096
                       for n in range(1, 129)})
    for place in places:
        blocks = []
        for fd in fds:
            try:
                blocks.append(os.pread(fd, 4096, place))
            except OSError:
                blocks = []
                break
        if len(blocks) != len(fds) or any(len(b) < 4096 for b in blocks):
            continue
        if not any(any(b) for b in blocks):
            continue
        tested += 1
        total = 0
        for block in blocks:
            total ^= int.from_bytes(block, "little")
        held += total == 0
    if tested < 8:
        return None
    return held >= tested * 0.9


def _first_disk(layout):
    """Which place in the order holds the array's first piece."""
    return 1 if layout in ("raid5_rs", "raid5_ra") else 0


def _orders(n, layout, starts, offset):
    """The orders worth trying: every one, except that where the start of
    the array was seen on a drive at this offset, that drive must hold the
    first piece - or, on a RAID 5, the first row's parity, which is a copy
    of the first piece wherever the rest of that row is empty."""
    import itertools
    holders = {index for index, place in starts if place == offset}
    places = {_first_disk(layout)}
    if layout in ("raid5_ls", "raid5_la"):
        places.add(n - 1)
    elif layout != "raid0":
        places.add(0)
    for order in itertools.permutations(range(n)):
        if holders and not any(order[p] in holders for p in places):
            continue
        yield order


class _Striped:
    """An array as one device, read from its drives the way `layout` says,
    with a missing drive's part worked out from the others' parity."""

    def __init__(self, fds, layout, chunk, offset, size):
        self.fds = fds
        self.layout = layout
        self.chunk = chunk
        self.offset = offset
        self.n = len(fds)
        self.data = self.n - (0 if layout == "raid0" else 1)
        self.rows = max(0, (size - offset) // chunk)
        self.size = self.data * self.rows * chunk

    def place(self, piece):
        """(drive, row) of the array's piece number `piece`."""
        if self.layout == "raid0":
            return piece % self.n, piece // self.n
        row, k = divmod(piece, self.data)
        if self.layout in ("raid5_ls", "raid5_la"):
            parity = self.n - 1 - row % self.n
        else:
            parity = row % self.n
        if self.layout in ("raid5_ls", "raid5_rs"):
            return (parity + 1 + k) % self.n, row
        return (k if k < parity else k + 1), row

    def _member(self, disk, where, length):
        fd = self.fds[disk]
        if fd is not None:
            data = os.pread(fd, length, where)
            return data + b"\0" * (length - len(data))
        total = 0
        for other, fd in enumerate(self.fds):
            if other != disk:
                total ^= int.from_bytes(self._member(other, where, length),
                                        "little")
        return total.to_bytes(length, "little")

    def read(self, where, length):
        if where < 0 or where >= self.size:
            return b""
        length = min(length, self.size - where)
        out = []
        while length > 0:
            piece, within = divmod(where, self.chunk)
            take = min(self.chunk - within, length)
            disk, row = self.place(piece)
            out.append(self._member(disk, self.offset + row * self.chunk
                                    + within, take))
            where += take
            length -= take
        return b"".join(out)


def _judge(array):
    """(checks passed, checks made, filesystem, tiebreak) of an array read
    one way; (0, 0, "", 0) when no filesystem this knows is found at its
    start. `tiebreak` only decides between ways that pass the same checks:
    see _judge_exfat."""
    try:
        head = array.read(0, 4096)
        start = 0
        if head[512:520] == b"EFI PART":
            entries = _u64(head, 512 + 72) * 512
            first = array.read(entries, 128)
            start = _u64(first, 32) * 512
        elif _start_kind(head + b"\0" * 70000, 0) == "table":
            used = [head[446 + 16 * n:462 + 16 * n] for n in range(4)]
            used = [e for e in used if e[4]]
            start = _u32(used[0], 8) * 512 if used else 0
        boot = array.read(start, 4096)
        if len(boot) < 512:
            return 0, 0, "", 0
        if boot[3:11] == b"NTFS    ":
            return _judge_ntfs(array, start, boot) + ("NTFS", 0)
        if boot[3:11] == b"EXFAT   ":
            good, total, slack = _judge_exfat(array, start, boot)
            return good, total, "exFAT", slack
        if boot[82:90] == b"FAT32   ":
            return _judge_fat32(array, start, boot) + ("FAT32", 0)
        if boot[1080:1082] == b"\x53\xef":
            return _judge_ext(array, start, boot[1024:2048]) + ("ext4", 0)
    except (OSError, ValueError, IndexError, ZeroDivisionError):
        pass
    return 0, 0, "", 0


def _judge_ntfs(array, start, boot):
    sector = _u16(boot, 0x0B)
    cluster = boot_cluster("ntfs", boot)
    size = boot[0x40]
    record = (1 << (256 - size)) if size >= 0x80 else size * cluster
    if record not in (1024, 4096) or not cluster:
        return 0, 0
    table = start + _u64(boot, 0x30) * cluster
    good = total = 0
    records = []
    empty = 0
    for at in range(0, RAID_DENSE, MIB):
        block = array.read(table + at, MIB)
        for place in range(0, len(block) - record + 1, record):
            data = block[place:place + record]
            records.append(data)
            if data[:4] != b"FILE":
                empty += 1
                continue
            empty = 0
            if _u16(data, 4) >= 0x30:
                total += 1
                good += _u32(data, 44) == len(records) - 1
        if empty > 256 or len(block) < MIB:
            break
    # The mirror of the first records, in the middle of the volume, and the
    # copy of the boot sector at its very end: far from the start.
    mirror = array.read(start + _u64(boot, 0x38) * cluster, 4 * record)
    for n in range(min(4, len(records))):
        total += RAID_FAR
        good += RAID_FAR * (mirror[n * record:(n + 1) * record]
                            == records[n])
    copy = array.read(start + _u64(boot, 0x28) * sector, 512)
    total += RAID_FAR
    good += RAID_FAR * (copy == boot[:512])
    return good, total


def _judge_fat32(array, start, boot):
    sector = _u16(boot, 11)
    cluster = boot_cluster("vfat", boot)
    fat = start + _u16(boot, 14) * sector
    length = _u32(boot, 36) * sector
    heap = fat + boot[16] * length
    if not cluster or not length:
        return 0, 0
    good = total = 0
    table = array.read(fat, min(length, RAID_DENSE))
    for index in range(2, len(table) // 4):
        value = _u32(table, index * 4) & 0x0FFFFFFF
        if value:
            total += 1
            good += value == index + 1 or value >= 0x0FFFFFF8
    # The second copy of the table, one table's length further on.
    if boot[16] >= 2:
        for at in range(0, min(length, RAID_DENSE), max(65536, length // 8)):
            total += RAID_FAR
            good += RAID_FAR * (array.read(fat + at, 4096)
                                == array.read(fat + length + at, 4096))

    def folder(number):
        return array.read(heap + (number - 2) * cluster, min(cluster, MIB))

    todo = [_u32(boot, 44)]
    seen = set()
    while todo and len(seen) < 64:
        number = todo.pop(0)
        if number in seen or number < 2:
            continue
        seen.add(number)
        data = folder(number)
        for place in range(0, len(data) - 31, 32):
            entry = data[place:place + 32]
            if entry[0] == 0:
                break
            if entry[0] == 0xE5 or entry[11] == 0x0F \
                    or not entry[11] & 0x10 or entry[0] == 0x2E:
                continue
            child = (_u16(entry, 20) << 16) | _u16(entry, 26)
            if child < 2:
                continue
            total += RAID_FAR
            inside = folder(child)
            good += RAID_FAR * (inside[0:11] == b".          " and (
                (_u16(inside, 20) << 16) | _u16(inside, 26)) == child)
            todo.append(child)
    return good, total


def _exfat_sets(data, files=None):
    """How many file entry sets in a folder pass their checksum, and
    (first cluster, length, in one piece) of the folders among them.
    `files`, if given, gets the same of every entry."""
    sets, folders = 0, []
    place = 0
    while place + 32 <= len(data):
        if data[place] == 0:
            break
        if data[place] != 0x85:
            place += 32
            continue
        count = data[place + 1]
        block = data[place:place + (count + 1) * 32]
        if not 2 <= count <= 18 or len(block) < (count + 1) * 32:
            place += 32
            continue
        total = 0
        for index, byte in enumerate(block):
            if index not in (2, 3):
                total = (((total & 1) << 15) + (total >> 1) + byte) & 0xFFFF
        if total == _u16(block, 2) and block[32] == 0xC0:
            sets += 1
            if _u16(block, 4) & 0x10:
                folders.append((_u32(block, 52), _u64(block, 56),
                                bool(block[33] & 2)))
            if files is not None:
                files.append((_u32(block, 52), _u64(block, 56),
                              bool(block[33] & 2)))
        place += (count + 1) * 32
    return sets, folders


def _judge_exfat(array, start, boot):
    sector = 1 << boot[108]
    cluster = boot_cluster("exfat", boot)
    heap = start + _u32(boot, 88) * sector
    table = array.read(start + _u32(boot, 80) * sector,
                       min(_u32(boot, 84) * sector, RAID_DENSE))
    good = total = 0
    # The backup of the boot region follows it.
    region = 12 * sector
    total += RAID_FAR
    good += RAID_FAR * (array.read(start, region)
                        == array.read(start + region, region))

    def clusters(first, length, whole):
        """The clusters of a file: a run where it is kept in one piece,
        else its chain in the allocation table."""
        if whole:
            return list(range(first, first + min(
                max(1, -(-length // cluster)), 2048)))
        found = []
        number = first
        while 2 <= number < 0xFFFFFFF7 and len(found) < 2048 \
                and number * 4 + 4 <= len(table) and number not in found:
            found.append(number)
            number = _u32(table, number * 4)
        return found

    def read(first, length, whole):
        parts = []
        for number in clusters(first, length, whole):
            parts.append(array.read(heap + (number - 2) * cluster, cluster))
            if len(parts) * cluster >= MIB:
                break
        return b"".join(parts)

    root = _u32(boot, 96)
    top = read(root, 0, False)
    bitmap = upcase = None
    for place in range(0, len(top) - 31, 32):
        if top[place] == 0x81 and bitmap is None:
            bitmap = (_u32(top, place + 20), _u64(top, place + 24))
        elif top[place] == 0x82:
            upcase = (_u32(top, place + 4), _u32(top, place + 20),
                      _u64(top, place + 24))
    # The case table, checked against the checksum the top folder keeps.
    if upcase is not None and upcase[2] <= MIB:
        data = read(upcase[1], upcase[2], True)[:upcase[2]]
        value = 0
        for byte in data:
            value = (((value << 31) | (value >> 1)) + byte) & 0xFFFFFFFF
        total += RAID_FAR
        good += RAID_FAR * (value == upcase[0])
    files = []
    todo = [(root, 0, False)]
    seen = set()
    while todo and len(seen) < 64:
        number, length, whole = todo.pop(0)
        if number in seen or number < 2:
            continue
        seen.add(number)
        data = top if number == root else read(number, length, whole)
        sets, folders = _exfat_sets(data, files)
        total += RAID_FAR
        good += RAID_FAR * (sets > 0 or number == root)
        todo += folders
    # Every file's clusters marked as used in the allocation bitmap: the
    # bitmap is one long run, and read the wrong way it marks the wrong
    # clusters.
    if bitmap is not None and files:
        bits = read(bitmap[0], min(bitmap[1], RAID_DENSE), True)
        for first, length, whole in files[:4096]:
            if not length:
                continue
            total += 1
            good += all(
                0 <= number - 2 < len(bits) * 8
                and bits[(number - 2) // 8] >> ((number - 2) % 8) & 1
                for number in clusters(first, length, whole)[:64])
    # The tiebreak. On a mostly empty RAID 5 the parity of a row with one
    # piece of data in it is a copy of that piece, so a wrong layout that
    # reads the parity instead reads the same - the checks above, all in
    # such rows, cannot tell the two apart. The rows full of file data can:
    # the end of a file's last cluster, past the file, is left as zeros by
    # the filesystem, and read the wrong way it is other data.
    slack = 0
    for first, length, whole in files[:512]:
        rest = length % cluster
        if not whole or not rest:
            continue
        last = first + length // cluster
        tail = array.read(heap + (last - 2) * cluster + rest, cluster - rest)
        slack += len(tail) == cluster - rest and not any(tail)
    return good, total, slack


def _judge_ext(array, start, block):
    size = 1024 << _u32(block, 24)
    per_group = _u32(block, 32)
    incompat = _u32(block, 0x60)
    blocks = _u32(block, 4) | (_u32(block, 0x150) << 32
                               if incompat & 0x80 else 0)
    first = _u32(block, 20)
    desc = (_u16(block, 0xFE) or 32) if incompat & 0x80 else 32
    if not per_group or size > 65536:
        return 0, 0
    groups = -(-(blocks - first) // per_group)
    table = array.read(start + (first + 1) * size,
                       min(groups * desc, RAID_DENSE))
    bitmaps = [_u32(table, g * desc) | ((_u32(table, g * desc + 0x20) << 32)
                                         if desc >= 64 else 0)
               for g in range(len(table) // desc)]
    steps = [b - a for a, b in zip(bitmaps, bitmaps[1:])]
    good = total = 0
    if steps:
        usual = max(set(steps), key=steps.count)
        total += len(steps)
        good += steps.count(usual)
    sparse = _u32(block, 0x64) & 1
    wanted = sorted({p ** k for p in (3, 5, 7) for k in range(12)} | {1}) \
        if sparse else range(1, groups)
    for group in [g for g in wanted if g < groups][:32]:
        copy = array.read(start + (group * per_group + first) * size, 1024)
        total += RAID_FAR
        good += RAID_FAR * (copy[56:58] == b"\x53\xef"
                            and _u16(copy, 0x5A) == group)
    return good, total


class Helper:
    def __init__(self, out=None, runner=None, tools=None, streamer=None):
        self.out = out if out is not None else sys.stdout
        self.run_tool = runner or _run_tool
        self.stream_tool = streamer or _stream_tool
        self.find_tool = tools or find_tool
        self.out_lock = threading.Lock()
        self.cancel = threading.Event()
        # The request whose tool output is passed on, and that output held
        # back while lines come faster than the client needs them.
        self.in_hand = None
        self.held_output = None
        # Never sent: the first line always goes out, however recently the
        # machine started (the monotonic clock counts from boot).
        self.output_sent = float("-inf")
        self.finished = False
        self.job = None
        self.cancellable = False
        # Set once an operation has started overwriting what was there, so a
        # stop can say truthfully whether anything was lost.
        self.destroying = False
        self.temp_mounts = []
        self.fill_dirs = []

    # ---- talking ----------------------------------------------------------

    def send(self, message):
        """One JSON line to the client. A client that has gone away is not an
        error: the work in hand is finished regardless."""
        text = json.dumps(message, ensure_ascii=True)
        with self.out_lock:
            try:
                self.out.write(text + "\n")
                self.out.flush()
            except (OSError, ValueError):
                pass

    def note(self, request, text):
        """A line about how the work is going, where there is no amount to
        measure it by."""
        self.send({"id": request.get("id"), "event": "note", "text": text})

    def step(self, request, index, total, key, text, cancellable=False):
        self.flush_output()
        self.in_hand = request
        self.cancellable = cancellable
        self.send({"id": request.get("id"), "event": "step", "index": index,
                   "total": total, "key": key, "text": text,
                   "cancellable": cancellable})

    def progress(self, request, done, total, unit=None):
        """How far the step is: in bytes, or in `unit` ("items") for a tool
        that counts something else."""
        event = {"id": request.get("id"), "event": "progress",
                 "done": done, "total": total}
        if unit:
            event["unit"] = unit
        self.send(event)

    #: At most this many tool lines a second go to the client: enough to
    #: follow, and a tool that floods its output does not flood the pipe.
    OUTPUT_INTERVAL = 0.2

    def output(self, text):
        """A line a tool printed, for the client's details view. Lines that
        come too fast are held back; the newest is sent when time allows
        (flush_output), so the last thing said before a long silence is
        never the one that goes missing."""
        if self.in_hand is None:
            return
        self.held_output = text
        if time.monotonic() - self.output_sent >= self.OUTPUT_INTERVAL:
            self.flush_output()

    def flush_output(self):
        text, self.held_output = self.held_output, None
        if text is None or self.in_hand is None:
            return
        self.output_sent = time.monotonic()
        self.send({"id": self.in_hand.get("id"), "event": "output",
                   "text": text[:500]})

    def check_cancel(self):
        if self.cancel.is_set() and self.cancellable:
            raise Cancelled()

    # ---- tools ------------------------------------------------------------

    def need(self, *names):
        path = self.find_tool(*names)
        if path is None:
            raise Refusal("The '%s' command is not installed." % names[0])
        return path

    def tool(self, argv, what, stdin=None, timeout=3600):
        """Run a tool and refuse on failure, quoting what it said."""
        try:
            code, out, err = self.run_tool(argv, stdin, timeout)
        except subprocess.TimeoutExpired:
            raise Refusal("%s did not finish in time." % what)
        except OSError as exc:
            raise Refusal("%s could not be started: %s" % (what, exc))
        if code != 0:
            detail = _tail(err) or _tail(out) or "exit status %d" % code
            raise Refusal("%s failed:\n%s" % (what, detail))
        return out

    #: "Writing inode tables: 120/954": a count at the end of a line.
    COUNTER = re.compile(r"(\d+)/(\d+)\s*$")

    def stream(self, argv, what, on_line=None, ok=(0,), keep=60,
               timeout=None, stopped_text="", counts=False, **options):
        """Run a long tool, following its output. Returns (status, lines).

        `ok`: the exit statuses that are not a failure, or None to leave the
        judging to the caller. Only the last `keep` lines are kept. A stop
        asked for during a cancellable step ends the tool and raises
        Cancelled with `stopped_text`. Every line is passed on to the client
        as it comes; with `counts`, an "N/M" the tool redraws at the end of
        a line is passed on as the step's progress as well.
        """
        lines = []

        def collect(line):
            lines.append(line)
            del lines[:-keep]
            self.output(line)
            if on_line is not None:
                on_line(line)

        def partial(text):
            self.output(text)
            match = self.COUNTER.search(text) if counts else None
            if match and self.in_hand is not None \
                    and 0 < int(match.group(2)):
                self.progress(self.in_hand, int(match.group(1)),
                              int(match.group(2)), unit="items")

        def should_stop():
            # Asked a few times a second whatever the tool does: the
            # moment to send a line that was held back.
            if self.held_output is not None and time.monotonic() \
                    - self.output_sent >= self.OUTPUT_INTERVAL:
                self.flush_output()
            return self.cancel.is_set() and self.cancellable

        try:
            code, stopped = self.stream_tool(
                argv, collect, should_stop, timeout, on_partial=partial,
                **options)
        except subprocess.TimeoutExpired:
            raise Refusal("%s did not finish in time." % what)
        except OSError as exc:
            raise Refusal("%s could not be started: %s" % (what, exc))
        finally:
            self.flush_output()
        if stopped:
            raise Cancelled(stopped_text)
        if ok is not None and code not in ok:
            raise Refusal("%s failed:\n%s" % (
                what, "\n".join(lines[-6:]) or "exit status %d" % code))
        return code, lines

    def settle(self):
        """Wait until udev has caught up with what was just written."""
        udevadm = self.find_tool("udevadm")
        if udevadm:
            try:
                self.run_tool([udevadm, "settle", "--timeout=20"], None, 30)
            except (OSError, subprocess.SubprocessError):
                pass

    #: What probe() asks about a device.
    PROBE_TAGS = ("TYPE", "LABEL", "UUID", "PTTYPE")

    def probe(self, device):
        """What is on a device right now, read from the device itself.

        blkid's low-level probe, not its cache: this is how a result is
        verified, so it must not be an answer remembered from before.

        One tag per call, with the "value" output. The formats that print
        every tag at once escape what they print - a space in a label comes
        back with a backslash in front of it - and a comparison against an
        escaped label says that a correctly written one is wrong.
        """
        blkid = self.need("blkid")
        found = {}
        for tag in self.PROBE_TAGS:
            try:
                code, out, _err = self.run_tool(
                    [blkid, "--probe", "--output", "value", "--match-tag",
                     tag, device.path], None, 60)
            except (OSError, subprocess.SubprocessError) as exc:
                raise Refusal("Could not examine %s: %s" % (device.path, exc))
            if code == 8:
                raise Refusal(
                    "%s carries the signatures of more than one filesystem, "
                    "so what is on it cannot be told." % device.path)
            # Exit 2 is "no such tag here", which is an answer, not a
            # failure: a blank device has no type, a filesystem no label.
            if code not in (0, 2):
                raise Refusal("Could not examine %s." % device.path)
            value = out.rstrip("\n")
            if code == 0 and value:
                found[tag] = value
        return found

    # ---- guards -----------------------------------------------------------

    def target(self, request, system=False, writable=True, key="device",
               identity="identity"):
        """The device a request names, after every check that it is the one
        meant and that it may be written to.

        `system`: the operation is one that is safe on a volume the running
        system uses, so that is not a reason to refuse. `writable`: the
        device itself is going to be written. `key`/`identity`: where in the
        request the device and what the user saw of it are, for operations
        that name more than one.
        """
        path = request.get(key)
        if not isinstance(path, str) or not path.startswith(DEV_ROOT + "/"):
            raise Refusal("That is not a device.")
        device = Device(path[len(DEV_ROOT) + 1:])
        if not self.is_block_device(device):
            raise Refusal("%s is not a block device." % device.path)

        self.check_identity(device, request.get(identity))
        if device.size is None or device.size <= 0:
            raise Refusal("There is no media in %s." % device.path)
        if writable and device.read_only:
            raise Refusal("%s is read-only (a write-protect switch, or the "
                          "drive has locked itself)." % device.path)
        if not system:
            self.refuse_system(device)
        return device

    def is_system(self, device):
        return (any(is_system_mount(m) for m in self.mounts_of(device))
                or bool(device.family() & swap_devices())
                or device.disk in self.stick_disks())

    @staticmethod
    def stick_disks():
        """On the recovery stick: the drive it started from, found by the
        FAT ID the boot loader passed on - protected even when it could
        not be mounted. Empty anywhere else."""
        if not os.path.exists(RESCUE_MARKER):
            return set()
        try:
            with open(CMDLINE) as handle:
                words = handle.read().split()
        except OSError:
            return set()
        for word in words:
            if word.startswith("kss.stick="):
                uuid = word.split("=", 1)[1]
                if not FAT_ID_RE.match(uuid):
                    return set()
                path = os.path.realpath(os.path.join(
                    DEV_ROOT, "disk", "by-uuid", uuid))
                name = os.path.basename(path)
                try:
                    return {Device(name).disk}
                except Refusal:
                    return set()
        return set()

    def mounted_at(self, device, writable=False):
        """Where the device's filesystem is mounted: the mount entry with the
        shortest path. Refuses when it is not mounted, or not writable."""
        family = device.family()
        entries = [e for e in mount_entries() if e["name"] in family]
        if not entries:
            raise Refusal(
                "%s is not mounted. Mount it first: this works through the "
                "mounted filesystem." % device.path)
        if writable:
            entries = [e for e in entries if "rw" in e["options"]]
            if not entries:
                raise Refusal("%s is mounted read-only." % device.path)
        return sorted(entries, key=lambda e: (len(e["mountpoint"]),
                                              e["mountpoint"]))[0]

    def filesystem_of(self, device):
        fstype = self.probe(device).get("TYPE", "")
        if not fstype:
            raise Refusal("There is no filesystem on %s." % device.path)
        return fstype

    def ntfs_problem(self, device):
        """What stands in the way of changing a Windows volume, as text for
        the user with what to do about it, or None.

        Asked of ntfs-3g's own probe, which is the code that decides whether
        the volume may be mounted read-write. Without that tool the answer
        is not known and None is returned: the tools that would do the
        changing make the same check themselves.
        """
        probe = self.find_tool("ntfs-3g.probe")
        if probe is None:
            return None
        try:
            code, _out, _err = self.run_tool(
                [probe, "--readwrite", device.path], None, 120)
        except (OSError, subprocess.SubprocessError):
            return None
        return NTFS_STATES.get(code)

    def refuse_unsafe_windows(self, device, fstype):
        if fstype == "ntfs":
            problem = self.ntfs_problem(device)
            if problem:
                raise Refusal(problem)

    @staticmethod
    def is_block_device(device):
        return _is_block_device(device.path, device.sysfs)

    @staticmethod
    def check_identity(device, claimed):
        """Refuse when the device is not the one the user was looking at.

        The window read these numbers when it drew the device; they are read
        again here. A stick swapped for another in between has the same name
        and a different sequence number.
        """
        if not isinstance(claimed, dict):
            raise Refusal("The request does not say which device it means.")
        actual = {"name": device.name, "size": device.size,
                  "diskseq": device.diskseq, "start": device.start}
        for key in ("name", "size", "start"):
            if claimed.get(key) != actual[key]:
                raise Refusal(
                    "%s is not the device that was selected any more "
                    "(its %s changed). Nothing was done; look at the list "
                    "again." % (device.path, key))
        if (claimed.get("diskseq") is not None
                and actual["diskseq"] is not None
                and claimed["diskseq"] != actual["diskseq"]):
            raise Refusal(
                "%s was unplugged and something else connected under the "
                "same name. Nothing was done; look at the list again."
                % device.path)

    @staticmethod
    def mounts_of(device):
        """[mount point] of everything mounted from the device's family,
        deepest first so nested mounts come off in the right order."""
        family = device.family()
        found = {mount for name, mount in mount_table() if name in family}
        return sorted(found, key=lambda m: (-m.count("/"), m))

    def refuse_system(self, device):
        system = sorted(m for m in self.mounts_of(device)
                        if is_system_mount(m))
        if system:
            raise Refusal(
                "%s holds the running system (%s). It cannot be changed "
                "while the system runs from it."
                % (device.path, ", ".join(system)))
        if device.family() & swap_devices():
            raise Refusal("%s is in use as swap space by the running system."
                          % device.path)
        if device.disk in self.stick_disks():
            raise Refusal(
                "%s is the recovery stick the running system started from. "
                "It cannot be changed while the system runs from it."
                % device.path)

    def refuse_stacked(self, device):
        stacked = sorted(device.stacked())
        if stacked:
            raise Refusal(
                "%s is in use by another storage layer (%s): an unlocked "
                "encrypted volume, LVM or RAID. Close it first."
                % (device.path, ", ".join(stacked)))

    def unmount(self, device):
        """Unmount everything mounted from the device. Refuses if busy."""
        mounts = self.mounts_of(device)
        if not mounts:
            return
        umount = self.need("umount")
        for mountpoint in mounts:
            if is_system_mount(mountpoint):
                raise Refusal("%s is a system mount point." % mountpoint)
            self.tool([umount, "--", mountpoint],
                      "Unmounting %s" % mountpoint, timeout=120)
        left = self.mounts_of(device)
        if left:
            raise Refusal("%s is still mounted at %s."
                          % (device.path, ", ".join(left)))

    def assert_free(self, device):
        """Ask the kernel itself whether anything still has the device open.

        Opening a block device exclusively fails while it is mounted, part of
        an array, or held open exclusively by another program - cases the
        mount table alone would miss.
        """
        try:
            fd = os.open(device.path, os.O_RDWR | os.O_EXCL)
        except OSError as exc:
            if exc.errno == errno.EBUSY:
                raise Refusal(
                    "%s is still in use by the system or another program. "
                    "Close whatever is using it and try again." % device.path)
            raise Refusal("Cannot open %s for writing: %s"
                          % (device.path, exc.strerror or exc))
        os.close(fd)

    # ---- destructive primitives --------------------------------------------

    def wipe_signatures(self, device):
        """Remove every filesystem and partition-table signature.

        Without --force, which is wipefs's "even if it is in use": left out,
        the tool opens the device exclusively and so makes the same check
        this process just made, one more time, at the moment it writes.
        """
        wipefs = self.need("wipefs")
        self.tool([wipefs, "--all", "--quiet", device.path],
                  "Erasing the old signatures on %s" % device.path)

    def overwrite(self, request, device, pattern=b"\x00"):
        """Write `pattern` over the whole device, start to end."""
        total = device.size
        block = pattern * (CHUNK // len(pattern))
        try:
            fd = os.open(device.path, os.O_WRONLY | os.O_EXCL)
        except OSError as exc:
            raise Refusal("Cannot open %s for writing: %s"
                          % (device.path, exc.strerror or exc))
        done = synced = 0
        last = 0.0
        try:
            while done < total:
                self.check_cancel()
                want = min(CHUNK, total - done)
                view = memoryview(block)[:want]
                while view:
                    view = view[os.write(fd, view):]
                done += want
                if done - synced >= SYNC_EVERY:
                    os.fsync(fd)
                    # Dropped from the page cache as it goes: a pass over a
                    # whole drive must not push everything else out of memory.
                    os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
                    synced = done
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, done, total)
                    last = now
            os.fsync(fd)
            self.progress(request, total, total)
        except OSError as exc:
            raise Refusal(
                "Writing to %s failed %s into the device: %s. The drive may "
                "be failing." % (device.path, _megabytes(done),
                                 exc.strerror or exc))
        finally:
            os.close(fd)

    def discard(self, device):
        """Tell the drive that every block of the device is unused.

        Run after the signatures are gone and without --force, so blkdiscard
        keeps its exclusive open - its own refusal to touch a device that is
        mounted or held by something else.
        """
        blkdiscard = self.need("blkdiscard")
        self.tool([blkdiscard, device.path],
                  "Discarding every block of %s" % device.path)

    def new_table(self, device, table, type_code, bootable=False):
        """A new partition table holding one partition over the whole disk.

        The partition starts at 1 MiB, expressed in the drive's own sectors,
        which is the alignment every current tool uses and a multiple of any
        physical sector size in use. `bootable`: the MBR's "active" flag,
        which some firmware looks for before it starts a USB stick.
        """
        sfdisk = self.need("sfdisk")
        start = MIB // device.logical_sector
        script = "label: %s\nstart=%d, type=%s%s\n" % (
            table, start, type_code, ", bootable" if bootable else "")
        self.tool([sfdisk, "--quiet", "--wipe", "always",
                   "--wipe-partitions", "always", device.path],
                  "Writing the partition table", stdin=script, timeout=300)
        self.settle()
        return self.wait_for_partition(device, 1)

    def wait_for_partition(self, device, number, timeout=20.0):
        """The Device for a partition the kernel has just been told about."""
        deadline = time.monotonic() + timeout
        while True:
            for name in device.partitions():
                entry = os.path.join(SYS_CLASS_BLOCK, name)
                if _read_int(os.path.join(entry, "partition")) != number:
                    continue
                partition = Device(name)
                if self.is_block_device(partition):
                    return partition
            if time.monotonic() >= deadline:
                raise Refusal(
                    "The partition table was written, but the system did "
                    "not show the new partition. Unplug the drive and "
                    "connect it again, then format the partition.")
            time.sleep(0.2)

    def make_filesystem(self, argv):
        """Run mkfs, passing on what it prints as it goes.

        On a slow or worn drive this is the step that can take many minutes,
        and the phases the tool reports ("Writing inode tables: 120/954",
        "Creating journal") are what tells working apart from stuck.
        """
        self.stream(argv, "Creating the filesystem", counts=True,
                    timeout=3600)

    def mkfs_argv(self, fstype, device, label, uuid, owner, cluster=None):
        """The command that creates `fstype` on `device`.

        Not told to be quiet: what the tool says about its progress goes to
        the details view (see make_filesystem).

        `uuid` keeps a filesystem's identity across a reformat, where the
        tool can set one; `owner` is the (uid, gid) the new root directory
        should belong to, where the tool can set that at creation.
        `cluster` is the cluster size in bytes, already checked by
        check_cluster(), or None for the tool's own choice.
        """
        spec = FILESYSTEMS[fstype]
        mkfs = self.need(*spec["mkfs"])
        path = device.path
        if fstype == "vfat":
            argv = [mkfs]
            # Below this FAT32 cannot hold the clusters it needs; the tool
            # then picks FAT16 itself, which is what such a size calls for.
            if device.size >= FAT32_FROM:
                argv += ["-F", "32"]
                if cluster:
                    # Counted in the drive's logical sectors.
                    argv += ["-s", str(cluster // device.logical_sector)]
            if label:
                argv += ["-n", label]
            if uuid:
                argv += ["-i", uuid.replace("-", "")]
            return argv + [path]
        if fstype == "exfat":
            argv = [mkfs]
            if cluster:
                argv += ["-c", str(cluster)]
            if label:
                argv += ["-L", label]
            return argv + [path]
        if fstype == "ntfs":
            # Quick always: the slow variant zeroes the volume, and where the
            # user asked for that this helper has already done it, verifiably.
            # Never --force: that is the switch that formats a device even
            # when it appears to be mounted.
            argv = [mkfs, "--quick"]
            if cluster:
                argv += ["--cluster-size", str(cluster)]
            if label:
                argv += ["--label", label]
            return argv + [path]
        if fstype == "ext4":
            argv = [mkfs, "-F"]
            if label:
                argv += ["-L", label]
            if uuid:
                argv += ["-U", uuid]
            if owner:
                argv += ["-E", "root_owner=%d:%d" % owner]
            return argv + [path]
        if fstype == "btrfs":
            argv = [mkfs, "--force"]
            if label:
                argv += ["--label", label]
            if uuid:
                argv += ["--uuid", uuid]
            return argv + [path]
        if fstype == "xfs":
            argv = [mkfs, "-f"]
            if label:
                argv += ["-L", label]
            if uuid:
                argv += ["-m", "uuid=%s" % uuid]
            return argv + [path]
        if fstype == "f2fs":
            argv = [mkfs, "-f"]
            if label:
                argv += ["-l", label]
            if uuid:
                argv += ["-U", uuid]
            if owner:
                argv += ["-R", "%d:%d" % owner]
            return argv + [path]
        raise Refusal("Unknown filesystem.")

    def give_to_owner(self, fstype, device, owner):
        """Hand a new filesystem's root directory to the user who asked.

        Only for the filesystems whose tool cannot do it at creation: mounted
        privately for the one chown and unmounted again.
        """
        mount, umount = self.need("mount"), self.need("umount")
        point = tempfile.mkdtemp(prefix="ksyssupervisor-", dir=RUN_DIR)
        try:
            self.tool([mount, "-t", fstype, "-o", "nosuid,nodev,noexec",
                       device.path, point], "Mounting the new filesystem",
                      timeout=120)
            self.temp_mounts.append(point)
            try:
                os.chown(point, owner[0], owner[1])
            finally:
                self.tool([umount, "--", point],
                          "Unmounting the new filesystem", timeout=120)
                self.temp_mounts.remove(point)
        finally:
            try:
                os.rmdir(point)
            except OSError:
                pass

    def verify_filesystem(self, device, fstype, label):
        """Read the device back and compare it with what was asked for."""
        found = self.probe(device)
        want = FILESYSTEMS[fstype]["blkid"] if fstype in FILESYSTEMS else fstype
        if found.get("TYPE") != want:
            raise Refusal(
                "The check afterwards did not find a %s filesystem on %s "
                "(found: %s). The device is not usable as it is; format it "
                "again." % (want, device.path, found.get("TYPE") or "nothing"))
        if found.get("LABEL", "") != label:
            raise Refusal(
                "The filesystem was created, but its label reads back as "
                "'%s' instead of '%s'." % (found.get("LABEL", ""), label))
        return found

    def verify_cluster(self, device, fstype, cluster):
        """The cluster size the new boot sector declares is the one asked
        for: mkfs.fat in particular quietly adjusts what it is given."""
        if not cluster:
            return
        try:
            fd = os.open(device.path, os.O_RDONLY)
            try:
                boot = os.pread(fd, 512, 0)
            finally:
                os.close(fd)
        except OSError as exc:
            raise Refusal("Cannot read %s back: %s"
                          % (device.path, exc.strerror or exc))
        found = boot_cluster(fstype, boot) if len(boot) == 512 else 0
        if found != cluster:
            raise Refusal(
                "The filesystem was created, but with clusters of %d bytes "
                "instead of %d." % (found, cluster))

    def verify_bare_drive(self, device, table):
        """After a whole-drive format: only the new table is on the drive.

        A signature left on the bare device - the disc filesystem of an
        installer image is the usual one - is read before the partition
        table by everything that looks at the drive, which then goes on
        showing the old layout and the old, smaller size.
        """
        found = self.probe(device)
        if found.get("TYPE"):
            raise Refusal(
                "The drive was formatted, but an old %s signature is still "
                "on %s itself and hides the new layout. Format the whole "
                "drive again." % (found["TYPE"], device.path))
        if found.get("PTTYPE") != table:
            raise Refusal(
                "The new partition table on %s reads back as '%s' instead "
                "of '%s'." % (device.path, found.get("PTTYPE") or "nothing",
                              table))

    # ---- operations ---------------------------------------------------------

    def op_format(self, request):
        fstype = request.get("fstype")
        if not isinstance(fstype, str) or fstype not in FILESYSTEMS:
            raise Refusal("Unknown filesystem.")
        spec = FILESYSTEMS[fstype]
        label = check_label(fstype, request.get("label", ""))
        table = request.get("table")
        if table not in (None, "gpt", "dos"):
            raise Refusal("Unknown partition table type.")
        erase = request.get("erase", "none")
        if erase not in ("none", "zero", "discard"):
            raise Refusal("Unknown erase method.")
        uuid = request.get("uuid") or None
        if uuid is not None:
            pattern = FAT_ID_RE if fstype == "vfat" else UUID_RE
            if not isinstance(uuid, str) or not pattern.match(uuid):
                raise Refusal("The filesystem ID to keep is not valid.")
            if fstype in ("exfat", "ntfs"):
                uuid = None

        device = self.target(request)
        whole_disk = table is not None
        if whole_disk and device.is_partition:
            raise Refusal("A partition table goes on a whole drive, not on "
                          "a partition.")
        if not whole_disk and not device.is_partition:
            raise Refusal("Formatting a whole drive needs a partition table "
                          "type.")
        self.refuse_stacked(device)

        usable = device.size - (2 * MIB if whole_disk else 0)
        if usable < spec["min"]:
            raise Refusal("%s is too small for this filesystem (it needs "
                          "at least %s)."
                          % (device.path, _megabytes(spec["min"])))
        if spec["max"] is not None and usable > spec["max"]:
            raise Refusal("%s is too large for this filesystem."
                          % device.path)
        if table == "dos" and device.size > 2 ** 32 * device.logical_sector:
            raise Refusal("An MBR partition table cannot describe a drive "
                          "this large; use GPT.")

        # The volume a whole-drive format makes starts 1 MiB in and leaves
        # the backup table at the end, so it is at least `usable`.
        cluster = check_cluster(fstype, usable, device.logical_sector,
                                request.get("cluster"))

        owner = None
        if request.get("owner") and spec["native"]:
            owner = invoking_user()

        # Every tool the whole sequence needs, found before the first step:
        # a missing one must not be discovered with the old contents gone.
        self.need(*spec["mkfs"])
        self.need("blkid")
        self.need("wipefs")
        if whole_disk:
            self.need("sfdisk")
        if erase == "discard":
            self.need("blkdiscard")
        if owner and fstype in ("btrfs", "xfs"):
            self.need("mount")
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")

        names = ["unmount"] if mounted else []
        names += ["erase"]
        names += ["table"] if whole_disk else []
        names += ["mkfs", "verify"]
        total = len(names)

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, total, key, text,
                      cancellable)

        with self.locked():
            if mounted:
                begin("unmount", "Unmounting %s" % device.path, True)
                self.unmount(device)
            self.check_cancel()
            self.assert_free(device)

            # ---- from here on the old contents are being destroyed --------
            self.destroying = True
            begin("erase", {"zero": "Overwriting %s with zeros",
                            "discard": "Discarding every block of %s",
                            "none": "Erasing the old signatures on %s",
                            }[erase] % device.path, erase == "zero")
            # Signatures first, in every case. They are what makes a device
            # look like it holds something, and a GPT keeps a second copy at
            # the very end of the disk: an overwrite stopped halfway would
            # leave that copy describing partitions that are gone, and a
            # discard is not guaranteed to read back as zeros at all.
            if not device.is_partition:
                for name in device.partitions():
                    try:
                        self.wipe_signatures(Device(name))
                    except Refusal:
                        # Not fatal: whatever is left inside the old
                        # partitions is overwritten or orphaned by the new
                        # table, and that step does check its own result.
                        pass
            self.wipe_signatures(device)
            if erase == "zero":
                self.overwrite(request, device)
            elif erase == "discard":
                self.discard(device)

            volume = device
            if whole_disk:
                begin("table", "Creating a new %s partition table"
                      % ("GPT" if table == "gpt" else "MBR"))
                volume = self.new_table(
                    device, table, spec["gpt"] if table == "gpt"
                    else spec["mbr"])

            begin("mkfs", "Creating the filesystem")
            self.make_filesystem(
                self.mkfs_argv(fstype, volume, label, uuid, owner, cluster))
            if owner and fstype in ("btrfs", "xfs"):
                self.give_to_owner(fstype, volume, owner)
            warning = None
            if not whole_disk:
                warning = self.set_partition_type(volume, spec)
            self.settle()

            begin("verify", "Checking the result")
            found = self.verify_filesystem(volume, fstype, label)
            self.verify_cluster(volume, fstype, cluster)
            if whole_disk:
                self.verify_bare_drive(device, table)

        result = {"device": volume.path, "fstype": fstype,
                  "label": found.get("LABEL", ""),
                  "uuid": found.get("UUID", "")}
        if warning:
            result["warning"] = warning
        return result

    def set_partition_type(self, volume, spec):
        """Make the partition table agree with the filesystem just made.

        Windows decides whether to look inside a partition by its type, so
        an exFAT volume in a partition typed "Linux" stays invisible there.
        Not fatal when it fails: the filesystem is intact and usable here.
        """
        disk = Device(volume.disk)
        info = self.probe(disk)
        table = info.get("PTTYPE")
        if table not in ("gpt", "dos") or volume.number is None:
            return None
        sfdisk = self.find_tool("sfdisk")
        if sfdisk is None:
            return None
        try:
            code, _out, err = self.run_tool(
                [sfdisk, "--quiet", "--no-reread", "--part-type", disk.path,
                 str(volume.number),
                 spec["gpt"] if table == "gpt" else spec["mbr"]], None, 120)
        except (OSError, subprocess.SubprocessError) as exc:
            code, err = 1, str(exc)
        if code != 0:
            return ("The filesystem was created, but the partition's type "
                    "in the partition table could not be updated (%s). "
                    "Windows may not show this volume."
                    % (_tail(err, 1) or "unknown error"))
        return None

    def op_label(self, request):
        device = self.target(request)
        self.refuse_stacked(device)
        fstype = self.probe(device).get("TYPE", "")
        if fstype not in LABEL_TOOLS:
            raise Refusal("The label of a %s volume cannot be changed from "
                          "here." % (fstype or "blank"))
        tool_name, arguments = LABEL_TOOLS[fstype]
        kind = "ext4" if fstype in ("ext2", "ext3") else fstype
        if kind in FILESYSTEMS:
            label = check_label(kind, request.get("label", ""))
        else:
            label = check_label("ext4", request.get("label", ""))
        tool = self.need(tool_name)
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")
        self.need("blkid")

        total = 3 if mounted else 2
        with self.locked():
            index = 1
            if mounted:
                self.step(request, index, total, "unmount",
                          "Unmounting %s" % device.path)
                self.unmount(device)
                index += 1
            self.assert_free(device)
            self.step(request, index, total, "label", "Writing the new label")
            self.tool([tool] + arguments(device.path, label),
                      "Changing the label", timeout=300)
            self.settle()
            self.step(request, index + 1, total, "verify",
                      "Checking the result")
            found = self.probe(device)
            if found.get("LABEL", "") != label:
                raise Refusal("The label reads back as '%s' instead of '%s'."
                              % (found.get("LABEL", ""), label))
        return {"device": device.path, "label": label, "was_mounted": mounted}

    # ---- TRIM ---------------------------------------------------------------

    def op_trim(self, request):
        """Tell the drive which blocks of a mounted filesystem are unused."""
        device = self.target(request, system=True, writable=False)
        fstrim = self.need("fstrim")
        entry = self.mounted_at(device, writable=True)
        with self.locked():
            self.step(request, 1, 1, "trim",
                      "Telling the drive which blocks are free", True)
            code, lines = self.stream(
                [fstrim, "--verbose", "--", entry["mountpoint"]],
                "TRIM", ok=None,
                stopped_text="Stopped. Nothing was lost: TRIM only tells "
                             "the drive what is already unused.")
        text = "\n".join(lines)
        if code != 0:
            if "not supported" in text or "not permitted" in text:
                raise Refusal(
                    "This drive, or the adapter it is connected through, "
                    "does not accept TRIM. Many USB enclosures do not pass "
                    "it on.")
            raise Refusal("TRIM failed:\n%s"
                          % (_tail(text) or "exit status %d" % code))
        found = re.search(r"\((\d+) bytes\) trimmed", text)
        return {"device": device.path, "mountpoint": entry["mountpoint"],
                "trimmed": int(found.group(1)) if found else None}

    def op_trim_timer(self, request):
        """Switch the system's weekly TRIM of every mounted drive on or off."""
        enable = request.get("enable")
        if not isinstance(enable, bool):
            raise Refusal("The request does not say on or off.")
        systemctl = self.need("systemctl")
        self.step(request, 1, 1, "timer",
                  "Switching the weekly TRIM %s" % ("on" if enable else "off"))
        self.tool([systemctl, "enable" if enable else "disable", "--now",
                   "fstrim.timer"], "Changing the weekly TRIM", timeout=120)
        try:
            _code, out, _err = self.run_tool(
                [systemctl, "is-enabled", "fstrim.timer"], None, 60)
        except (OSError, subprocess.SubprocessError):
            out = ""
        state = out.strip() == "enabled"
        if state != enable:
            raise Refusal("The weekly TRIM reads back as '%s'."
                          % (out.strip() or "unknown"))
        return {"enabled": state}

    # ---- fragmentation --------------------------------------------------------

    def op_defrag_analyse(self, request):
        """Measure fragmentation with the filesystem's own tool."""
        device = self.target(request, system=True, writable=False)
        fstype = self.filesystem_of(device)
        stopped = "Stopped. Measuring changes nothing on the volume."
        if fstype == "ext4":
            e4defrag = self.need("e4defrag")
            entry = self.mounted_at(device)
            with self.locked():
                self.step(request, 1, 1, "analyse",
                          "Measuring fragmentation of %s"
                          % entry["mountpoint"], True)
                code, lines = self.stream(
                    [e4defrag, "-c", entry["mountpoint"]],
                    "Measuring fragmentation", ok=None, stopped_text=stopped)
            text = "\n".join(lines)
            score = re.search(r"Fragmentation score\s+(\d+)", text)
            if score is None:
                raise Refusal("The fragmentation could not be measured:\n%s"
                              % (_tail(text) or "exit status %d" % code))
            # The bands are the tool's own, read from the line it prints
            # under the score; these are what it has printed for years.
            low, high = 30, 55
            bands = re.search(r"\[0-(\d+) no problem: \d+-(\d+) a little",
                              text)
            if bands:
                low, high = int(bands.group(1)), int(bands.group(2))
            extents = re.search(r"Total/best extents\s+(\d+)/(\d+)", text)
            value = int(score.group(1))
            return {"device": device.path, "fstype": fstype, "score": value,
                    "low": low, "high": high,
                    "verdict": ("none" if value <= low else
                                "some" if value <= high else "needed"),
                    "extents": [int(extents.group(1)), int(extents.group(2))]
                    if extents else None}
        if fstype == "xfs":
            xfs_db = self.need("xfs_db")
            with self.locked():
                self.step(request, 1, 1, "analyse",
                          "Measuring fragmentation of %s" % device.path, True)
                _code, lines = self.stream(
                    [xfs_db, "-r", "-c", "frag", device.path],
                    "Measuring fragmentation", stopped_text=stopped)
            text = "\n".join(lines)
            found = re.search(r"actual (\d+), ideal (\d+), fragmentation "
                              r"factor ([0-9.]+)%", text)
            if found is None:
                raise Refusal("The fragmentation could not be measured:\n%s"
                              % _tail(text))
            # XFS's own tool calls its figure "largely meaningless", so no
            # verdict is made of it: the numbers are passed on as they are.
            return {"device": device.path, "fstype": fstype,
                    "verdict": "unrated", "factor": float(found.group(3)),
                    "extents": [int(found.group(1)), int(found.group(2))]}
        raise Refusal("Fragmentation of a %s volume cannot be measured."
                      % fstype)

    def op_defrag(self, request):
        """Defragment a mounted filesystem with its own online tool."""
        device = self.target(request, system=True)
        fstype = self.filesystem_of(device)
        if fstype == "ext4":
            argv = [self.need("e4defrag"), "-v"]
        elif fstype == "xfs":
            argv = [self.need("xfs_fsr"), "-v"]
        elif fstype == "btrfs":
            argv = [self.need("btrfs"), "filesystem", "defragment", "-r"]
        else:
            raise Refusal("A %s volume cannot be defragmented from Linux."
                          % fstype)
        entry = self.mounted_at(device, writable=True)
        counted = [0, 0]

        def follow(line):
            # e4defrag numbers the files as it goes: "[12/3456]/path: ..."
            found = re.match(r"\[(\d+)/(\d+)\]", line)
            if found:
                counted[0], counted[1] = int(found.group(1)), int(
                    found.group(2))
                self.progress(request, counted[0], counted[1])

        with self.locked():
            self.step(request, 1, 1, "defrag",
                      "Defragmenting %s" % entry["mountpoint"], True)
            code, lines = self.stream(
                argv + [entry["mountpoint"]], "Defragmenting",
                on_line=follow, ok=None,
                stopped_text="Stopped. Files already defragmented stay that "
                             "way; nothing was lost.")
        text = "\n".join(lines)
        done = re.search(r"Success:\s+\[\s*(\d+)/(\d+)\s*\]", text)
        failed = re.search(r"Failure:\s+\[\s*(\d+)/(\d+)\s*\]", text)
        if code != 0 and not (done and int(done.group(1)) > 0):
            raise Refusal("Defragmenting failed:\n%s"
                          % (_tail(text) or "exit status %d" % code))
        return {"device": device.path, "fstype": fstype,
                "files": int(done.group(1)) if done else None,
                "skipped": int(failed.group(1)) if failed else 0}

    # ---- free space -----------------------------------------------------------

    @staticmethod
    def _free_bytes(path):
        info = os.statvfs(path)
        return info.f_bfree * info.f_frsize, info.f_blocks * info.f_frsize

    def op_wipe_free(self, request):
        """Overwrite the unused space of a mounted filesystem.

        Done the only way that cannot touch a file: by writing new files
        until the filesystem is full, making sure they have reached the
        drive, and deleting them again.
        """
        pattern = request.get("pattern")
        if pattern not in WIPE_PATTERNS:
            raise Refusal("Unknown pattern.")
        device = self.target(request, system=True)
        entry = self.mounted_at(device, writable=True)
        point = entry["mountpoint"]

        forced = False
        compressing = any(option.startswith("compress")
                          for option in entry["options"])
        if pattern != "random" and (entry["fstype"] == "btrfs"
                                    or compressing):
            # A run of identical bytes compresses to nothing (and Btrfs can
            # store it without using a block at all): the filesystem would
            # never fill up and the free blocks would never be written.
            pattern, forced = "random", True

        free, size = self._free_bytes(point)
        reserve = 0
        if self.is_system(device):
            reserve = max(WIPE_RESERVE[0], int(size * WIPE_RESERVE[1]))
        elif entry["fstype"] == "btrfs":
            reserve = max(WIPE_RESERVE_BTRFS[0],
                          int(size * WIPE_RESERVE_BTRFS[1]))
        total = free - reserve
        if total <= 0:
            raise Refusal("There is too little free space on %s to "
                          "overwrite safely." % point)

        directory = os.path.join(point, "%s%d" % (WIPE_PREFIX, os.getpid()))
        with self.locked():
            self.step(request, 1, 2, "fill",
                      "Overwriting the free space of %s" % point, True)
            try:
                os.mkdir(directory, 0o700)
            except OSError as exc:
                raise Refusal("Cannot write to %s: %s"
                              % (point, exc.strerror or exc))
            self.fill_dirs.append(directory)
            try:
                written = self._fill(request, directory, point,
                                     WIPE_PATTERNS[pattern], total, reserve)
            finally:
                self.cancellable = False
                self.step(request, 2, 2, "remove",
                          "Removing the files used for filling")
                left = self._remove_fill(directory)
            if left:
                raise Refusal(
                    "The free space was overwritten, but the files used "
                    "for it could not all be removed. Delete the folder "
                    "%s to get the space back." % directory)
        return {"device": device.path, "mountpoint": point,
                "written": written, "pattern": pattern, "forced": forced,
                "reserve": reserve}

    def _fill(self, request, directory, point, byte, total, reserve):
        """Write files into `directory` until the filesystem is full, or
        down to `reserve` bytes free. Returns how much was written."""
        written = synced = 0
        last = 0.0
        number = 0
        block = byte * CHUNK if byte is not None else None
        full = False
        while not full:
            number += 1
            path = os.path.join(directory, "%06d" % number)
            try:
                fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL,
                             0o600)
            except OSError as exc:
                if exc.errno in (errno.ENOSPC, errno.EDQUOT):
                    break
                raise Refusal("Writing to %s failed: %s"
                              % (point, exc.strerror or exc))
            in_file = 0
            piece = CHUNK
            try:
                while in_file < WIPE_FILE:
                    self.check_cancel()
                    if reserve:
                        room = self._free_bytes(point)[0] - reserve
                        if room <= 0:
                            full = True
                            break
                        piece = min(piece, max(4096, room - room % 4096))
                    data = block if block is not None else os.urandom(CHUNK)
                    try:
                        count = os.write(fd, memoryview(data)[:piece])
                    except OSError as exc:
                        if exc.errno == errno.EFBIG:
                            break                    # this file is as big
                        if exc.errno in (errno.ENOSPC, errno.EDQUOT):
                            # The last stretch is smaller than a chunk: go
                            # down to single blocks before calling it full.
                            if piece > 4096:
                                piece = 4096
                                continue
                            full = True
                            break
                        raise Refusal(
                            "Writing to %s failed after %s: %s. The drive "
                            "may be failing."
                            % (point, _megabytes(written),
                               exc.strerror or exc))
                    if count == 0:
                        full = True
                        break
                    in_file += count
                    written += count
                    if written - synced >= SYNC_EVERY:
                        # Without this a filesystem that delays allocating
                        # blocks would never write most of them: the files
                        # are deleted before it gets round to it.
                        os.fsync(fd)
                        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
                        synced = written
                    now = time.monotonic()
                    if now - last >= PROGRESS_INTERVAL:
                        self.progress(request, min(written, total), total)
                        last = now
                try:
                    os.fsync(fd)
                except OSError:
                    pass
            finally:
                os.close(fd)
        self.progress(request, total, total)
        return written

    def _remove_fill(self, directory):
        """Delete a fill directory. Returns what could not be removed."""
        left = []
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            names = []
        for attempt in range(2):
            left = []
            for name in names:
                path = os.path.join(directory, name)
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass
                except OSError:
                    left.append(path)
            if not left:
                break
            # A completely full copy-on-write filesystem can need room to
            # delete; whatever was removed so far has made some.
            os.sync()
            names = [os.path.basename(path) for path in left]
        try:
            os.rmdir(directory)
        except OSError:
            if not left and os.path.isdir(directory):
                left.append(directory)
        # A copy-on-write filesystem gives the room back when it next
        # commits; asked to now, so the space is free again when this says
        # it is done.
        os.sync()
        if directory in self.fill_dirs and not left:
            self.fill_dirs.remove(directory)
        return left

    def op_wipe_cleanup(self, request):
        """Remove fill files a previous run left behind (a power cut, a
        crash): they are only recognisable waste of space."""
        device = self.target(request, system=True)
        removed = 0
        family = device.family()
        for entry in mount_entries():
            if entry["name"] not in family or "rw" not in entry["options"]:
                continue
            try:
                names = os.listdir(entry["mountpoint"])
            except OSError:
                continue
            for name in names:
                path = os.path.join(entry["mountpoint"], name)
                if (name.startswith(WIPE_PREFIX) and os.path.isdir(path)
                        and not os.path.islink(path)
                        and path not in self.fill_dirs):
                    if not self._remove_fill(path):
                        removed += 1
        return {"device": device.path, "removed": removed}

    # ---- checking and repairing -------------------------------------------------

    def op_check(self, request):
        """Check a filesystem and, when asked, repair it.

        The check changes nothing. A repair is followed by the same check
        again, so what is reported is what is on the device afterwards and
        not what the repairing tool said about its own work.
        """
        repair = bool(request.get("repair"))
        device = self.target(request, writable=repair)
        self.refuse_stacked(device)
        fstype = self.filesystem_of(device)
        spec = CHECK_TOOLS.get(fstype)
        if isinstance(spec, str):
            spec = CHECK_TOOLS[spec]
        if spec is None:
            raise Refusal("A %s volume cannot be checked from here." % fstype)
        if repair and spec["repair"] is None:
            raise Refusal(NO_BTRFS_REPAIR)
        tool = self.need(*spec["tool"])
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")
        if repair:
            self.refuse_unsafe_windows(device, fstype)

        names = (["unmount"] if mounted else []) + ["check"]
        names += ["repair", "verify"] if repair else []

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        def examine(key, text):
            begin(key, text, True)
            code, lines = self.stream(
                [tool] + spec["check"] + [device.path], "The check",
                ok=None, stopped_text="Stopped. The check changes nothing, "
                                      "so the volume is as it was.")
            if spec["failed"](code):
                raise Refusal("The check could not be carried out:\n%s"
                              % ("\n".join(lines[-8:])
                                 or "exit status %d" % code))
            return code == 0, lines

        with self.locked():
            if mounted:
                begin("unmount", "Unmounting %s" % device.path, True)
                self.unmount(device)
            self.check_cancel()
            self.assert_free(device)
            clean, lines = examine("check", "Checking %s" % device.path)
            state = "clean" if clean else "errors"
            if repair and not clean:
                begin("repair", "Repairing %s" % device.path)
                _code, fixing = self.stream(
                    [tool] + spec["repair"] + [device.path], "The repair",
                    ok=None)
                self.settle()
                clean, lines = examine("verify", "Checking again")
                state = "repaired" if clean else "unrepaired"
                lines = fixing[-30:] + ["", "After the repair:"] + lines
        result = {"device": device.path, "fstype": fstype, "state": state,
                  "output": "\n".join(lines[-60:]), "was_mounted": mounted}
        if fstype == "ntfs":
            result["note"] = (
                "Linux can only make basic repairs to NTFS. For a full "
                "check, start Windows and run 'chkdsk /f' on this drive.")
        return result

    # ---- copying: the moving of bytes -------------------------------------------

    def _read_exact(self, fd, offset, count):
        """`count` bytes at `offset`, or fewer only at the very end."""
        pieces = []
        while count > 0:
            data = os.pread(fd, count, offset)
            if not data:
                break
            pieces.append(data)
            offset += len(data)
            count -= len(data)
        return b"".join(pieces)

    def _read_around(self, path, offset, count, skipped):
        """The same, block by block, with what cannot be read replaced by
        zeros and noted in `skipped`.

        Read past the page cache: the cache holds a device in pieces far
        larger than a block and fails a whole piece for one bad sector in
        it, which would give up hundreds of readable kilobytes around each.
        """
        pieces = []
        end = offset + count
        reader = _Direct(path)
        try:
            while offset < end:
                want = min(SKIP_BLOCK, end - offset)
                try:
                    data = reader.read(offset, want)
                except OSError as exc:
                    if exc.errno not in MEDIUM_ERRORS:
                        raise
                    data = b"\0" * want
                    if skipped and sum(skipped[-1]) == offset:
                        skipped[-1] = (skipped[-1][0], skipped[-1][1] + want)
                    else:
                        skipped.append((offset, want))
                if not data:
                    break
                pieces.append(data)
                offset += len(data)
        finally:
            reader.close()
        return b"".join(pieces)

    def device_reader(self, fd, length, name, skip_errors, skipped, start=0):
        """A function returning the next piece of a device, up to `length`
        bytes in all."""
        position = [start]
        end = start + length

        def read(count):
            count = min(count, end - position[0])
            if count <= 0:
                return b""
            try:
                data = self._read_exact(fd, position[0], count)
            except OSError as exc:
                if exc.errno not in MEDIUM_ERRORS:
                    raise Refusal("Reading %s failed: %s"
                                  % (name, exc.strerror or exc))
                if not skip_errors:
                    raise Refusal(
                        "%s could not be read %s in: %s. The drive has "
                        "unreadable areas. Nothing more was copied; to copy "
                        "everything that can still be read, choose 'Skip "
                        "unreadable areas'."
                        % (name, _megabytes(position[0] - start),
                           exc.strerror or exc))
                try:
                    data = self._read_around(name, position[0], count,
                                             skipped)
                except OSError as failure:
                    raise Refusal("Reading %s failed: %s"
                                  % (name, failure.strerror or failure))
            if len(data) < count:
                raise Refusal("%s ended %s before its stated size."
                              % (name, _megabytes(end - position[0]
                                                  - len(data))))
            position[0] += len(data)
            return data
        return read

    def device_writer(self, fd, name):
        """(write, finish) for a device or file: everything is written, and
        made to reach the medium as it goes."""
        counted = [0, 0]

        def write(data):
            view = memoryview(data)
            try:
                while view:
                    view = view[os.write(fd, view):]
            except OSError as exc:
                raise Refusal(
                    "Writing to %s failed after %s: %s. The target drive "
                    "may be failing, or too small."
                    % (name, _megabytes(counted[0]), exc.strerror or exc))
            counted[0] += len(data)
            if counted[0] - counted[1] >= SYNC_EVERY:
                os.fsync(fd)
                try:
                    os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
                except OSError:
                    pass
                counted[1] = counted[0]

        def finish():
            try:
                os.fsync(fd)
            except OSError as exc:
                raise Refusal("The last of the data could not be written "
                              "to %s: %s" % (name, exc.strerror or exc))
        return write, finish

    def pump(self, request, read, write, total, digest=None):
        """Move data from `read` to `write` until it runs out, reporting
        progress against `total` (None when the amount is not known)."""
        done = 0
        last = 0.0
        while True:
            self.check_cancel()
            data = read(CHUNK)
            if not data:
                break
            if digest is not None:
                digest.update(data)
            write(data)
            done += len(data)
            now = time.monotonic()
            if total and now - last >= PROGRESS_INTERVAL:
                self.progress(request, min(done, total), total)
                last = now
        if total:
            self.progress(request, total, total)
        return done

    def compare(self, request, first, second, length, skipped=(),
                names=("the source", "the copy")):
        """Read both back from the medium and compare them, byte for byte."""
        a, b = _Direct(first), _Direct(second)
        offset = 0
        last = 0.0
        try:
            while offset < length:
                self.check_cancel()
                want = min(CHUNK, length - offset)
                try:
                    one = a.read(offset, want)
                except OSError as exc:
                    if exc.errno in MEDIUM_ERRORS and skipped:
                        one = None
                    else:
                        raise Refusal("%s could not be read back: %s"
                                      % (names[0], exc.strerror or exc))
                try:
                    two = b.read(offset, want)
                except OSError as exc:
                    raise Refusal(
                        "%s could not be read back %s in: %s. The target "
                        "drive is faulty." % (names[1], _megabytes(offset),
                                              exc.strerror or exc))
                if one is not None and one != two \
                        and not self._differs_only_in(one, two, offset,
                                                      skipped):
                    where = offset + next(
                        (i for i in range(min(len(one), len(two)))
                         if one[i] != two[i]), min(len(one), len(two)))
                    raise Refusal(
                        "The copy does not match the original at byte %d "
                        "(%s in). What was written did not come back the "
                        "same: the target drive, its cable or its adapter "
                        "is faulty. Do not rely on this copy."
                        % (where, _megabytes(where)))
                if len(two) < want:
                    raise Refusal("%s is shorter than what was copied."
                                  % names[1])
                offset += want
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, offset, length)
                    last = now
            self.progress(request, length, length)
        finally:
            a.close()
            b.close()

    @staticmethod
    def _differs_only_in(one, two, offset, skipped):
        """Whether two chunks differ only inside areas that were skipped."""
        if not skipped or len(one) != len(two):
            return False
        for start in range(0, len(one), SKIP_BLOCK):
            if one[start:start + SKIP_BLOCK] != two[start:start + SKIP_BLOCK] \
                    and not _in_ranges(offset + start, SKIP_BLOCK, skipped):
                return False
        return True

    def digest_of(self, request, path, length, name):
        """SHA-256 of the first `length` bytes as they are on the medium."""
        reader = _Direct(path)
        digest = hashlib.sha256()
        offset = 0
        last = 0.0
        try:
            while offset < length:
                self.check_cancel()
                want = min(CHUNK, length - offset)
                try:
                    data = reader.read(offset, want)
                except OSError as exc:
                    raise Refusal("%s could not be read back %s in: %s."
                                  % (name, _megabytes(offset),
                                     exc.strerror or exc))
                if len(data) < want:
                    raise Refusal("%s is shorter than what was written."
                                  % name)
                digest.update(data)
                offset += want
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, offset, length)
                    last = now
            self.progress(request, length, length)
        finally:
            reader.close()
        return digest.hexdigest()

    @staticmethod
    def open_exclusive(device, write):
        """Open a block device so that nothing else can have it mounted or
        open exclusively at the same time."""
        flags = (os.O_WRONLY if write else os.O_RDONLY) | os.O_EXCL
        try:
            return os.open(device.path, flags)
        except OSError as exc:
            if exc.errno == errno.EBUSY:
                raise Refusal(
                    "%s is in use by the system or another program. Close "
                    "whatever is using it and try again." % device.path)
            raise Refusal("Cannot open %s: %s"
                          % (device.path, exc.strerror or exc))

    def reread_table(self, device):
        """Have the kernel look at a disk's partition table again."""
        if device.is_partition:
            return
        tool = self.find_tool("partprobe")
        argv = [tool, device.path] if tool else None
        if argv is None:
            tool = self.find_tool("blockdev")
            argv = [tool, "--rereadpt", device.path] if tool else None
        if argv is not None:
            try:
                self.run_tool(argv, None, 120)
            except (OSError, subprocess.SubprocessError):
                pass
        self.settle()

    def finish_table(self, device):
        """After a whole disk was written from a smaller one: a GPT keeps a
        second copy at the very end of the disk, which is now somewhere in
        the middle. Put it where it belongs, so the full size is usable."""
        if device.is_partition:
            return
        self.reread_table(device)
        if self.probe_table(device) != "gpt":
            return
        sfdisk = self.find_tool("sfdisk")
        if sfdisk is None:
            return
        try:
            self.run_tool([sfdisk, "--relocate", "gpt-bak-std", device.path],
                          None, 300)
        except (OSError, subprocess.SubprocessError):
            pass
        self.reread_table(device)

    def probe_table(self, device):
        """The partition table type on a disk, or "" - read without the
        refusal probe() makes of a device carrying two signatures."""
        blkid = self.find_tool("blkid")
        if blkid is None:
            return ""
        try:
            _code, out, _err = self.run_tool(
                [blkid, "--probe", "--output", "value", "--match-tag",
                 "PTTYPE", device.path], None, 60)
        except (OSError, subprocess.SubprocessError):
            return ""
        return out.strip()

    def unmount_all(self, request, begin, *devices):
        mounted = [d for d in devices if self.mounts_of(d)]
        if mounted:
            begin("unmount", "Unmounting %s"
                  % ", ".join(d.path for d in mounted), True)
            for device in mounted:
                self.unmount(device)
        return bool(mounted)

    def copy_target(self, request, source):
        """The device a copy is written to, checked against its source."""
        target = self.target(request, key="target",
                             identity="target_identity")
        self.refuse_stacked(target)
        if target.disk == source.disk and (
                target.name == source.name or not target.is_partition
                or not source.is_partition):
            raise Refusal("The copy cannot go onto the drive it is being "
                          "made from.")
        if target.is_partition != source.is_partition:
            raise Refusal("A whole drive is copied to a whole drive and a "
                          "partition to a partition.")
        return target

    def smart_method(self, fstype):
        """(tool path, argument builder) for a filesystem, or None when it
        is copied block for block."""
        spec = SMART_TOOLS.get(fstype)
        if spec is None:
            return None
        tool = self.find_tool(spec[0])
        return (tool, spec[1]) if tool else None

    def raw_copy(self, request, source, target, skip_errors, skipped,
                 length=None):
        """Copy `length` bytes of `source` onto `target`, start to start."""
        length = source.size if length is None else length
        src = self.open_exclusive(source, write=False)
        try:
            dst = self.open_exclusive(target, write=True)
        except Refusal:
            os.close(src)
            raise
        try:
            try:
                os.posix_fadvise(src, 0, 0, os.POSIX_FADV_SEQUENTIAL)
            except OSError:
                pass
            write, finish = self.device_writer(dst, target.path)
            self.pump(request, self.device_reader(
                src, length, source.path, skip_errors, skipped),
                write, length)
            finish()
        finally:
            os.close(src)
            os.close(dst)

    def copy_range(self, source, target, start, length):
        """Copy one stretch of a disk onto the same place on another."""
        try:
            src = os.open(source.path, os.O_RDONLY)
            try:
                data = self._read_exact(src, start, length)
            finally:
                os.close(src)
            dst = os.open(target.path, os.O_WRONLY)
            try:
                view = memoryview(data)
                offset = start
                while view:
                    count = os.pwrite(dst, view, offset)
                    view, offset = view[count:], offset + count
                os.fsync(dst)
            finally:
                os.close(dst)
        except OSError as exc:
            raise Refusal("Copying the start of %s failed: %s"
                          % (source.path, exc.strerror or exc))

    def smart_copy(self, request, source, target, method, fstype):
        """Copy a filesystem's used blocks with its own tool."""
        tool, arguments = method

        def follow(line):
            found = re.search(r"(\d+(?:\.\d+)?)\s*(?:%|percent)", line)
            if found:
                share = min(100.0, float(found.group(1))) / 100.0
                self.progress(request, int(source.size * share), source.size)

        self.stream([tool] + arguments(source.path, target.path),
                    "Copying %s" % source.path, on_line=follow,
                    stopped_text=STOPPED_COPY)
        self.progress(request, source.size, source.size)

    def check_before_copy(self, source, fstype):
        """A filesystem is only copied by its structure if that structure
        checks out; a damaged one is copied block for block or not at all."""
        spec = CHECK_TOOLS.get(fstype)
        if isinstance(spec, str):
            spec = CHECK_TOOLS[spec]
        tool = self.find_tool(*spec["tool"]) if spec else None
        if tool is None:
            return
        self.refuse_unsafe_windows(source, fstype)
        code, lines = self.stream([tool] + spec["check"] + [source.path],
                                  "Checking %s" % source.path, ok=None,
                                  stopped_text="Stopped before anything "
                                               "was copied.")
        if code != 0:
            raise Refusal(
                "The filesystem on %s has errors, so it cannot be copied "
                "by its contents:\n%s\n\nRepair it first (Maintain > Check "
                "for Errors), or choose the exact copy, which copies every "
                "block as it is." % (source.path, "\n".join(lines[-4:])))

    def verify_smart(self, source, target, fstype):
        """A copy made by a filesystem's tool: it checks out, and it is the
        same filesystem."""
        spec = CHECK_TOOLS.get(fstype)
        if isinstance(spec, str):
            spec = CHECK_TOOLS[spec]
        tool = self.find_tool(*spec["tool"]) if spec else None
        if tool is not None:
            code, lines = self.stream(
                [tool] + spec["check"] + [target.path],
                "Checking the copy", ok=None)
            if code != 0:
                raise Refusal(
                    "The copy on %s does not pass its filesystem check:\n%s"
                    % (target.path, "\n".join(lines[-4:])))
        self.settle()
        want, found = self.probe(source), self.probe(target)
        for tag in ("TYPE", "UUID", "LABEL"):
            if want.get(tag) != found.get(tag):
                raise Refusal(
                    "The copy on %s reads back with a different %s (%s "
                    "instead of %s)." % (target.path, tag.lower(),
                                         found.get(tag), want.get(tag)))

    def table_of(self, device):
        """A disk's partition table as sfdisk describes it: (the dump to
        write it again, the parsed description)."""
        sfdisk = self.need("sfdisk")
        dump = self.tool([sfdisk, "--dump", device.path],
                         "Reading the partition table", timeout=120)
        text = self.tool([sfdisk, "--json", device.path],
                         "Reading the partition table", timeout=120)
        try:
            table = json.loads(text)["partitiontable"]
        except (ValueError, KeyError):
            raise Refusal("The partition table of %s could not be read."
                          % device.path)
        return dump, table

    # ---- copying: the operations ------------------------------------------------

    def op_clone(self, request):
        """Copy a drive onto another, or a partition onto another.

        "exact" copies every block. "smart" copies each filesystem with its
        own tool, used blocks only, and whatever has no such tool block for
        block. Either way the result is read back and checked unless the
        request says not to.
        """
        mode = request.get("mode")
        if mode not in ("exact", "smart"):
            raise Refusal("Unknown kind of copy.")
        verify = request.get("verify", True) is not False
        skip_errors = bool(request.get("skip_errors"))
        grow = bool(request.get("grow"))

        source = self.target(request, key="source",
                             identity="source_identity", writable=False)
        self.refuse_stacked(source)
        target = self.copy_target(request, source)
        if target.size < source.size and (mode == "exact"
                                          or source.is_partition):
            raise Refusal(
                "%s (%s) is smaller than %s (%s). An exact copy needs a "
                "target at least as large."
                % (target.path, _megabytes(target.size), source.path,
                   _megabytes(source.size)))
        self.need("blkid")
        self.need("wipefs")
        if self.mounts_of(source) or self.mounts_of(target):
            self.need("umount")

        if source.is_partition:
            plan = self.partition_plan(source, target, mode)
        else:
            plan = self.disk_plan(source, target, mode)

        names = []
        if self.mounts_of(source) or self.mounts_of(target):
            names.append("unmount")
        if plan["checks"]:
            names.append("check")
        names.append("copy")
        if verify:
            names.append("verify")
        grow = grow and not target.is_partition and target.size > source.size
        if grow:
            names.append("grow")
        total = len(names)

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, total, key, text,
                      cancellable)

        skipped = []
        grown = {}
        stage = "before"
        try:
            with self.locked():
                self.unmount_all(request, begin, source, target)
                self.check_cancel()
                self.assert_free(target)
                if plan["checks"]:
                    begin("check", "Checking the source before copying it",
                          True)
                    for part, fstype in plan["checks"]:
                        self.check_before_copy(part, fstype)

                self.destroying = True
                stage = "copy"
                begin("copy", "Copying %s to %s" % (source.path, target.path),
                      True)
                for name in ([] if target.is_partition
                             else target.partitions()):
                    try:
                        self.wipe_signatures(Device(name))
                    except Refusal:
                        pass
                self.wipe_signatures(target)
                pairs = plan["run"](request, skipped)
                self.settle()

                if verify:
                    stage = "verify"
                    begin("verify", "Reading the copy back and comparing it",
                          True)
                    for kind, src, dst, fstype, length in pairs:
                        if kind == "raw":
                            self.compare(request, src.path, dst.path, length,
                                         skipped if src is source else ())
                        else:
                            self.verify_smart(src, dst, fstype)
                # Only now, with the copy proven identical: on a larger
                # drive the partition table is completed for that drive's
                # size, which changes a few bytes of it on purpose.
                self.cancellable = False
                if not target.is_partition:
                    self.finish_table(target)
                self.settle()
                if grow:
                    begin("grow", "Making the last partition use the free "
                          "space")
                    try:
                        grown["grown"] = self.grow_last(Device(target.name))
                    except Refusal as exc:
                        grown["grow_skipped"] = str(exc)
                    self.settle()
        except Cancelled:
            raise Cancelled({
                "before": "Stopped before anything was copied.",
                "copy": STOPPED_COPY,
                "verify": "Stopped while checking the copy. The copy itself "
                          "was finished, but it has not been compared with "
                          "the original.",
            }[stage])
        return {"source": source.path, "target": target.path, "mode": mode,
                "verified": verify, "skipped": skipped,
                "skipped_bytes": sum(size for _start, size in skipped),
                "methods": plan["methods"],
                "larger": target.size > source.size, **grown}

    def partition_plan(self, source, target, mode):
        fstype = self.probe(source).get("TYPE", "")
        method = self.smart_method(fstype) if mode == "smart" else None

        def run(request, skipped):
            if method is not None:
                self.smart_copy(request, source, target, method, fstype)
                return [("smart", source, target, fstype, source.size)]
            self.raw_copy(request, source, target,
                          bool(request.get("skip_errors")), skipped)
            return [("raw", source, target, fstype, source.size)]

        return {"checks": [(source, fstype)] if method else [],
                "run": run,
                "methods": [{"device": source.path, "fstype": fstype,
                             "method": os.path.basename(method[0])
                             if method else "exact"}]}

    def disk_plan(self, source, target, mode):
        if mode == "exact":
            def run(request, skipped):
                self.raw_copy(request, source, target,
                              bool(request.get("skip_errors")), skipped)
                return [("raw", source, target, "", source.size)]
            return {"checks": [], "run": run,
                    "methods": [{"device": source.path, "fstype": "",
                                 "method": "exact"}]}

        if source.logical_sector != target.logical_sector:
            raise Refusal(
                "The two drives use different sector sizes (%d and %d "
                "bytes), so a partition table cannot be carried over. Copy "
                "the partitions one at a time instead."
                % (source.logical_sector, target.logical_sector))
        dump, table = self.table_of(source)
        unit = table.get("sectorsize", source.logical_sector)
        entries = sorted(table.get("partitions", []),
                         key=lambda entry: entry["start"])
        if not entries:
            raise Refusal(
                "%s has no partitions to copy one by one. Choose the exact "
                "copy." % source.path)
        end = max(entry["start"] + entry["size"] for entry in entries) * unit
        reserve = 34 * unit if table.get("label") == "gpt" else 0
        if end + reserve > target.size:
            raise Refusal(
                "%s (%s) is too small: the partitions of %s reach %s."
                % (target.path, _megabytes(target.size), source.path,
                   _megabytes(end)))
        by_start = {}
        for name in source.partitions():
            part = Device(name)
            by_start[part.start] = part
        parts = []
        for entry in entries:
            part = by_start.get(entry["start"] * unit // 512)
            if part is None:
                raise Refusal("The partition table of %s does not match "
                              "what the system sees." % source.path)
            if str(entry.get("type", "")).lower() in ("5", "f", "85"):
                continue                 # an extended container: no contents
            fstype = self.probe(part).get("TYPE", "")
            parts.append((part, fstype, self.smart_method(fstype)))

        # What sits before the first partition besides the table itself:
        # the boot code in the first sector, and whatever a boot loader has
        # embedded in the gap after the table. Writing a table blanks the
        # former, so both are put back afterwards.
        head = min(entries[0]["start"] * unit, MIB)
        table_end = 34 * unit if table.get("label") == "gpt" else 512
        # sfdisk refuses a dump whose stated last sector is beyond the
        # target; left out, it works the usable range out for itself.
        script = "\n".join(line for line in dump.splitlines()
                           if not line.startswith(("last-lba:",
                                                   "first-lba:")))

        def run(request, skipped):
            self.tool([self.need("sfdisk"), "--quiet", "--wipe", "always",
                       "--wipe-partitions", "always", target.path],
                      "Writing the partition table", stdin=script + "\n",
                      timeout=300)
            self.copy_range(source, target, 0, 440)
            if head > table_end:
                self.copy_range(source, target, table_end, head - table_end)
            self.settle()
            done = []
            for part, fstype, method in parts:
                self.check_cancel()
                twin = self.wait_for_partition(target, part.number)
                if twin.size < part.size:
                    raise Refusal("%s came out smaller than %s."
                                  % (twin.path, part.path))
                self.cancellable = True
                if method is not None:
                    self.smart_copy(request, part, twin, method, fstype)
                    done.append(("smart", part, twin, fstype, part.size))
                else:
                    self.raw_copy(request, part, twin, False, [])
                    done.append(("raw", part, twin, fstype, part.size))
            return done

        return {"checks": [(p, f) for p, f, m in parts if m is not None],
                "run": run,
                "methods": [{"device": p.path, "fstype": f,
                             "method": os.path.basename(m[0]) if m
                             else "exact"} for p, f, m in parts]}

    # ---- image files --------------------------------------------------------------

    @contextlib.contextmanager
    def as_user(self):
        """Run a block as the person who asked, not as root.

        An image file is theirs: it is created with their identity, so it
        lands where they may write, belongs to them, and a path they may
        not reach is refused by the system rather than quietly opened.
        """
        owner = invoking_user()
        if owner is None or os.geteuid() != 0:
            yield
            return
        os.setegid(owner[1])
        os.seteuid(owner[0])
        try:
            yield
        finally:
            os.seteuid(0)
            os.setegid(0)

    @staticmethod
    def image_path(request):
        path = request.get("path")
        if (not isinstance(path, str) or not os.path.isabs(path)
                or "\0" in path or len(path) > 4000):
            raise Refusal("That is not a file path.")
        return os.path.normpath(path)

    def refuse_same_drive(self, path, device):
        """An image cannot be kept on the drive it is an image of."""
        try:
            where = os.stat(os.path.dirname(path) or "/").st_dev
        except OSError as exc:
            raise Refusal("%s: %s" % (os.path.dirname(path),
                                      exc.strerror or exc))
        family = Device(device.disk).family()
        for entry in mount_entries():
            if entry["name"] not in family:
                continue
            try:
                if os.stat(entry["mountpoint"]).st_dev == where:
                    raise Refusal(
                        "That folder is on %s itself. Choose a place on "
                        "another drive." % device.disk_path)
            except OSError:
                continue

    def op_image_create(self, request):
        """Copy a drive or partition into an image file, every block."""
        path = self.image_path(request)
        compress = bool(request.get("compress"))
        verify = request.get("verify", True) is not False
        skip_errors = bool(request.get("skip_errors"))
        source = self.target(request, writable=False)
        self.refuse_stacked(source)
        self.refuse_same_drive(path, source)
        mounted = bool(self.mounts_of(source))
        if mounted:
            self.need("umount")

        names = (["unmount"] if mounted else []) + ["copy"]
        names += ["verify"] if verify else []

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        with self.as_user():
            try:
                room = os.statvfs(os.path.dirname(path))
            except OSError as exc:
                raise Refusal("%s: %s" % (os.path.dirname(path),
                                          exc.strerror or exc))
            free = room.f_bavail * room.f_frsize
            if not compress and free < source.size:
                raise Refusal(
                    "There is not enough room for the image: it needs %s "
                    "and %s is free there." % (_megabytes(source.size),
                                               _megabytes(free)))
            flags = os.O_WRONLY | os.O_CREAT | os.O_NOFOLLOW
            flags |= os.O_TRUNC if request.get("overwrite") else os.O_EXCL
            try:
                out = os.open(path, flags, 0o644)
            except FileExistsError:
                raise Refusal("%s already exists." % path)
            except OSError as exc:
                raise Refusal("Cannot create %s: %s"
                              % (path, exc.strerror or exc))
        skipped = []
        digest = hashlib.sha256()
        complete = False
        try:
            if not stat.S_ISREG(os.fstat(out).st_mode):
                raise Refusal("%s is not an ordinary file." % path)
            with self.locked():
                if mounted:
                    begin("unmount", "Unmounting %s" % source.path, True)
                    self.unmount(source)
                begin("copy", "Copying %s to %s" % (source.path, path), True)
                src = self.open_exclusive(source, write=False)
                try:
                    read = self.device_reader(src, source.size, source.path,
                                              skip_errors, skipped)
                    if compress:
                        # Closing the gzip stream does not close a file it
                        # was given, and its buffer would otherwise reach the
                        # disk only when collected - after the fsync below,
                        # with any write error lost.
                        raw = os.fdopen(os.dup(out), "wb")
                        packed = gzip.GzipFile(
                            fileobj=raw, mode="wb", compresslevel=1, mtime=0)
                        try:
                            self.pump(request, read, self._file_write(
                                packed, path), source.size, digest)
                        finally:
                            try:
                                self._close(packed, path)
                            finally:
                                self._close(raw, path)
                    else:
                        write, _finish = self.device_writer(out, path)
                        self.pump(request, read, write, source.size, digest)
                    try:
                        os.fsync(out)
                    except OSError as exc:
                        raise Refusal("The image could not be written "
                                      "completely: %s"
                                      % (exc.strerror or exc))
                finally:
                    os.close(src)
                if verify:
                    self.cancellable = True
                    begin("verify", "Reading the image back and comparing "
                          "it", True)
                    if self.image_digest(request, path, source.size,
                                         compress) != digest.hexdigest():
                        raise Refusal(
                            "The image does not read back the same as what "
                            "was written. The drive it was saved on is "
                            "faulty; do not rely on this image.")
            complete = True
        except Cancelled:
            raise Cancelled("Stopped. The unfinished image file was "
                            "removed; the source was not changed.")
        finally:
            os.close(out)
            if not complete:
                with self.as_user():
                    try:
                        os.unlink(path)
                    except OSError:
                        pass
        return {"source": source.path, "path": path, "size": source.size,
                "stored": os.path.getsize(path), "compressed": compress,
                "verified": verify, "sha256": digest.hexdigest(),
                "skipped": skipped,
                "skipped_bytes": sum(size for _start, size in skipped),
                "was_mounted": mounted}

    @staticmethod
    def _file_write(handle, path):
        def write(data):
            try:
                handle.write(data)
            except OSError as exc:
                raise Refusal("Writing %s failed: %s. Is the drive it is "
                              "on full?" % (path, exc.strerror or exc))
        return write

    @staticmethod
    def _close(handle, path):
        try:
            handle.close()
        except OSError as exc:
            raise Refusal("Writing %s failed: %s"
                          % (path, exc.strerror or exc))

    def image_digest(self, request, path, length, compressed):
        """SHA-256 of an image's contents, read back from the medium."""
        if not compressed:
            return self.digest_of(request, path, length, "The image")
        digest = hashlib.sha256()
        done = 0
        last = 0.0
        fd = os.open(path, os.O_RDONLY)
        try:
            os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
        except OSError:
            pass
        with os.fdopen(fd, "rb") as raw, gzip.GzipFile(fileobj=raw) as data:
            while True:
                self.check_cancel()
                try:
                    piece = data.read(CHUNK)
                except (OSError, EOFError, ValueError) as exc:
                    raise Refusal("The image could not be read back: %s"
                                  % exc)
                if not piece:
                    break
                digest.update(piece)
                done += len(piece)
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, min(done, length), length)
                    last = now
        if done != length:
            raise Refusal("The image holds %s instead of %s."
                          % (_megabytes(done), _megabytes(length)))
        return digest.hexdigest()

    def open_image(self, path):
        """(file object, is it gzip) for an image, opened as the user."""
        with self.as_user():
            try:
                fd = os.open(path, os.O_RDONLY)
            except OSError as exc:
                raise Refusal("Cannot open %s: %s"
                              % (path, exc.strerror or exc))
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            os.close(fd)
            raise Refusal("%s is not an ordinary file." % path)
        packed = os.pread(fd, 2, 0) == b"\x1f\x8b"
        return os.fdopen(fd, "rb"), packed

    def image_size(self, request, path, handle, packed):
        """How much data an image holds once unpacked.

        A compressed file does not say dependably, so it is unpacked once
        just to be counted: a drive must not be half overwritten before it
        turns out the image does not fit.
        """
        if not packed:
            return os.fstat(handle.fileno()).st_size
        count = 0
        compressed = os.fstat(handle.fileno()).st_size
        last = 0.0
        with gzip.GzipFile(fileobj=handle) as data:
            while True:
                self.check_cancel()
                try:
                    piece = data.read(CHUNK)
                except (OSError, EOFError, ValueError) as exc:
                    raise Refusal("%s is damaged and cannot be unpacked: %s"
                                  % (path, exc))
                if not piece:
                    break
                count += len(piece)
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, min(handle.tell(), compressed),
                                  compressed)
                    last = now
        handle.seek(0)
        return count

    def op_image_restore(self, request):
        """Write an image file onto a drive or partition, block for block.

        The same operation writes an installer image (an .iso) to a memory
        stick: such an image is laid out as a drive already.
        """
        path = self.image_path(request)
        verify = request.get("verify", True) is not False
        target = self.target(request)
        self.refuse_stacked(target)
        self.refuse_same_drive(path, target)
        self.need("wipefs")
        self.need("blkid")
        mounted = bool(self.mounts_of(target))
        if mounted:
            self.need("umount")
        handle, packed = self.open_image(path)

        names = (["unmount"] if mounted else [])
        names += ["measure"] if packed else []
        names += ["copy"] + (["verify"] if verify else [])

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        try:
            with self.locked():
                if mounted:
                    begin("unmount", "Unmounting %s" % target.path, True)
                    self.unmount(target)
                if packed:
                    begin("measure", "Measuring the compressed image", True)
                size = self.image_size(request, path, handle, packed)
                if size <= 0:
                    raise Refusal("%s is empty." % path)
                if size > target.size:
                    raise Refusal(
                        "The image holds %s and %s is only %s. It does not "
                        "fit." % (_megabytes(size), target.path,
                                  _megabytes(target.size)))
                self.check_cancel()
                self.assert_free(target)

                self.destroying = True
                begin("copy", "Writing %s to %s" % (path, target.path), True)
                for name in ([] if target.is_partition
                             else target.partitions()):
                    try:
                        self.wipe_signatures(Device(name))
                    except Refusal:
                        pass
                self.wipe_signatures(target)
                data = gzip.GzipFile(fileobj=handle) if packed else handle

                def read(count):
                    try:
                        return data.read(count)
                    except (OSError, EOFError, ValueError) as exc:
                        raise Refusal("Reading %s failed: %s" % (path, exc))

                digest = hashlib.sha256()
                dst = self.open_exclusive(target, write=True)
                try:
                    write, finish = self.device_writer(dst, target.path)
                    done = self.pump(request, read, write, size, digest)
                    finish()
                finally:
                    os.close(dst)
                if done != size:
                    raise Refusal("The image changed while it was being "
                                  "written.")
                if verify:
                    begin("verify", "Reading %s back and comparing it"
                          % target.path, True)
                    if self.digest_of(request, target.path, size,
                                      target.path) != digest.hexdigest():
                        raise Refusal(
                            "What was written to %s does not read back the "
                            "same. The drive, its cable or its adapter is "
                            "faulty." % target.path)
                # After the comparison: completing a partition table for a
                # larger drive changes a few of its bytes on purpose.
                self.cancellable = False
                self.finish_table(target)
                self.settle()
        except Cancelled:
            raise Cancelled("Stopped. %s holds part of the image and is "
                            "not usable until it is written again or "
                            "formatted." % target.path
                            if self.destroying else
                            "Stopped before anything was written.")
        finally:
            handle.close()
        found = self.probe_table(target) if not target.is_partition else ""
        return {"target": target.path, "path": path, "size": size,
                "verified": verify, "table": found,
                "sha256": digest.hexdigest()}

    # ---- partitions: reading and writing the table -------------------------------

    def layout(self, disk):
        """A disk's partition table: {"label", "unit", "first", "end",
        "entries", "dump"}.

        `first` and `end` bound, in bytes, where partitions may be; each
        entry has number, start and size in bytes, type and node.
        """
        dump, table = self.table_of(disk)
        unit = int(table.get("sectorsize") or disk.logical_sector)
        label = table.get("label", "")
        if label == "gpt":
            first = int(table.get("firstlba", 2048)) * unit
            end = (int(table.get("lastlba", disk.size // unit - 34)) + 1) * unit
        else:
            # An MBR records sectors in 32 bits: nothing can end past that.
            first, end = unit, min(disk.size, 2 ** 32 * unit)
        entries = []
        for entry in table.get("partitions", []):
            found = re.search(r"(\d+)$", str(entry.get("node", "")))
            if not found:
                continue
            entries.append({
                "number": int(found.group(1)),
                "start": int(entry["start"]) * unit,
                "size": int(entry["size"]) * unit,
                "type": str(entry.get("type", "")),
                "node": entry["node"],
                "extended": (label == "dos" and str(entry.get(
                    "type", "")).lower() in EXTENDED_TYPES)})
        entries.sort(key=lambda entry: entry["start"])
        return {"label": label, "unit": unit, "first": max(first, MIB),
                "end": end, "entries": entries, "dump": dump}

    @staticmethod
    def _container(layout):
        for entry in layout["entries"]:
            if entry["extended"]:
                return entry
        return None

    def _is_logical(self, layout, entry):
        container = self._container(layout)
        return (container is not None and not entry["extended"]
                and container["start"] <= entry["start"]
                < container["start"] + container["size"])

    def gaps(self, layout):
        """[(start, end, logical)] - the unallocated stretches a partition
        could be made in, both ends on a MiB boundary.

        On an MBR disk with an extended partition, the room inside it is
        listed separately and marked: a partition made there is a logical
        one, and needs a sector in front of it for its own record.
        """
        container = self._container(layout)

        def between(spans, low, high, lead):
            found, cursor = [], low
            for start, stop in sorted(spans) + [(high, high)]:
                begin = -(-(cursor + lead) // MIB) * MIB
                finish = (start // MIB) * MIB
                if finish - begin >= MIB:
                    found.append((begin, finish))
                cursor = max(cursor, stop)
            return found

        outer = [(e["start"], e["start"] + e["size"])
                 for e in layout["entries"]
                 if not self._is_logical(layout, e)]
        found = [(a, b, False) for a, b
                 in between(outer, layout["first"], layout["end"], 0)]
        if container is not None:
            inner = [(e["start"], e["start"] + e["size"])
                     for e in layout["entries"]
                     if self._is_logical(layout, e)]
            found += [(a, b, True) for a, b in between(
                inner, container["start"],
                container["start"] + container["size"], layout["unit"])]
        return sorted(found)

    def save_table(self, disk, layout):
        """Keep the table as it is now, before it is changed. Returns the
        file, which `sfdisk <disk> < file` writes back."""
        folder = os.path.join(STATE_DIR, "tables")
        try:
            os.makedirs(folder, mode=0o755, exist_ok=True)
            name = "%s-%s.sfdisk" % (
                disk.name, time.strftime("%Y%m%d-%H%M%S"))
            path = os.path.join(folder, name)
            serial = 1
            while os.path.exists(path):
                serial += 1
                path = os.path.join(folder, "%s.%d" % (name, serial))
            with open(path, "w") as handle:
                handle.write(layout["dump"])
                handle.flush()
                os.fsync(handle.fileno())
            kept = sorted(n for n in os.listdir(folder)
                          if n.startswith(disk.name + "-"))
            for old in kept[:-TABLE_BACKUPS]:
                try:
                    os.unlink(os.path.join(folder, old))
                except OSError:
                    pass
        except OSError as exc:
            # Not written, not started: an edit without a way back is not
            # one this makes.
            raise Refusal("The current partition table could not be saved "
                          "first (%s), so nothing was changed."
                          % (exc.strerror or exc))
        return path

    def write_table(self, disk, arguments, script, what, saved):
        """Run sfdisk on a disk whose other partitions may be in use."""
        sfdisk = self.need("sfdisk")
        try:
            self.tool([sfdisk, "--no-reread", "--quiet"] + arguments
                      + [disk.path], what, stdin=script, timeout=300)
        except Refusal as exc:
            raise Refusal("%s\n\nThe partition table was not changed. (Its "
                          "previous state is also saved in %s.)"
                          % (exc, saved))

    def tell_kernel(self, disk, removed=None):
        """Have the running system take up the table just written, without
        disturbing partitions that are in use."""
        partprobe = self.find_tool("partprobe")
        partx = self.find_tool("partx")
        try:
            if partprobe:
                self.run_tool([partprobe, disk.path], None, 120)
            elif partx:
                if removed is not None:
                    self.run_tool([partx, "--delete", "--nr", str(removed),
                                   disk.path], None, 120)
                self.run_tool([partx, "--update", disk.path], None, 120)
        except (OSError, subprocess.SubprocessError):
            pass
        self.settle()

    def seen_by_kernel(self, disk, layout, timeout=15.0):
        """Whether the running system has the partitions the table has."""
        want = {entry["number"]: (entry["start"] // 512,
                                  entry["size"] // 512)
                for entry in layout["entries"]}
        deadline = time.monotonic() + timeout
        while True:
            have = {}
            for name in disk.partitions():
                entry = os.path.join(SYS_CLASS_BLOCK, name)
                number = _read_int(os.path.join(entry, "partition"))
                size = _read_int(os.path.join(entry, "size"))
                start = _read_int(os.path.join(entry, "start"))
                have[number] = (start, size)
            # An extended partition shows in sysfs as two sectors, whatever
            # its size in the table: only its place is compared.
            same = set(have) == set(want) and all(
                have[n] == want[n] or (
                    have[n][0] == want[n][0] and have[n][1] <= 2)
                for n in want)
            if same:
                return True
            if time.monotonic() >= deadline:
                return False
            time.sleep(0.25)

    def commit_table(self, disk, removed=None):
        """Tell the system about a written table and make sure it took it.
        Returns the table as it is now."""
        self.tell_kernel(disk, removed)
        layout = self.layout(disk)
        if not self.seen_by_kernel(disk, layout):
            self.tell_kernel(disk, removed)
            if not self.seen_by_kernel(disk, layout, 5.0):
                raise Refusal(NOT_SEEN)
        return layout

    def partition_entry(self, layout, device):
        for entry in layout["entries"]:
            if entry["number"] == device.number \
                    and entry["start"] // 512 == device.start:
                return entry
        raise Refusal("The partition table of %s does not match what the "
                      "system sees. Restart the computer and try again."
                      % device.disk_path)

    def room_around(self, layout, entry):
        """(lowest start, highest end) a partition could have without
        touching another - the room for moving and growing it."""
        container = self._container(layout)
        logical = self._is_logical(layout, entry)
        low, high = layout["first"], layout["end"]
        lead = 0
        if logical:
            low = container["start"]
            high = container["start"] + container["size"]
            lead = layout["unit"]
        for other in layout["entries"]:
            if other is entry or (other["extended"] and logical):
                continue
            if not logical and self._is_logical(layout, other):
                continue                 # inside the container: not a peer
            stop = other["start"] + other["size"]
            if stop <= entry["start"]:
                low = max(low, stop)
            elif other["start"] >= entry["start"] + entry["size"]:
                high = min(high, other["start"] - lead)
        low = -(-(low + lead) // MIB) * MIB
        return min(low, entry["start"]), max(high, entry["start"]
                                             + entry["size"])

    # ---- partitions: filesystems that change size ----------------------------------

    def fs_minimum(self, device, fstype, point=None):
        """The smallest size the filesystem's own tool says it can have, in
        bytes, or None where it cannot say."""
        try:
            if fstype in ("ext2", "ext3", "ext4"):
                tool = self.find_tool("resize2fs")
                info = self.find_tool("dumpe2fs")
                if not tool or not info:
                    return None
                _c, out, err = self.run_tool([tool, "-P", device.path],
                                             None, 600)
                blocks = re.search(r"minimum size of the filesystem:\s*(\d+)",
                                   out + err)
                _c, out, _e = self.run_tool([info, "-h", device.path],
                                            None, 120)
                size = re.search(r"^Block size:\s*(\d+)", out, re.M)
                if blocks and size:
                    return int(blocks.group(1)) * int(size.group(1))
            elif fstype == "ntfs":
                tool = self.find_tool("ntfsresize")
                if not tool:
                    return None
                _c, out, err = self.run_tool(
                    [tool, "--info", "--force", device.path], None, 600)
                found = re.search(r"You might resize at (\d+) bytes",
                                  out + err)
                if found:
                    return int(found.group(1))
            elif fstype == "btrfs" and point:
                tool = self.find_tool("btrfs")
                if not tool:
                    return None
                _c, out, _e = self.run_tool(
                    [tool, "inspect-internal", "min-dev-size", point],
                    None, 600)
                found = re.match(r"\s*(\d+) bytes", out)
                if found:
                    return max(int(found.group(1)), BTRFS_SMALLEST)
            elif fstype == "swap":
                return MIB
        except (OSError, subprocess.SubprocessError):
            return None
        return None

    @staticmethod
    def with_margin(minimum):
        if minimum is None:
            return None
        padded = minimum + max(SHRINK_MARGIN[0],
                               int(minimum * SHRINK_MARGIN[1]))
        return -(-padded // MIB) * MIB

    @contextlib.contextmanager
    def mounted_somewhere(self, device, fstype, options=()):
        """A mount point for the device's filesystem: where it is mounted
        already, or a private one for the duration, with `options` added
        to the private mount."""
        family = device.family()
        entries = [e for e in mount_entries()
                   if e["name"] in family and "rw" in e["options"]]
        if entries:
            yield sorted(entries, key=lambda e: len(e["mountpoint"]))[0][
                "mountpoint"]
            return
        mount, umount = self.need("mount"), self.need("umount")
        point = tempfile.mkdtemp(prefix="ksyssupervisor-", dir=RUN_DIR)
        try:
            self.tool([mount, "-t", fstype, "-o", ",".join(
                ["nosuid", "nodev", "noexec"] + list(options)),
                       device.path, point], "Mounting the filesystem",
                      timeout=300)
            self.temp_mounts.append(point)
            try:
                yield point
            finally:
                self.tool([umount, "--", point],
                          "Unmounting the filesystem", timeout=300)
                self.temp_mounts.remove(point)
        finally:
            try:
                os.rmdir(point)
            except OSError:
                pass

    def checked_clean(self, device, fstype, what):
        """Refuse unless the filesystem passes its own read-only check."""
        spec = CHECK_TOOLS.get(fstype)
        if isinstance(spec, str):
            spec = CHECK_TOOLS[spec]
        tool = self.find_tool(*spec["tool"]) if spec else None
        if tool is None:
            return False
        code, lines = self.stream([tool] + spec["check"] + [device.path],
                                  "Checking %s" % device.path, ok=None)
        if code != 0:
            raise Refusal(
                "The filesystem on %s %s:\n%s\n\n%s"
                % (device.path, what, "\n".join(lines[-4:]),
                   "Repair it first (Maintain > Check for Errors)."
                   if "before" in what else
                   "Check it (Maintain > Check for Errors) before using "
                   "it."))
        return True

    def resize_filesystem(self, device, fstype, size, point, info):
        """Change a filesystem's size to `size` bytes, or to fill its
        partition when `size` is None."""
        if fstype in ("ext2", "ext3", "ext4"):
            tool = self.need("resize2fs")
            if point is None:
                # resize2fs wants a forced check on record before it works
                # on an unmounted filesystem; this one changes nothing on a
                # filesystem already found clean.
                e2fsck = self.need("e2fsck")
                self.stream([e2fsck, "-f", "-p", device.path],
                            "Checking the filesystem", ok=(0, 1))
            argv = [tool, device.path]
            if size is not None:
                argv.append("%dK" % (size // 1024))
            self.stream(argv, "Resizing the filesystem")
        elif fstype == "ntfs":
            tool = self.need("ntfsresize")
            want = size if size is not None else device.size
            trial = [tool, "--no-action", "--force", "--size", str(want),
                     device.path]
            self.stream(trial, "Trying the resize without changing "
                               "anything")
            self.stream([tool, "--force", "--size", str(want), device.path],
                        "Resizing the filesystem")
            info["note"] = ("Windows will check this drive the next time "
                            "it starts. Let it finish.")
        elif fstype == "btrfs":
            self.stream([self.need("btrfs"), "filesystem", "resize",
                         "max" if size is None else str(size), point],
                        "Resizing the filesystem")
        elif fstype == "xfs":
            self.stream([self.need("xfs_growfs"), point],
                        "Growing the filesystem")
        elif fstype == "f2fs":
            self.stream([self.need("resize.f2fs"), device.path],
                        "Growing the filesystem")
        elif fstype == "swap":
            found = self.probe(device)
            argv = [self.need("mkswap")]
            if found.get("UUID"):
                argv += ["-U", found["UUID"]]
            if found.get("LABEL"):
                argv += ["-L", found["LABEL"]]
            self.tool(argv + [device.path], "Recreating the swap area")

    def resize_rules(self, device, fstype, grow):
        """How the filesystem is resized in this direction ("online",
        "offline", "either"), "" when there is no filesystem to resize.
        Refuses, with the reason, what cannot be resized."""
        if not fstype:
            return ""
        if fstype in NO_RESIZE:
            raise Refusal(NO_RESIZE[fstype])
        spec = RESIZE.get(fstype)
        if spec is None:
            raise Refusal("A %s volume cannot be resized from here."
                          % fstype)
        how = spec["grow" if grow else "shrink"]
        if how is None:
            raise Refusal(NO_SHRINK.get(
                fstype, "A %s filesystem cannot be made smaller." % fstype))
        self.need(spec["tool"])
        return how

    # ---- partitions: the operations ------------------------------------------------

    def op_table_new(self, request):
        """A new, empty partition table. Everything on the disk is lost."""
        table = request.get("table")
        if table not in ("gpt", "dos"):
            raise Refusal("Unknown partition table type.")
        disk = self.target(request)
        if disk.is_partition:
            raise Refusal("A partition table goes on a whole drive.")
        self.refuse_stacked(disk)
        if table == "dos" and disk.size > 2 ** 32 * disk.logical_sector:
            raise Refusal("An MBR partition table cannot describe a drive "
                          "this large; use GPT.")
        sfdisk = self.need("sfdisk")
        self.need("wipefs")
        self.need("blkid")
        mounted = bool(self.mounts_of(disk))
        if mounted:
            self.need("umount")
        names = (["unmount"] if mounted else []) + ["table", "verify"]

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        saved = None
        with self.locked():
            if mounted:
                begin("unmount", "Unmounting %s" % disk.path, True)
                self.unmount(disk)
            self.check_cancel()
            self.assert_free(disk)
            if self.probe_table(disk) in ("gpt", "dos"):
                saved = self.save_table(disk, self.layout(disk))
            self.destroying = True
            begin("table", "Writing a new %s partition table"
                  % ("GPT" if table == "gpt" else "MBR"))
            for name in disk.partitions():
                try:
                    self.wipe_signatures(Device(name))
                except Refusal:
                    pass
            self.wipe_signatures(disk)
            self.tool([sfdisk, "--quiet", "--wipe", "always", disk.path],
                      "Writing the partition table",
                      stdin="label: %s\n" % table, timeout=300)
            self.reread_table(disk)
            begin("verify", "Checking the result")
            found = self.probe(disk)
            if found.get("PTTYPE") != table or found.get("TYPE") \
                    or disk.partitions():
                raise Refusal("The new partition table does not read back "
                              "as it should.")
        return {"device": disk.path, "table": table, "saved": saved}

    def op_part_create(self, request):
        """A new partition in unallocated space, with a filesystem on it."""
        fstype = request.get("fstype") or ""
        if fstype and fstype not in FILESYSTEMS:
            raise Refusal("Unknown filesystem.")
        spec = FILESYSTEMS.get(fstype)
        label = check_label(fstype, request.get("label", "")) if fstype \
            else ""
        start, size = request.get("start"), request.get("size")
        if not isinstance(start, int) or not isinstance(size, int) \
                or isinstance(start, bool) or isinstance(size, bool):
            raise Refusal("The request does not say where the partition "
                          "goes.")
        disk = self.target(request, system=True)
        if disk.is_partition:
            raise Refusal("A partition is made on a drive, not inside "
                          "another partition.")
        layout = self.layout(disk)
        if layout["label"] not in ("gpt", "dos"):
            raise Refusal("%s has no partition table. Create one first."
                          % disk.path)

        # Onto MiB boundaries, inside one unallocated stretch.
        start = -(-start // MIB) * MIB
        size = (size // MIB) * MIB
        gap = next((g for g in self.gaps(layout)
                    if g[0] <= start and start + size <= g[1]), None)
        if gap is None or size < MIB:
            raise Refusal("That is not unallocated space on %s. Nothing "
                          "was changed; look at the drive again."
                          % disk.path)
        if spec is not None:
            if size < spec["min"]:
                raise Refusal("That is too small for this filesystem (it "
                              "needs at least %s)." % _megabytes(spec["min"]))
            if spec["max"] is not None and size > spec["max"]:
                raise Refusal("That is too large for this filesystem.")
            cluster = check_cluster(fstype, size, disk.logical_sector,
                                    request.get("cluster"))
        primaries = [e for e in layout["entries"]
                     if not self._is_logical(layout, e)]
        if layout["label"] == "dos" and not gap[2] and len(primaries) >= 4:
            raise Refusal(
                "An MBR partition table holds four partitions and this one "
                "has four. Delete one first, or convert the drive to GPT "
                "(which erases it).")
        owner = None
        if request.get("owner") and spec is not None and spec["native"]:
            owner = invoking_user()
        if spec is not None:
            self.need(*spec["mkfs"])
            if owner and fstype in ("btrfs", "xfs"):
                self.need("mount")
        self.need("blkid")
        self.need("wipefs")
        if spec is None:
            code = GPT_LINUX if layout["label"] == "gpt" else "83"
        else:
            code = spec["gpt"] if layout["label"] == "gpt" else spec["mbr"]

        names = ["table"] + (["mkfs", "verify"] if spec else [])

        def begin(key, text):
            self.step(request, names.index(key) + 1, len(names), key, text)

        unit = layout["unit"]
        with self.locked():
            saved = self.save_table(disk, layout)
            begin("table", "Adding the partition to the table")
            self.write_table(
                disk, ["--append"],
                "start=%d, size=%d, type=%s\n" % (start // unit,
                                                   size // unit, code),
                "Adding the partition", saved)
            after = self.commit_table(disk)
            before = {entry["number"] for entry in layout["entries"]}
            made = [e for e in after["entries"]
                    if e["number"] not in before and e["start"] == start]
            if len(made) != 1:
                raise Refusal("The partition was added, but it could not be "
                              "found again in the table.")
            volume = self.wait_for_partition(disk, made[0]["number"])
            # Whatever an earlier partition left at this spot.
            self.wipe_signatures(volume)
            found = {}
            if spec is not None:
                begin("mkfs", "Creating the filesystem")
                self.make_filesystem(
                    self.mkfs_argv(fstype, volume, label, None, owner,
                                   cluster))
                if owner and fstype in ("btrfs", "xfs"):
                    self.give_to_owner(fstype, volume, owner)
                self.settle()
                begin("verify", "Checking the result")
                found = self.verify_filesystem(volume, fstype, label)
                self.verify_cluster(volume, fstype, cluster)
        return {"device": volume.path, "fstype": fstype,
                "label": found.get("LABEL", ""), "size": volume.size,
                "saved": saved}

    def op_part_delete(self, request):
        """Remove a partition from the table. Its contents are not
        overwritten, only no longer reachable."""
        device = self.target(request)
        if not device.is_partition:
            raise Refusal("That is not a partition.")
        self.refuse_stacked(device)
        disk = Device(device.disk)
        layout = self.layout(disk)
        entry = self.partition_entry(layout, device)
        if entry["extended"] and any(
                not e["extended"] and entry["start"] <= e["start"]
                < entry["start"] + entry["size"] for e in layout["entries"]):
            raise Refusal("This extended partition still holds logical "
                          "partitions. Delete those first.")
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")
        names = (["unmount"] if mounted else []) + ["table"]

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        with self.locked():
            if mounted:
                begin("unmount", "Unmounting %s" % device.path, True)
                self.unmount(device)
            self.check_cancel()
            self.assert_free(device)
            saved = self.save_table(disk, layout)
            self.destroying = True
            begin("table", "Removing the partition from the table")
            self._delete_entry(disk, device.number, saved)
            after = self.commit_table(disk, removed=device.number)
            if any(e["start"] == entry["start"] and not e["extended"]
                   for e in after["entries"]) and not entry["extended"]:
                raise Refusal("The partition is still in the table.")
        return {"device": device.path, "disk": disk.path, "saved": saved}

    def _delete_entry(self, disk, number, saved):
        sfdisk = self.need("sfdisk")
        try:
            self.tool([sfdisk, "--no-reread", "--quiet", "--delete",
                       disk.path, str(number)], "Removing the partition",
                      timeout=300)
        except Refusal as exc:
            raise Refusal("%s\n\nThe partition table was not changed. (Its "
                          "previous state is also saved in %s.)"
                          % (exc, saved))

    def op_part_limits(self, request):
        """What a partition could be resized or moved to. Changes nothing."""
        device = self.target(request, system=True, writable=False)
        if not device.is_partition:
            raise Refusal("That is not a partition.")
        disk = Device(device.disk)
        layout = self.layout(disk)
        entry = self.partition_entry(layout, device)
        low, high = self.room_around(layout, entry)
        fstype = self.probe(device).get("TYPE", "")
        result = {"device": device.path, "fstype": fstype,
                  "start": entry["start"], "size": entry["size"],
                  "lowest_start": low, "highest_end": high,
                  "largest": ((high - entry["start"]) // MIB) * MIB,
                  "smallest": None, "grow": "", "shrink": ""}
        for key, grow in (("grow", True), ("shrink", False)):
            try:
                self.resize_rules(device, fstype, grow)
            except Refusal as exc:
                result[key] = str(exc)
        if not result["shrink"]:
            minimum = MIB
            if fstype == "btrfs":
                try:
                    with self.mounted_somewhere(device, fstype) as point:
                        minimum = self.fs_minimum(device, fstype, point)
                except Refusal:
                    minimum = None
            elif fstype:
                minimum = self.fs_minimum(device, fstype)
            if minimum is None:
                result["shrink"] = ("The smallest size this filesystem "
                                    "can have could not be worked out.")
            else:
                result["smallest"] = min(
                    self.with_margin(minimum) if fstype not in ("", "swap")
                    else MIB, entry["size"])
        if fstype == "ntfs":
            problem = self.ntfs_problem(device)
            if problem:
                result["grow"] = result["shrink"] = problem
        return result

    def set_partition_size(self, disk, number, start, size, unit, saved):
        """Give partition `number` a new size in the table, keeping its
        start, and make sure the running system took it."""
        self.write_table(disk, ["-N", str(number)], ",%d\n" % (size // unit),
                         "Changing the partition's size", saved)
        after = self.commit_table(disk)
        now = [e for e in after["entries"] if e["number"] == number]
        if not now or now[0]["size"] != size or now[0]["start"] != start:
            raise Refusal("The partition's new size does not read back as "
                          "it should.")

    def grow_last(self, disk):
        """After a whole drive was copied onto a larger one: the last
        partition takes the free space behind it, and its filesystem with
        it. Refuses, with the reason, whatever it will not do - the copy
        before it is complete and checked either way, and a refusal at any
        point leaves a filesystem no larger than its partition, which loses
        nothing."""
        layout = self.layout(disk)
        entries = [e for e in layout["entries"] if not e["extended"]]
        if not entries:
            raise Refusal("The copy has no partition to enlarge.")
        entry = max(entries, key=lambda e: e["start"])
        if self._is_logical(layout, entry):
            raise Refusal("The last partition is a logical one, inside an "
                          "extended partition; enlarging that is not "
                          "offered.")
        if entry["type"].lower() in NO_GROW_TYPES:
            raise Refusal("The last partition is a system partition (EFI, "
                          "Microsoft reserved or Windows recovery), which "
                          "is left at its size.")
        _low, high = self.room_around(layout, entry)
        size = ((high - entry["start"]) // MIB) * MIB
        if size - entry["size"] < MIB:
            if layout["label"] == "gpt" and layout["end"] < disk.size - (
                    GPT_BACKUP_SECTORS * layout["unit"] + MIB):
                raise Refusal("The partition table's second copy could not "
                              "be moved to the end of the drive, so the "
                              "free space cannot be used yet.")
            raise Refusal("There is no free space after the last "
                          "partition.")
        device = Device(os.path.basename(entry["node"]))
        found = self.probe(device)
        fstype = found.get("TYPE", "")
        how = self.resize_rules(device, fstype, True)
        self.refuse_unsafe_windows(device, fstype)
        if fstype == "btrfs" and found.get("UUID") and os.path.isdir(
                os.path.join(SYS_BTRFS, found["UUID"])):
            raise Refusal("A Btrfs filesystem with the same ID - the "
                          "original - is mounted, and the system could "
                          "enlarge that one instead. Enlarge the copy "
                          "later, with the original unmounted or "
                          "disconnected.")
        offline = how in ("offline", "either")
        self.need("blkid")
        if not offline:
            self.need("mount")
            self.need("umount")
        self.assert_free(device)
        if offline and fstype not in ("", "swap"):
            self.checked_clean(device, fstype, "has errors, so it is not "
                               "enlarged")
        saved = self.save_table(disk, layout)
        self.set_partition_size(disk, device.number, entry["start"], size,
                                layout["unit"], saved)
        device = Device(device.name)
        info = {}
        if fstype:
            # The copy and the original carry the same filesystem ID: XFS
            # refuses to mount a second one unless told it may.
            with contextlib.ExitStack() as stack:
                point = None if offline else stack.enter_context(
                    self.mounted_somewhere(
                        device, fstype,
                        ("nouuid",) if fstype == "xfs" else ()))
                self.resize_filesystem(device, fstype, None, point, info)
        self.settle()
        if offline and fstype not in ("", "swap"):
            self.checked_clean(device, fstype, "does not pass its check "
                               "after being enlarged")
        if Device(device.name).size != size:
            raise Refusal(NOT_SEEN)
        result = {"device": device.path, "old": entry["size"], "new": size,
                  "fstype": fstype, "saved": saved}
        if info.get("note"):
            result["note"] = info["note"]
        return result

    def op_part_resize(self, request):
        """Change where a partition ends, and its filesystem with it.

        Growing: the partition first, then the filesystem into it.
        Shrinking: the filesystem first, then the partition down to it. A
        step failing in either order leaves a filesystem that is smaller
        than its partition, which loses nothing.
        """
        size = request.get("size")
        if not isinstance(size, int) or isinstance(size, bool):
            raise Refusal("The request does not say the new size.")
        device = self.target(request)
        if not device.is_partition:
            raise Refusal("That is not a partition.")
        self.refuse_stacked(device)
        disk = Device(device.disk)
        layout = self.layout(disk)
        entry = self.partition_entry(layout, device)
        if entry["extended"]:
            raise Refusal("An extended partition is resized by resizing "
                          "what is inside it; that is not offered here.")
        size = (size // MIB) * MIB
        if size < MIB:
            raise Refusal("That is too small to be a partition.")
        if size == entry["size"]:
            raise Refusal("That is the size it already has.")
        grow = size > entry["size"]
        _low, high = self.room_around(layout, entry)
        if entry["start"] + size > high:
            raise Refusal(
                "There is only room to grow to %s: something else starts "
                "after that." % _megabytes(high - entry["start"]))

        fstype = self.probe(device).get("TYPE", "")
        how = self.resize_rules(device, fstype, grow)
        self.refuse_unsafe_windows(device, fstype)
        mounted = bool(self.mounts_of(device))
        offline = how == "offline" or (how == "either" and not mounted)
        online = how == "online" or (how == "either" and mounted)
        if offline and mounted:
            self.need("umount")
        if online and not mounted:
            self.need("mount")
            self.need("umount")
        self.need("blkid")

        names = (["unmount"] if offline and mounted else [])
        names += ["check"] if offline and fstype not in ("", "swap") else []
        names += ["table", "filesystem"] if grow else ["filesystem", "table"]
        if not fstype:
            names.remove("filesystem")
        names += ["verify"]

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        info = {}
        unit = layout["unit"]

        def set_partition():
            begin("table", "Changing the partition's size in the table")
            self.set_partition_size(disk, device.number, entry["start"],
                                    size, unit, saved)

        with self.locked(), contextlib.ExitStack() as stack:
            if offline and mounted:
                begin("unmount", "Unmounting %s" % device.path, True)
                self.unmount(device)
            self.check_cancel()
            if offline:
                self.assert_free(device)
            point = None
            if online and fstype:
                point = stack.enter_context(
                    self.mounted_somewhere(device, fstype))
            if "check" in names:
                begin("check", "Checking the filesystem before changing it",
                      True)
                self.checked_clean(device, fstype,
                                   "has errors, so it is not resized before "
                                   "they are repaired")
            if not grow and fstype not in ("", "swap"):
                minimum = self.with_margin(
                    self.fs_minimum(device, fstype, point))
                if minimum is None:
                    raise Refusal("The smallest size this filesystem can "
                                  "have could not be worked out, so it is "
                                  "not made smaller.")
                if size < minimum:
                    raise Refusal(
                        "This volume cannot be made smaller than %s: that "
                        "is what its contents need, with a little room to "
                        "work in." % _megabytes(minimum))
            saved = self.save_table(disk, layout)
            self.cancellable = False
            self.destroying = True
            if grow:
                set_partition()
                device = Device(device.name)
                if fstype:
                    begin("filesystem", "Growing the filesystem into the "
                          "new space")
                    self.resize_filesystem(device, fstype, None, point, info)
            else:
                if fstype:
                    begin("filesystem", "Shrinking the filesystem")
                    self.resize_filesystem(device, fstype, size, point, info)
                set_partition()
                device = Device(device.name)
            self.settle()
            begin("verify", "Checking the result")
            if offline and fstype not in ("", "swap"):
                self.checked_clean(device, fstype,
                                   "does not pass its check after the "
                                   "resize")
            if device.size != size:
                raise Refusal(NOT_SEEN)
        result = {"device": device.path, "size": size, "fstype": fstype,
                  "was_mounted": bool(offline and mounted), "saved": saved}
        result.update(info)
        return result

    # ---- partitions: finding lost ones -----------------------------------------------

    def probe_at(self, device, start, size):
        """What filesystem, if any, begins at a place on a disk."""
        blkid = self.need("blkid")
        found = {}
        for tag in ("TYPE", "LABEL", "UUID"):
            try:
                code, out, _err = self.run_tool(
                    [blkid, "--probe", "--offset", str(start), "--size",
                     str(size), "--output", "value", "--match-tag", tag,
                     device.path], None, 60)
            except (OSError, subprocess.SubprocessError):
                return {}
            if code == 0 and out.strip():
                found[tag] = out.rstrip("\n")
        return found

    @staticmethod
    def _testdisk_candidates(text, unit):
        """(start, size) in bytes for every partition TestDisk's log
        mentions, in the order found, each once."""
        seen, found = set(), []
        for line in text.splitlines():
            match = re.match(r"^\s+(?:\d+\s+[PDL*E]\s+)?\S.*?\s+(\d+)\s+"
                             r"(\d+)\s+(\d+)(?:\s+\[.*\])?\s*$", line)
            if not match:
                continue
            first, last, count = (int(g) for g in match.groups())
            if count <= 0 or last - first + 1 != count:
                continue
            key = (first * unit, count * unit)
            if key not in seen:
                seen.add(key)
                found.append(key)
        return found

    def op_partition_search(self, request):
        """Look for partitions whose entries are gone from the table.

        TestDisk searches the disk for the beginnings of filesystems; what
        it reports is then checked here, place by place, and only what
        really starts a filesystem and does not collide with a partition
        that exists is offered. Reads only.
        """
        disk = self.target(request, system=True, writable=False)
        if disk.is_partition:
            raise Refusal("Lost partitions are looked for on a whole drive.")
        testdisk = self.need("testdisk")
        table = self.probe_table(disk)
        entries = []
        usable = (MIB, disk.size)
        if table in ("gpt", "dos"):
            layout = self.layout(disk)
            entries = [e for e in layout["entries"] if not e["extended"]]
        work = tempfile.mkdtemp(prefix="ksyssupervisor-", dir=RUN_DIR)
        try:
            with self.locked():
                self.step(request, 1, 2, "search",
                          "Searching %s for the start of filesystems"
                          % disk.path, True)
                self.stream(
                    [testdisk, "/log", "/cmd", disk.path, "%s,analyze,search"
                     % ("partition_i386" if table == "dos"
                        else "partition_gpt")],
                    "Searching for partitions", ok=None, keep=5, cwd=work,
                    env=PHOTOREC_ENV,
                    stopped_text="Stopped. Nothing was changed.")
                try:
                    with open(os.path.join(work, "testdisk.log"),
                              errors="replace") as handle:
                        text = handle.read()
                except OSError:
                    raise Refusal("The search did not leave a result.")
                self.step(request, 2, 2, "confirm",
                          "Checking what was found")
                found = []
                taken = [(e["start"], e["start"] + e["size"])
                         for e in entries]
                for start, size in sorted(self._testdisk_candidates(
                        text, disk.logical_sector)):
                    if start < usable[0] // 2 or start + size > disk.size:
                        continue
                    if any(start < stop and begin < start + size
                           for begin, stop in taken):
                        continue
                    info = self.probe_at(disk, start, size)
                    if not info.get("TYPE"):
                        continue
                    taken.append((start, start + size))
                    found.append({"start": start, "size": size,
                                  "fstype": info["TYPE"],
                                  "label": info.get("LABEL", "")})
        finally:
            shutil.rmtree(work, ignore_errors=True)
        return {"device": disk.path, "table": table, "found": found}

    def op_partition_restore(self, request):
        """Put a lost partition's entry back into the table.

        Only an entry is written, at exactly the place given, and only
        after the filesystem has been seen to begin there. Nothing inside
        the partition is touched.
        """
        start, size = request.get("start"), request.get("size")
        if not isinstance(start, int) or not isinstance(size, int) \
                or isinstance(start, bool) or isinstance(size, bool):
            raise Refusal("The request does not say which partition.")
        disk = self.target(request, system=True)
        if disk.is_partition:
            raise Refusal("A partition is restored on a drive.")
        unit = disk.logical_sector
        if start % unit or size % unit or size <= 0 or start < unit \
                or start + size > disk.size:
            raise Refusal("That is not a place on %s." % disk.path)
        info = self.probe_at(disk, start, size)
        fstype = info.get("TYPE", "")
        if not fstype:
            raise Refusal("No filesystem begins there any more. Nothing "
                          "was changed.")
        table = self.probe_table(disk)
        saved = None
        with self.locked():
            self.step(request, 1, 2, "table",
                      "Putting the partition back into the table")
            spec = FILESYSTEMS.get(fstype)
            if table in ("gpt", "dos"):
                layout = self.layout(disk)
                if any(start < e["start"] + e["size"]
                       and e["start"] < start + size
                       for e in layout["entries"] if not e["extended"]):
                    raise Refusal("A partition is already there.")
                if start < layout["first"] // 2 or start + size > \
                        layout["end"]:
                    raise Refusal("That place is outside what this "
                                  "partition table can describe.")
                saved = self.save_table(disk, layout)
                code = (spec["gpt"] if table == "gpt" else spec["mbr"]) \
                    if spec else (GPT_LINUX if table == "gpt" else "83")
                self.write_table(
                    disk, ["--wipe", "never", "--wipe-partitions", "never",
                           "--append"],
                    "start=%d, size=%d, type=%s\n" % (start // unit,
                                                       size // unit, code),
                    "Restoring the partition", saved or "nowhere")
            else:
                # No table at all. A GPT keeps its second copy in the last
                # sectors of the disk, which must not be where the
                # partition's own last sectors are.
                table = "gpt"
                if start + size > disk.size - 34 * unit \
                        or start < 34 * unit:
                    table = "dos"
                    if disk.size > 2 ** 32 * unit:
                        raise Refusal(
                            "This partition reaches the very end of a "
                            "drive too large for the kind of table that "
                            "would leave it room. It cannot be restored "
                            "from here.")
                code = (spec["gpt"] if table == "gpt" else spec["mbr"]) \
                    if spec else (GPT_LINUX if table == "gpt" else "83")
                self.write_table(
                    disk, ["--wipe", "never", "--wipe-partitions", "never"],
                    "label: %s\nstart=%d, size=%d, type=%s\n"
                    % (table, start // unit, size // unit, code),
                    "Writing a partition table", "nowhere")
            after = self.commit_table(disk)
            made = [e for e in after["entries"] if e["start"] == start
                    and e["size"] == size]
            if len(made) != 1:
                raise Refusal("The partition was written, but it could not "
                              "be found again in the table.")
            self.step(request, 2, 2, "verify", "Checking the result")
            volume = self.wait_for_partition(disk, made[0]["number"])
            self.settle()
            if self.probe(volume).get("TYPE") != fstype:
                raise Refusal("The partition is back, but its filesystem "
                              "does not read as %s." % fstype)
        return {"device": volume.path, "fstype": fstype,
                "label": info.get("LABEL", ""), "table": table,
                "saved": saved}

    # ---- partitions: moving one ------------------------------------------------------

    @staticmethod
    def _journal_path(disk, number):
        return os.path.join(STATE_DIR, "moves",
                            "%s-%d.json" % (disk.name, number))

    @staticmethod
    def _write_journal(fd, record):
        data = json.dumps(record).encode("ascii")
        os.pwrite(fd, data + b" " * (4096 - len(data)), 0)
        os.fsync(fd)

    def op_part_move(self, request):
        """Move a partition to a new place on its disk, contents and all.

        Every block is copied to where it belongs and the table then points
        at the new place. Where old and new place overlap, the copying runs
        in the direction that never overwrites a block not yet copied, in
        pieces no larger than the distance moved, and each finished piece
        is recorded on disk first - so a move cut short by a power failure
        can be taken up again exactly where it stopped.
        """
        start = request.get("start")
        if not isinstance(start, int) or isinstance(start, bool):
            raise Refusal("The request does not say where to move to.")
        device = self.target(request)
        if not device.is_partition:
            raise Refusal("That is not a partition.")
        self.refuse_stacked(device)
        disk = Device(device.disk)
        layout = self.layout(disk)
        entry = self.partition_entry(layout, device)
        if entry["extended"]:
            raise Refusal("An extended partition cannot be moved.")
        start = -(-start // MIB) * MIB
        if start == entry["start"]:
            raise Refusal("That is where it already is.")
        low, high = self.room_around(layout, entry)
        if start < low or start + entry["size"] > high:
            raise Refusal("There is no room to move it there: another "
                          "partition is in the way.")
        fstype = self.probe(device).get("TYPE", "")
        self.refuse_unsafe_windows(device, fstype)
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")
        self.need("blkid")
        path = self._journal_path(disk, device.number)
        if os.path.exists(path):
            raise Refusal(
                "An earlier move of this partition was interrupted. Finish "
                "that one first (Partitions > Finish Interrupted Move).")

        names = (["unmount"] if mounted else [])
        names += ["check"] if fstype not in ("", "swap") else []
        names += ["move", "table", "verify"]

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      cancellable)

        with self.locked():
            if mounted:
                begin("unmount", "Unmounting %s" % device.path, True)
                self.unmount(device)
            self.check_cancel()
            self.assert_free(device)
            checked = False
            if "check" in names:
                begin("check", "Checking the filesystem before moving it",
                      True)
                checked = self.checked_clean(
                    device, fstype, "has errors, so it is not moved before "
                                    "they are repaired")
            self.check_cancel()
            saved = self.save_table(disk, layout)
            record = {"version": 1, "disk": disk.name,
                      "disk_size": disk.size, "number": device.number,
                      "old_start": entry["start"], "new_start": start,
                      "size": entry["size"], "unit": layout["unit"],
                      "fstype": fstype, "saved": saved, "done": 0,
                      "stage": "copy"}
            result = self._carry_out_move(request, disk, device, record,
                                          begin, fresh=True)
            begin("verify", "Checking the result")
            moved = Device(device.name)
            if checked:
                self.checked_clean(moved, fstype,
                                   "does not pass its check after the move")
        result.update(was_mounted=mounted, saved=saved)
        return result

    def _carry_out_move(self, request, disk, device, record, begin, fresh):
        """Copy the blocks and repoint the table, from wherever the record
        says the work has got to."""
        path = self._journal_path(disk, record["number"])
        old, new, size = (record["old_start"], record["new_start"],
                          record["size"])
        shift = new - old
        overlap = abs(shift) < size
        piece = min(CHUNK, abs(shift)) if overlap else CHUNK
        pieces = -(-size // piece)
        try:
            os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
            journal = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
        except OSError as exc:
            raise Refusal("The record of the move could not be created "
                          "(%s), so nothing was moved."
                          % (exc.strerror or exc))
        self.cancellable = False
        self.destroying = True
        try:
            if fresh:
                self._write_journal(journal, record)
                # The folder too: the record has to be findable after a
                # power failure, not only written.
                folder = os.open(os.path.dirname(path), os.O_RDONLY)
                try:
                    os.fsync(folder)
                finally:
                    os.close(folder)
            if record["stage"] == "copy":
                begin("move", "Moving the contents (do not switch off)")
                fd = os.open(disk.path, os.O_RDWR)
                try:
                    last = 0.0
                    unsynced = 0
                    for index in range(record["done"], pieces):
                        # Towards lower addresses, front first; towards
                        # higher ones, back first: either way no piece
                        # lands on one that is still to be read.
                        number = index if shift < 0 else pieces - 1 - index
                        offset = number * piece
                        count = min(piece, size - offset)
                        data = self._read_exact(fd, old + offset, count)
                        if len(data) != count:
                            raise OSError(errno.EIO, "short read")
                        view = memoryview(data)
                        place = new + offset
                        while view:
                            wrote = os.pwrite(fd, view, place)
                            view, place = view[wrote:], place + wrote
                        unsynced += count
                        if overlap or unsynced >= SYNC_EVERY \
                                or index == pieces - 1:
                            os.fsync(fd)
                            record["done"] = index + 1
                            self._write_journal(journal, record)
                            unsynced = 0
                        now = time.monotonic()
                        if now - last >= PROGRESS_INTERVAL:
                            self.progress(request, (index + 1) * piece
                                          if index + 1 < pieces else size,
                                          size)
                            last = now
                    os.fsync(fd)
                finally:
                    os.close(fd)
                self.progress(request, size, size)
                record["stage"] = "table"
                record["done"] = pieces
                self._write_journal(journal, record)

            begin("table", "Pointing the partition table at the new place")
            unit = record["unit"]
            layout = self.layout(disk)
            now = [e for e in layout["entries"]
                   if e["number"] == record["number"]]
            if not now:
                raise Refusal("The partition is no longer in the table.")
            if now[0]["start"] != new:
                self.write_table(
                    disk, ["-N", str(record["number"])],
                    "%d,%d\n" % (new // unit, size // unit),
                    "Updating the partition's place", record.get("saved"))
            after = self.commit_table(disk)
            placed = [e for e in after["entries"]
                      if e["number"] == record["number"]]
            if not placed or placed[0]["start"] != new \
                    or placed[0]["size"] != size:
                raise Refusal("The partition's new place does not read "
                              "back as it should.")
            if record.get("fstype") in ("ntfs", "vfat"):
                self._set_hidden_sectors(disk, old, new, unit)
            self.settle()
        except OSError as exc:
            raise Refusal(
                "The move stopped: %s. The partition is partly moved and "
                "must not be used. What was done is recorded; once the "
                "cause is dealt with, finish it with Partitions > Finish "
                "Interrupted Move." % (exc.strerror or exc))
        finally:
            os.close(journal)
        try:
            os.unlink(path)
        except OSError:
            pass
        return {"device": os.path.join(DEV_ROOT, device.name)
                if device is not None else "", "disk": disk.path,
                "start": new, "size": size}

    @staticmethod
    def _set_hidden_sectors(disk, old, new, unit):
        """A Windows filesystem records, in its boot sector, how many
        sectors come before it on the disk, and Windows' boot code goes by
        that number. Kept true after a move.

        NTFS always. FAT only where the number was true before the move:
        some tools leave it at zero, and that is then left as it was. The
        filesystem's spare copy of the boot sector is changed along with
        it wherever it was a copy to begin with, so the two still agree.
        """
        try:
            fd = os.open(disk.path, os.O_RDWR)
        except OSError:
            return
        try:
            boot = os.pread(fd, 512, new)
            if len(boot) != 512 or boot[510:512] != b"\x55\xaa":
                return
            sector = int.from_bytes(boot[0x0B:0x0D], "little")
            hidden = int.from_bytes(boot[0x1C:0x20], "little")
            if sector not in (512, 1024, 2048, 4096):
                return
            if boot[3:11] == b"NTFS    ":
                spare = new + int.from_bytes(boot[0x28:0x30],
                                             "little") * sector
            elif boot[0x52:0x5A] == b"FAT32   " and hidden == old // unit:
                spare = new + int.from_bytes(boot[0x32:0x34],
                                             "little") * sector
            elif boot[0x36:0x3B] == b"FAT16" and hidden == old // unit:
                spare = None
            else:
                return
            value = (new // unit).to_bytes(4, "little")
            if spare is not None and spare != new \
                    and os.pread(fd, 512, spare) == boot:
                os.pwrite(fd, value, spare + 0x1C)
            os.pwrite(fd, value, new + 0x1C)
            os.fsync(fd)
        except OSError:
            pass
        finally:
            os.close(fd)

    def pending_moves(self):
        """Records of moves that did not finish, readable ones only."""
        folder = os.path.join(STATE_DIR, "moves")
        found = []
        try:
            names = sorted(os.listdir(folder))
        except OSError:
            return found
        for name in names:
            try:
                with open(os.path.join(folder, name)) as handle:
                    record = json.loads(handle.read(4096))
                if record.get("version") == 1:
                    found.append(record)
            except (OSError, ValueError):
                continue
        return found

    def op_move_resume(self, request):
        """Finish a partition move that was cut short."""
        name = request.get("disk")
        number = request.get("number")
        record = next((r for r in self.pending_moves()
                       if r.get("disk") == name
                       and r.get("number") == number), None)
        if record is None:
            raise Refusal("There is no interrupted move of that partition "
                          "on record.")
        disk = Device(record["disk"])
        if not self.is_block_device(disk) or disk.size != record["disk_size"]:
            raise Refusal(
                "%s is not the drive the interrupted move was on (a "
                "different drive has that name now). Connect the right "
                "drive and try again." % disk.path)
        layout = self.layout(disk)
        entry = [e for e in layout["entries"]
                 if e["number"] == record["number"]]
        if not entry or entry[0]["size"] != record["size"] \
                or entry[0]["start"] not in (record["old_start"],
                                             record["new_start"]):
            raise Refusal(
                "The partition table of %s has changed since the move was "
                "interrupted, so it cannot be taken up again safely."
                % disk.path)
        for other in disk.partitions():
            part = Device(other)
            if part.number == record["number"] and self.mounts_of(part):
                raise Refusal("%s is mounted. A partly moved partition "
                              "must not be used; unmount it." % part.path)
        names = (["move"] if record["stage"] == "copy" else []) + ["table"]

        def begin(key, text, cancellable=False):
            self.step(request, names.index(key) + 1, len(names), key, text)

        device = next((Device(n) for n in disk.partitions()
                       if Device(n).number == record["number"]), None)
        with self.locked():
            result = self._carry_out_move(request, disk, device, record,
                                          begin, fresh=False)
        result["resumed"] = True
        return result

    # ---- a failing drive, and images opened as drives ------------------------------

    @staticmethod
    def _map_totals(path):
        """(bytes rescued, bytes not read) from a ddrescue map file."""
        rescued = missing = 0
        try:
            with open(path) as handle:
                rows = [line.split() for line in handle
                        if line.strip() and not line.startswith("#")]
        except OSError:
            return 0, 0
        for row in rows[1:]:             # the first is the current position
            if len(row) < 3:
                continue
            try:
                size = int(row[1], 16)
            except ValueError:
                continue
            if row[2] == "+":
                rescued += size
            else:
                missing += size
        return rescued, missing

    def op_rescue_image(self, request):
        """Copy a failing drive into an image file with ddrescue.

        Everything that reads easily first; then the areas that did not, a
        second and third time. What still cannot be read is left as zeros
        and recorded in a map file beside the image, with which the same
        request, sent again, carries on instead of starting over.
        """
        path = self.image_path(request)
        resume = bool(request.get("resume"))
        source = self.target(request, writable=False)
        self.refuse_stacked(source)
        self.refuse_same_drive(path, source)
        ddrescue = self.need("ddrescue")
        mounted = bool(self.mounts_of(source))
        if mounted:
            self.need("umount")
        mapfile = path + ".map"
        owner = invoking_user()
        with self.as_user():
            try:
                room = os.statvfs(os.path.dirname(path))
            except OSError as exc:
                raise Refusal("%s: %s" % (os.path.dirname(path),
                                          exc.strerror or exc))
            have = os.path.getsize(path) if os.path.exists(path) else 0
            if room.f_bavail * room.f_frsize < source.size - have:
                raise Refusal(
                    "There is not enough room for the image: it needs %s "
                    "and %s is free there."
                    % (_megabytes(source.size),
                       _megabytes(room.f_bavail * room.f_frsize)))
            if resume:
                if not os.path.isfile(path) or not os.path.isfile(mapfile):
                    raise Refusal("There is no unfinished image at %s to "
                                  "carry on with." % path)
            else:
                try:
                    os.close(os.open(path, os.O_WRONLY | os.O_CREAT
                                     | os.O_EXCL | os.O_NOFOLLOW, 0o644))
                except FileExistsError:
                    raise Refusal("%s already exists." % path)
                except OSError as exc:
                    raise Refusal("Cannot create %s: %s"
                                  % (path, exc.strerror or exc))
        names = (["unmount"] if mounted else []) + ["copy", "retry"]

        def begin(key, text):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      True)

        def follow(line):
            seen = re.search(r"pct rescued:\s+([0-9.]+)%", line)
            if seen:
                share = float(seen.group(1)) / 100.0
                self.progress(request, int(source.size * share), source.size)
            bad = re.search(r"read errors:\s+(\d+)", line)
            if bad and int(bad.group(1)):
                self.note(request, "%s read errors so far" % bad.group(1))

        stopped = ("Stopped. What was copied is kept: choose the same file "
                   "again to carry on from there.")
        try:
            with self.locked():
                if mounted:
                    begin("unmount", "Unmounting %s" % source.path)
                    self.unmount(source)
                begin("copy", "Copying everything that reads without "
                      "trouble")
                self.stream([ddrescue, "--idirect", "--no-scrape",
                             source.path, path, mapfile],
                            "Copying the drive", on_line=follow, ok=(0,),
                            keep=12, stopped_text=stopped)
                begin("retry", "Going back to the areas that did not read")
                self.stream([ddrescue, "--idirect", "--retry-passes=2",
                             source.path, path, mapfile],
                            "Reading the difficult areas", on_line=follow,
                            ok=(0,), keep=12, stopped_text=stopped)
        finally:
            for name in (path, mapfile):
                try:
                    if owner is not None:
                        os.chown(name, owner[0], owner[1])
                except OSError:
                    pass
        rescued, missing = self._map_totals(mapfile)
        return {"source": source.path, "path": path, "map": mapfile,
                "size": source.size, "rescued": rescued, "missing": missing,
                "was_mounted": mounted}

    def op_image_attach(self, request):
        """Present an image file as a read-only drive, partitions and all,
        so that everything that works on a drive works on the image."""
        path = self.image_path(request)
        losetup = self.need("losetup")
        with self.as_user():
            try:
                fd = os.open(path, os.O_RDONLY)
            except OSError as exc:
                raise Refusal("Cannot open %s: %s"
                              % (path, exc.strerror or exc))
        try:
            if not stat.S_ISREG(os.fstat(fd).st_mode):
                raise Refusal("%s is not an ordinary file." % path)
        finally:
            os.close(fd)
        self.step(request, 1, 1, "attach", "Opening the image")
        out = self.tool([losetup, "--find", "--show", "--partscan",
                         "--read-only", path], "Opening the image",
                        timeout=120)
        self.settle()
        device = out.strip().splitlines()[-1] if out.strip() else ""
        if not device.startswith(DEV_ROOT + "/loop"):
            raise Refusal("The image was opened, but not where expected.")
        return {"device": device, "path": path}

    def op_image_detach(self, request):
        device = self.target(request, system=True, writable=False)
        if device.is_partition or not device.name.startswith("loop"):
            raise Refusal("%s is not an opened image." % device.path)
        losetup = self.need("losetup")
        mounted = bool(self.mounts_of(device))
        if mounted:
            self.need("umount")
        self.step(request, 1, 1, "detach", "Closing the image")
        if mounted:
            self.unmount(device)
        self.tool([losetup, "--detach", device.path], "Closing the image",
                  timeout=120)
        self.settle()
        return {"device": device.path}

    # ---- RAID arrays ----------------------------------------------------------------

    def _arrays(self):
        """Arrays whose members are connected, as mdadm reads them off the
        members themselves: [{"uuid", "level", "devices", "name"}]."""
        mdadm = self.need("mdadm")
        try:
            _code, out, _err = self.run_tool(
                [mdadm, "--examine", "--scan", "--verbose"], None, 300)
        except (OSError, subprocess.SubprocessError) as exc:
            raise Refusal("The drives could not be examined: %s" % exc)
        found = []
        for block in re.split(r"\n(?=ARRAY )", out):
            text = " ".join(block.split())
            uuid = re.search(r"UUID=([0-9a-fA-F:]+)", text)
            if not text.startswith("ARRAY") or not uuid:
                continue
            level = re.search(r"level=(\S+)", text)
            count = re.search(r"num-devices=(\d+)", text)
            name = re.search(r"name=(\S+)", text)
            # Not the "num-devices=" before it on the same line.
            members = re.search(r"(?<![-\w])devices=(\S+)", text)
            found.append({
                "uuid": uuid.group(1),
                "level": level.group(1) if level else "",
                "devices": int(count.group(1)) if count else 0,
                "name": name.group(1) if name else "",
                "members": members.group(1).split(",") if members else []})
        return found

    def _running(self):
        """{array uuid: device path} for arrays that are assembled."""
        mdadm = self.need("mdadm")
        try:
            _code, out, _err = self.run_tool([mdadm, "--detail", "--scan"],
                                             None, 120)
        except (OSError, subprocess.SubprocessError):
            return {}
        found = {}
        for line in out.splitlines():
            uuid = re.search(r"UUID=([0-9a-fA-F:]+)", line)
            parts = line.split()
            if uuid and len(parts) > 1 and parts[0] == "ARRAY":
                try:
                    found[uuid.group(1)] = os.path.realpath(parts[1])
                except OSError:
                    found[uuid.group(1)] = parts[1]
        return found

    def op_raid_scan(self, request):
        """Find RAID arrays on the connected drives. Reads only."""
        self.step(request, 1, 1, "scan", "Looking for RAID arrays")
        arrays = self._arrays()
        running = self._running()
        for array in arrays:
            array["device"] = running.get(array["uuid"], "")
            array["present"] = len(array["members"])
        return {"arrays": arrays}

    def op_raid_open(self, request):
        """Put an array together read-only, so that what is on it can be
        read as from one drive. Works with a member missing where the
        array's level allows for that; nothing is written to any member."""
        uuid = request.get("uuid")
        if not isinstance(uuid, str) or not re.match(
                r"^[0-9a-fA-F:]{8,64}$", uuid):
            raise Refusal("That is not an array.")
        mdadm = self.need("mdadm")
        array = next((a for a in self._arrays() if a["uuid"] == uuid), None)
        if array is None:
            raise Refusal("None of the connected drives belongs to that "
                          "array any more.")
        self.step(request, 1, 1, "open", "Putting the array together, "
                  "read-only")
        device = self._running().get(uuid)
        if not device:
            try:
                code, out, err = self.run_tool(
                    [mdadm, "--assemble", "--scan", "--readonly", "--run",
                     "--uuid=%s" % uuid], None, 300)
            except (OSError, subprocess.SubprocessError) as exc:
                raise Refusal("The array could not be put together: %s"
                              % exc)
            self.settle()
            device = self._running().get(uuid)
            if not device:
                raise Refusal(
                    "The array could not be put together:\n%s\n\nToo many "
                    "of its drives may be missing: a RAID 5 can lose one, "
                    "a RAID 6 two, a RAID 0 none."
                    % (_tail(err) or _tail(out) or "no reason given"))
        return {"device": device, "uuid": uuid, "level": array["level"],
                "devices": array["devices"],
                "present": len(array["members"])}

    @staticmethod
    def mapper_name(device):
        """The device-mapper name of a dm-N device, or ""."""
        try:
            with open(os.path.join(SYS_ROOT, "class", "block", device.name,
                                   "dm", "name")) as handle:
                return handle.read().strip()
        except OSError:
            return ""

    def op_raid_close(self, request):
        device = self.target(request, system=True, writable=False)
        built = device.name.startswith("dm-") and re.match(
            r"^kss-raid[05]-\d+$", self.mapper_name(device))
        if device.is_partition or not (device.name.startswith("md")
                                       or built):
            raise Refusal("%s is not a RAID array." % device.path)
        if self.is_system(device):
            raise Refusal("The running system uses this array.")
        self.step(request, 1, 1, "close", "Closing the array")
        if self.mounts_of(device):
            self.need("umount")
            self.unmount(device)
        if built:
            dmsetup = self.need("dmsetup")
            name = self.mapper_name(device)
            self.tool([dmsetup, "remove", name], "Closing the array",
                      timeout=120)
            # And the windows onto its drives, where it had them.
            mapper = os.path.join(DEV_ROOT, "mapper")
            for window in sorted(os.listdir(mapper)
                                 if os.path.isdir(mapper) else ()):
                if re.match(r"^%s-m\d+$" % re.escape(name), window):
                    self.tool([dmsetup, "remove", window],
                              "Closing the array", timeout=120)
        else:
            self.tool([self.need("mdadm"), "--stop", device.path],
                      "Closing the array", timeout=120)
        self.settle()
        return {"device": device.path}

    # ---- an array whose own settings are lost ---------------------------------

    def _guess_members(self, request):
        """The drives named for an array without settings: [(Device or None
        for a missing one, file descriptor or None)], every one checked as
        any target is. Opened read-only and exclusively."""
        members = request.get("members")
        if not isinstance(members, list) or not 2 <= len(members) <= \
                RAID_MOST:
            raise Refusal("Name between 2 and %d drives." % RAID_MOST)
        found, seen = [], set()
        try:
            for member in members:
                if member is None:
                    found.append((None, None))
                    continue
                if not isinstance(member, dict):
                    raise Refusal("That is not a drive.")
                device = self.target(member, system=False, writable=False)
                if device.name in seen:
                    raise Refusal("%s is named twice." % device.path)
                seen.add(device.name)
                if self.mounts_of(device):
                    raise Refusal("%s is mounted. Unmount it first: a drive "
                                  "of an array is read as part of it, not "
                                  "on its own." % device.path)
                found.append((device, self.open_exclusive(device, False)))
        except Exception:
            for _device, fd in found:
                if fd is not None:
                    os.close(fd)
            raise
        missing = sum(1 for device, _fd in found if device is None)
        if missing > 1:
            raise Refusal("A RAID 5 can be read with one drive missing, "
                          "not more.")
        if len(found) - missing < 2:
            raise Refusal("At least two of the drives must be connected.")
        return found

    @staticmethod
    def _array_starts(fds):
        """[(member index, offset)] of places that look like the first
        sector of an array: a partition table or the start of a filesystem,
        within the first part of each drive, partition tables first."""
        tables, filesystems = [], []
        for index, fd in enumerate(fds):
            if fd is None:
                continue
            for base in range(0, RAID_START_SEARCH, MIB):
                try:
                    block = os.pread(fd, MIB + 65536 + 8, base)
                except OSError:
                    break
                if len(block) < 4096:
                    break
                for place in range(0, min(MIB, len(block) - 4096 + 1), 4096):
                    kind = _start_kind(block, place)
                    if kind == "table":
                        tables.append((index, base + place))
                    elif kind:
                        filesystems.append((index, base + place))
                if len(tables) + len(filesystems) > 64:
                    break
        return (tables + filesystems)[:RAID_STARTS]

    def op_raid_guess(self, request):
        """Work out how the drives of an array whose own record of it is
        gone were put together: which is first, the size of the pieces data
        is cut into, and for RAID 5 where the parity goes. Reads only.

        Every candidate is judged by structures of the filesystem on the
        array that say where they are - an NTFS file record's own number, a
        FAT's chains, a folder's own cluster, a backup copy at a known
        place - read through that candidate. The right one reads them all
        back where they belong; a wrong one breaks them at the first piece
        it puts in the wrong place.
        """
        level = request.get("level") or "auto"
        if level not in ("auto", "raid0", "raid5"):
            raise Refusal("That is not a RAID level this can work out.")
        members = self._guess_members(request)
        devices = [device for device, _fd in members]
        fds = [fd for _device, fd in members]
        try:
            n = len(members)
            missing = None in devices
            size = min(device.size for device in devices if device)
            self.step(request, 1, 2, "level", "Reading the drives")
            if missing or level == "raid5":
                if n < 3:
                    raise Refusal("A RAID 5 has at least three drives.")
                layouts = RAID5_LAYOUTS
            elif level == "raid0":
                layouts = ("raid0",)
            else:
                parity = _parity_holds(fds, size) if n >= 3 else False
                layouts = {True: RAID5_LAYOUTS, False: ("raid0",),
                           None: ("raid0",) + RAID5_LAYOUTS}[parity]
            starts = self._array_starts(fds)
            offsets = sorted({offset for _index, offset in starts} | {0})
            self.step(request, 2, 2, "guess", "Trying how the drives fit "
                      "together")
            tried = []
            combos = [(layout, chunk, offset, order)
                      for offset in offsets[:RAID_STARTS]
                      for layout in layouts for chunk in RAID_CHUNKS
                      for order in _orders(n, layout, starts, offset)]
            if len(combos) > RAID_MOST_TRIES:
                raise Refusal("There are too many ways these drives could "
                              "fit together to try them all.")
            last = 0.0
            for number, (layout, chunk, offset, order) in enumerate(combos):
                self.check_cancel()
                array = _Striped([fds[i] if i is not None else None
                                  for i in order], layout, chunk, offset,
                                 size)
                good, total, kind, slack = _judge(array)
                if total:
                    tried.append({"layout": layout, "chunk": chunk,
                                  "offset": offset, "order": order,
                                  "good": good, "total": total,
                                  "kind": kind, "slack": slack})
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, number + 1, len(combos))
                    last = now
            self.progress(request, len(combos), len(combos))
        finally:
            for fd in fds:
                if fd is not None:
                    os.close(fd)
        # Ranked by the share of checks passed; told apart by how many each
        # fails: one that fails none and one that fails dozens are not a
        # tie, however close their shares.
        tried.sort(key=lambda t: (-t["good"] / t["total"], -t["slack"],
                                  -t["total"]))
        best = tried[0] if tried else None
        sure = False
        why = ""
        if best is None:
            why = ("Nothing on these drives is a filesystem this can check "
                   "(NTFS, FAT32, exFAT or ext4), so how they fit together "
                   "cannot be told from what is on them.")
        else:
            share = best["good"] / best["total"]
            failed = best["total"] - best["good"]
            rivals = [t for t in tried[1:]
                      if t["total"] - t["good"] <= failed + max(
                          RAID_TIE, failed // 2)
                      and t["good"] / t["total"] >= RAID_GOOD
                      and t["slack"] >= best["slack"] - max(
                          RAID_SLACK_TIE, best["slack"] // 10)]
            if share < RAID_GOOD:
                why = ("No way of putting these drives together makes the "
                       "filesystem on them read back as it should. They may "
                       "not all be of one array, or one may be faulty.")
            elif best["total"] < RAID_FEWEST:
                why = ("There is too little on the array to tell for sure.")
            elif rivals:
                why = ("Other ways of putting the drives together read just "
                       "as well; there is too little on the array to tell "
                       "them apart.")
            else:
                sure = True
        def described(t):
            data = n - (1 if t["layout"] != "raid0" else 0)
            return {"layout": t["layout"], "chunk": t["chunk"],
                    "offset": t["offset"],
                    "order": [devices[i].path if i is not None
                              and devices[i] else None for i in t["order"]],
                    "score": round(t["good"] / t["total"], 4),
                    "checks": t["total"], "kind": t["kind"],
                    "size": data * ((size - t["offset"]) // t["chunk"])
                    * t["chunk"]}
        return {"candidates": [described(t) for t in tried[:RAID_SHOWN]],
                "sure": sure, "why": why, "members": n}

    def op_raid_build(self, request):
        """Put an array without settings together read-only, the way
        raid_guess found (or the user chose): device-mapper reads the
        drives, and nothing is written to any of them."""
        layout = request.get("layout")
        chunk = request.get("chunk")
        offset = request.get("offset")
        if layout not in ("raid0",) + RAID5_LAYOUTS:
            raise Refusal("That is not a layout this can put together.")
        if not isinstance(chunk, int) or chunk not in RAID_CHUNKS:
            raise Refusal("That is not a chunk size.")
        if not isinstance(offset, int) or offset < 0 or offset % 512:
            raise Refusal("That is not a place on the drives.")
        members = self._guess_members(request)
        devices = [device for device, _fd in members]
        for _device, fd in members:
            if fd is not None:
                os.close(fd)
        if layout == "raid0" and None in devices:
            raise Refusal("A RAID 0 cannot be read with a drive missing.")
        if layout != "raid0" and len(devices) < 3:
            raise Refusal("A RAID 5 has at least three drives.")
        dmsetup = self.need("dmsetup")
        size = min(device.size for device in devices if device)
        if offset >= size:
            raise Refusal("That is not a place on the drives.")
        rows = (size - offset) // chunk
        data = len(devices) - (0 if layout == "raid0" else 1)
        sectors = data * rows * chunk // 512
        level = "raid0" if layout == "raid0" else "raid5"
        taken = set(os.listdir(os.path.join(DEV_ROOT, "mapper"))) \
            if os.path.isdir(os.path.join(DEV_ROOT, "mapper")) else set()
        number = 1
        while any(n == "kss-%s-%d" % (level, number)
                  or n.startswith("kss-%s-%d-" % (level, number))
                  for n in taken):
            number += 1
        name = "kss-%s-%d" % (level, number)
        self.step(request, 1, 1, "build", "Putting the array together, "
                  "read-only")
        made = []
        try:
            if layout == "raid0":
                table = "0 %d striped %d %d %s" % (
                    sectors, len(devices), chunk // 512, " ".join(
                        "%s %d" % (d.path, offset // 512) for d in devices))
            else:
                # dm-raid without a metadata device does not take a start
                # inside each drive, so where the data starts later, each
                # drive is first seen through a read-only window that
                # begins there.
                paths = []
                for index, device in enumerate(devices):
                    if device is None or not offset:
                        paths.append(device.path if device else "-")
                        continue
                    window = "%s-m%d" % (name, index)
                    self.tool([dmsetup, "create", window, "--readonly",
                               "--table", "0 %d linear %s %d" % (
                                   rows * chunk // 512, device.path,
                                   offset // 512)],
                              "Putting the array together", timeout=120)
                    made.append(window)
                    paths.append(os.path.join(DEV_ROOT, "mapper", window))
                options = ["%d" % (chunk // 512), "nosync"]
                table = "0 %d raid %s %d %s %d %s" % (
                    sectors, layout, len(options), " ".join(options),
                    len(paths), " ".join("- %s" % p for p in paths))
            self.tool([dmsetup, "create", name, "--readonly", "--table",
                       table], "Putting the array together", timeout=120)
        except Refusal:
            for window in reversed(made):
                self.run_tool([dmsetup, "remove", window], None, 120)
            raise
        self.settle()
        try:
            path = os.path.realpath(os.path.join(DEV_ROOT, "mapper", name))
        except OSError:
            path = os.path.join(DEV_ROOT, "mapper", name)
        return {"device": path, "name": name, "size": sectors * 512,
                "layout": layout}

    # ---- drives in trouble ---------------------------------------------------------

    def op_rescan(self, request):
        """Have every disk controller look for drives again: what a restart
        would do, without one."""
        self.step(request, 1, 1, "rescan", "Looking for drives")
        asked = 0
        patterns = (("class/scsi_host", "scan", "- - -"),
                    ("class/nvme", "rescan_controller", "1"))
        for folder, attribute, value in patterns:
            base = os.path.join(SYS_ROOT, folder)
            try:
                names = sorted(os.listdir(base))
            except OSError:
                continue
            for name in names:
                try:
                    with open(os.path.join(base, name, attribute),
                              "w") as handle:
                        handle.write(value)
                    asked += 1
                except OSError:
                    continue
        self.settle()
        time.sleep(1.0)
        self.settle()
        return {"asked": asked}

    def op_drive_log(self, request):
        """What the kernel has logged about a drive since it started."""
        name = request.get("name")
        if not isinstance(name, str) or not NAME_RE.match(name):
            raise Refusal("That is not a device name.")
        dmesg = self.need("dmesg")
        self.step(request, 1, 1, "log", "Reading the system's messages")
        try:
            code, out, err = self.run_tool(
                [dmesg, "--kernel", "--ctime", "--color=never"], None, 60)
        except (OSError, subprocess.SubprocessError) as exc:
            raise Refusal("The system's messages could not be read: %s"
                          % exc)
        if code != 0:
            raise Refusal("The system's messages could not be read: %s"
                          % _tail(err, 2))
        pattern, words = drive_pattern(name)
        lines = [line for line in out.splitlines() if pattern.search(line)]
        return {"name": name, "lines": lines[-200:],
                "matched": words}

    # ---- recovery -------------------------------------------------------------------

    def session_dir(self, request, device):
        """The folder a recovery works in: made by the user beforehand,
        theirs, and not on the drive being read."""
        path = request.get("session")
        if (not isinstance(path, str) or not os.path.isabs(path)
                or "\0" in path or len(path) > 3000):
            raise Refusal("That is not a folder.")
        path = os.path.normpath(path)
        owner = invoking_user()
        try:
            info = os.lstat(path)
            marked = os.lstat(os.path.join(path, SESSION_MARK))
        except OSError:
            raise Refusal("%s is not a recovery folder." % path)
        if not stat.S_ISDIR(info.st_mode) or not stat.S_ISREG(marked.st_mode):
            raise Refusal("%s is not a recovery folder." % path)
        if owner is not None and info.st_uid != owner[0]:
            raise Refusal("%s does not belong to you." % path)
        self.refuse_same_drive(os.path.join(path, SESSION_MARK), device)
        return path

    def target_dir(self, request, device):
        """Where recovered files go: a folder the user chose, theirs, and
        not on the drive being read."""
        path = request.get("target")
        if (not isinstance(path, str) or not os.path.isabs(path)
                or "\0" in path or len(path) > 3000):
            raise Refusal("That is not a folder to recover into.")
        path = os.path.normpath(path)
        owner = invoking_user()
        try:
            info = os.lstat(path)
        except OSError:
            raise Refusal("%s does not exist." % path)
        if not stat.S_ISDIR(info.st_mode):
            raise Refusal("%s is not a folder." % path)
        if owner is not None and info.st_uid != owner[0]:
            raise Refusal("%s does not belong to you." % path)
        # Checked for what goes inside it, not for the folder it is in.
        self.refuse_same_drive(os.path.join(path, SELECTION_NAME), device)
        return path

    def scan_targets(self, device):
        """The devices holding the filesystems of what was selected: the
        partition itself, or each partition of a whole drive."""
        if device.is_partition:
            return [device]
        names = device.partitions()
        return [Device(name) for name in names] if names else [device]

    def op_recover_scan(self, request):
        """Look for what can be recovered. Reads only.

        "deleted": the names, places and sizes of deleted files, as the
        filesystem still has them on record. "content": every sector of the
        device, for files recognisable by what is in them; those are saved
        into the recovery folder as they are found.
        """
        deleted = bool(request.get("deleted"))
        content = bool(request.get("content"))
        records = bool(request.get("records"))
        if not deleted and not content and not records:
            raise Refusal("The request does not say what to look for.")
        kinds = request.get("kinds") or []
        if not isinstance(kinds, list) or not all(
                isinstance(k, str) and k in PHOTOREC_FAMILIES for k in kinds):
            raise Refusal("That is not a kind of file this searches for.")
        command = photorec_command(sorted(set(kinds)),
                                   bool(request.get("keep_damaged")),
                                   bool(request.get("loose")))
        device = self.target(request, system=True, writable=False)
        session = self.session_dir(request, device)
        fls = fsstat = photorec = None
        if deleted:
            fls, fsstat = self.need("fls"), self.need("fsstat")
        if content:
            photorec = self.need("photorec")
        owner = invoking_user()

        names = (["deleted"] if deleted else []) + (
            ["records"] if records else []) + (
            ["content"] if content else [])

        def begin(key, text):
            self.step(request, names.index(key) + 1, len(names), key, text,
                      True)

        result = {"session": session, "deleted": 0, "found": 0,
                  "volumes": [], "unlisted": [], "old": []}
        stopped = ("Stopped. What had been found up to then is kept in %s."
                   % session)
        with self.locked():
            if deleted:
                begin("deleted", "Reading the record of deleted files")
                for part in self.scan_targets(device):
                    self.check_cancel()
                    try:
                        _code, out, _err = self.run_tool(
                            [fsstat, "-t", part.path], None, 300)
                    except (OSError, subprocess.SubprocessError):
                        out = ""
                    kind = out.strip().splitlines()[0] if out.strip() else ""
                    if kind not in UNDELETE_TYPES:
                        # Not an error: these filesystems keep no usable
                        # record of what was deleted.
                        result["unlisted"].append(
                            {"device": part.path, "fstype": kind})
                        continue
                    body = os.path.join(session, BODY_NAME % part.name)
                    with self.as_user():
                        try:
                            out = os.open(body, os.O_WRONLY | os.O_CREAT
                                          | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
                        except OSError as exc:
                            raise Refusal("Cannot write to %s: %s"
                                          % (session, exc.strerror or exc))
                    try:
                        code, lines = self.stream(
                            [fls, "-r", "-d", "-m", "/", part.path],
                            "Listing deleted files", ok=None, stdout=out,
                            stopped_text=stopped)
                    finally:
                        os.close(out)
                    count = 0
                    try:
                        with open(body, "rb") as handle:
                            for line in handle:
                                count += line.count(b"(deleted")
                    except OSError:
                        pass
                    if code != 0 and count == 0:
                        result["unlisted"].append(
                            {"device": part.path, "fstype": kind,
                             "error": "\n".join(lines[-3:])})
                        continue
                    result["deleted"] += count
                    result["volumes"].append(
                        {"device": part.path, "fstype": kind,
                         "body": body, "entries": count})
                    self.note(request, "%d deleted entries on record so far"
                              % result["deleted"])
            if records:
                begin("records", "Looking for the folders of an earlier "
                      "filesystem")
                for part in self.scan_targets(device):
                    self.check_cancel()
                    found = self._collect_records(request, part, session,
                                                  stopped)
                    if found:
                        result["old"].append(found)
            if content:
                begin("content", "Reading every sector of %s for files"
                      % device.path)
                with self.as_user():
                    try:
                        os.makedirs(os.path.join(session, FOUND_DIR),
                                    exist_ok=True)
                    except OSError as exc:
                        raise Refusal("Cannot write to %s: %s"
                                      % (session, exc.strerror or exc))
                found = os.path.join(session, FOUND_DIR)

                def follow(line):
                    seen = re.search(r"Reading sector\s+(\d+)/(\d+)", line)
                    if seen:
                        self.progress(request, int(seen.group(1)) * 512,
                                      int(seen.group(2)) * 512)
                    files = re.search(r"(\d+) files? found", line)
                    if files:
                        self.note(request, "%s files found so far"
                                  % files.group(1))

                try:
                    self.stream(
                        [photorec, "/log", "/d", os.path.join(found, "part"),
                         "/cmd", device.path, command],
                        "Searching by content", on_line=follow, ok=None,
                        keep=10, stopped_text=stopped, cwd=found,
                        env=PHOTOREC_ENV)
                finally:
                    result["found"] = self._hand_over(found, owner)
        return result

    @staticmethod
    def _fat_sector(sector):
        """"entries", "end" (entries, then the folder's end) or None: whether
        a sector reads as FAT folder entries and nothing else."""
        used = 0
        for place in range(0, len(sector), 32):
            entry = sector[place:place + 32]
            first, attr = entry[0], entry[11]
            if first == 0:
                return "end" if used else None
            if first == 0xE5:
                used += 1
                continue
            if attr == 0x0F:
                if not 1 <= first & 0x3F <= 20 or entry[26:28] != b"\0\0" \
                        or entry[12] != 0:
                    return None
            elif attr & 0xC0 \
                    or (first in FAT_NAME_BAD and first != 0x05) \
                    or any(byte in FAT_NAME_BAD for byte in entry[1:11]):
                return None
            used += 1
        return "entries"

    @staticmethod
    def _exfat_sector(sector):
        """The same for exFAT folder entries."""
        used = 0
        for place in range(0, len(sector), 32):
            kind = sector[place]
            if kind == 0:
                return "end" if used else None
            if kind not in EXFAT_TYPES:
                return None
            used += 1
        return "entries"

    def _dir_run(self, fd, start, size, judge):
        """The folder sectors from `start` on, while each one reads as
        folder entries. Returns bytes, possibly empty."""
        run = []
        place = start
        while place < size and len(run) * 512 < LONGEST_DIR:
            try:
                sector = os.pread(fd, 512, place)
            except OSError:
                break
            if len(sector) < 512:
                break
            verdict = judge(sector)
            if verdict is None:
                break
            run.append(sector)
            place += 512
            if verdict == "end":
                break
        return b"".join(run)

    def _dir_starts(self, data, offset):
        """[(place, judge)] of sectors in a block read from the device that
        look like the first sector of a FAT or exFAT folder."""
        found = []
        place = data.find(FAT_DOT)
        while place >= 0:
            if place % 512 == 0 and data[place + 11:place + 12] \
                    and data[place + 11] & 0x10 \
                    and data[place + 32:place + 43] == FAT_DOTDOT \
                    and data[place + 43] & 0x10:
                found.append((offset + place, self._fat_sector))
            place = data.find(FAT_DOT, place + 1)
        for match in EXFAT_SET.finditer(data):
            place = match.start()
            if place % 32 == 0:
                found.append((offset + place - place % 512,
                              self._exfat_sector))
        return found

    def _collect_records(self, request, part, session, stopped):
        """Copy every NTFS file record found on a device into the recovery
        folder. Nothing is judged here: which of them are of an earlier
        filesystem, and what they say, is for the reading of that file."""
        target = os.path.join(session, RECORDS_NAME % part.name)
        with self.as_user():
            try:
                out = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC
                              | os.O_NOFOLLOW, 0o644)
            except OSError as exc:
                raise Refusal("Cannot write to %s: %s"
                              % (session, exc.strerror or exc))
        folders = os.path.join(session, DIRS_NAME % part.name)
        with self.as_user():
            try:
                dirs_out = os.open(folders, os.O_WRONLY | os.O_CREAT
                                   | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
            except OSError as exc:
                os.close(out)
                raise Refusal("Cannot write to %s: %s"
                              % (session, exc.strerror or exc))
        count = dir_count = 0
        try:
            fd = os.open(part.path, os.O_RDONLY)
        except OSError as exc:
            os.close(out)
            os.close(dirs_out)
            raise Refusal("Cannot read %s: %s"
                          % (part.path, exc.strerror or exc))
        try:
            boot = os.pread(fd, 512, 0)
            table = b""
            if boot[3:11] == b"NTFS    ":
                sector = int.from_bytes(boot[0x0B:0x0D], "little")
                per = boot[0x0D]
                if sector in (512, 1024, 2048, 4096) and per:
                    cluster = boot_cluster("ntfs", boot)
                    place = int.from_bytes(boot[0x30:0x38],
                                           "little") * cluster
                    if 0 < place < part.size:
                        table = os.pread(fd, NTFS_RECORD, place)
            offset = 0
            dirs_end = 0
            last = 0.0
            step = 8 * MIB
            while offset < part.size and count < MOST_RECORDS:
                self.check_cancel()
                try:
                    data = os.pread(fd, step, offset)
                except OSError:
                    # An unreadable stretch: nothing to find in it.
                    offset += step
                    continue
                if not data:
                    break
                place = data.find(b"FILE")
                while place >= 0:
                    if place % 512 == 0:
                        if place + NTFS_RECORD <= len(data):
                            record = data[place:place + NTFS_RECORD]
                        else:
                            try:
                                record = os.pread(fd, NTFS_RECORD,
                                                  offset + place)
                            except OSError:
                                record = b""
                        if len(record) == NTFS_RECORD:
                            os.write(out, (offset + place).to_bytes(
                                8, "little") + record)
                            count += 1
                    place = data.find(b"FILE", place + 4)
                # Folders of FAT and exFAT. A run already taken is not
                # started again from a sector inside it.
                taken = 0
                for start, judge in sorted(self._dir_starts(data, offset),
                                           key=lambda item: item[0]):
                    if start < max(taken, dirs_end) \
                            or dir_count >= MOST_DIRS:
                        continue
                    run = self._dir_run(fd, start, part.size, judge)
                    if run:
                        os.write(dirs_out, start.to_bytes(8, "little")
                                 + len(run).to_bytes(8, "little") + run)
                        dir_count += 1
                        taken = start + len(run)
                dirs_end = max(dirs_end, taken)
                offset += len(data)
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, min(offset, part.size), part.size)
                    self.note(request, "%d file records and %d folders "
                              "found so far" % (count, dir_count))
                    last = now
            self.progress(request, part.size, part.size)
            root = self._current_root(fd, boot, part.size)
        except Cancelled:
            raise Cancelled(stopped)
        finally:
            os.close(fd)
            os.close(out)
            os.close(dirs_out)
        for name, number in ((target, count), (folders, dir_count)):
            if not number:
                with self.as_user():
                    try:
                        os.unlink(name)
                    except OSError:
                        pass
        if not count and not dir_count:
            return None
        info = os.path.join(session, RECORDS_INFO % part.name)
        with self.as_user():
            try:
                with open(info, "w") as handle:
                    json.dump({"device": part.path, "size": part.size,
                               "boot": boot.hex(), "table": table.hex(),
                               "root": root.hex()}, handle)
            except OSError:
                pass
        return {"device": part.path, "info": info,
                "records": target if count else "", "count": count,
                "dirs": folders if dir_count else "", "folders": dir_count}

    @staticmethod
    def _current_root(fd, boot, size):
        """The first part of the top folder of the FAT or exFAT filesystem
        on the device now (the app tells its folders from older ones by
        what this reaches), or b"" when there is none."""
        if len(boot) < 512 or boot[510:512] != b"\x55\xaa":
            return b""
        if boot[3:11] == b"EXFAT   ":
            if not 9 <= boot[108] <= 12 or boot[109] > 16:
                return b""
            sector = 1 << boot[108]
            cluster = boot_cluster("exfat", boot)
            heap = int.from_bytes(boot[88:92], "little") * sector
            first = int.from_bytes(boot[96:100], "little")
            place, length = heap + (first - 2) * cluster, cluster
        else:
            sector = int.from_bytes(boot[11:13], "little")
            per = boot[13]
            if sector not in (512, 1024, 2048, 4096) or not per \
                    or per & (per - 1):
                return b""
            reserved = int.from_bytes(boot[14:16], "little")
            entries = int.from_bytes(boot[17:19], "little")
            fat = int.from_bytes(boot[22:24], "little") \
                or int.from_bytes(boot[36:40], "little")
            if not boot[16] or not fat:
                return b""
            start = (reserved + boot[16] * fat) * sector
            if entries:
                place, length = start, entries * 32
            else:
                first = int.from_bytes(boot[44:48], "little")
                place = start + (first - 2) * sector * per
                length = sector * per
        length = min(length, LONGEST_DIR)
        if place < 0 or place + length > size:
            return b""
        try:
            return os.pread(fd, length, place)
        except OSError:
            return b""

    def _copy_extents(self, device, extents, out, size):
        """Write the stretches of a device a file's record names into a
        file, in order; a stretch with no place is one never written, and
        becomes zeros."""
        fd = os.open(device, os.O_RDONLY)
        written = 0
        try:
            for place, length in extents:
                while length > 0 and written < size:
                    self.check_cancel()
                    count = min(length, CHUNK, size - written)
                    if place is None:
                        data = b"\0" * count
                    else:
                        data = os.pread(fd, count, place)
                        if len(data) < count:
                            data += b"\0" * (count - len(data))
                        place += count
                    view = memoryview(data)
                    while view:
                        view = view[os.write(out, view):]
                    written += count
                    length -= count
        finally:
            os.close(fd)
        return written

    @staticmethod
    def _hand_over(folder, owner):
        """Give what a tool run as root wrote into the recovery folder to
        the user. Returns how many files there are."""
        count = 0
        for base, dirs, files in os.walk(folder):
            for name in dirs + files:
                path = os.path.join(base, name)
                try:
                    if owner is not None and not os.path.islink(path):
                        os.chown(path, owner[0], owner[1])
                except OSError:
                    pass
            count += sum(1 for name in files
                         if not name.startswith(("photorec.", "report.")))
        return count

    @staticmethod
    def _safe_parts(path):
        """A recorded path as folder names that cannot lead out of the
        folder they are written under."""
        parts = []
        for piece in str(path).replace("\\", "/").split("/"):
            piece = "".join(c for c in piece if ord(c) >= 32 and c != "\x7f")
            piece = piece.strip()
            if piece in ("", ".", ".."):
                continue
            parts.append(piece[:200])
        return parts or ["unnamed"]

    def op_recover_files(self, request):
        """Copy chosen deleted files out, into the recovery folder, under
        the names and folders they had."""
        device = self.target(request, system=True, writable=False)
        session = self.session_dir(request, device)
        icat = self.find_tool("icat")
        allowed = {part.path for part in self.scan_targets(device)}
        try:
            with self.as_user(), open(os.path.join(
                    session, SELECTION_NAME), encoding="utf-8") as handle:
                chosen = json.load(handle)
        except (OSError, ValueError) as exc:
            raise Refusal("The list of files to recover could not be read: "
                          "%s" % exc)
        if not isinstance(chosen, list) or not chosen:
            raise Refusal("No files were chosen.")
        if icat is None and any(isinstance(e, dict) and "extents" not in e
                                for e in chosen):
            raise Refusal("The 'icat' command is not installed.")
        sizes = {part.path: part.size for part in self.scan_targets(device)}
        for entry in chosen:
            good = isinstance(entry, dict) and entry.get("device") in allowed
            if good and "extents" in entry:
                # A file known from an old record: the places it names are
                # read, so they have to be places on this device.
                limit = sizes[entry["device"]]
                wanted = entry.get("size")
                good = (isinstance(entry["extents"], list)
                        and isinstance(wanted, int)
                        and 0 < wanted <= limit
                        and isinstance(entry.get("inline", ""), str)
                        and all(isinstance(e, list) and len(e) == 2
                                and isinstance(e[1], int) and e[1] > 0
                                and (e[0] is None or (
                                    isinstance(e[0], int) and 0 <= e[0]
                                    and e[0] + e[1] <= limit))
                                for e in entry["extents"]))
            elif good:
                good = bool(re.match(r"^[0-9]+(-[0-9]+){0,2}$",
                                     str(entry.get("inode", ""))))
            if not good:
                raise Refusal("The list of files to recover is not valid.")
        total = sum(int(entry.get("size") or 0) for entry in chosen) or 1
        root = self.target_dir(request, device)
        done = 0
        last = 0.0
        recovered, failed = [], []
        stopped = ("Stopped. The files recovered up to then are in %s."
                   % root)
        with self.locked():
            self.step(request, 1, 1, "recover", "Recovering %d files"
                      % len(chosen), True)
            for entry in chosen:
                self.check_cancel()
                parts = self._safe_parts(entry.get("path", ""))
                with self.as_user():
                    try:
                        folder = os.path.join(root, *parts[:-1])
                        os.makedirs(folder, exist_ok=True)
                        target = os.path.join(folder, parts[-1])
                        serial = 1
                        while os.path.lexists(target):
                            serial += 1
                            stem, dot, ext = parts[-1].rpartition(".")
                            target = os.path.join(folder, "%s (%d)%s%s" % (
                                stem or ext, serial, dot,
                                ext if stem else ""))
                        out = os.open(target, os.O_WRONLY | os.O_CREAT
                                      | os.O_EXCL | os.O_NOFOLLOW, 0o644)
                    except OSError as exc:
                        if exc.errno in (errno.ENOSPC, errno.EDQUOT):
                            raise Refusal(
                                "The drive the files are being recovered "
                                "to is full. %d were recovered before that."
                                % len(recovered))
                        failed.append({"path": entry.get("path", ""),
                                       "error": exc.strerror or str(exc)})
                        continue
                try:
                    if "extents" in entry:
                        code, lines = 0, []
                        try:
                            if entry.get("inline"):
                                os.write(out, bytes.fromhex(entry["inline"]))
                            else:
                                self._copy_extents(
                                    entry["device"], entry["extents"], out,
                                    entry["size"])
                        except (OSError, ValueError) as exc:
                            code, lines = 1, [str(exc)]
                        except Cancelled:
                            raise Cancelled(stopped)
                    else:
                        code, lines = self.stream(
                            [icat, "-r", entry["device"],
                             str(entry["inode"])],
                            "Recovering a file", ok=None, stdout=out,
                            stopped_text=stopped)
                    os.fsync(out)
                    size = os.fstat(out).st_size
                finally:
                    os.close(out)
                wanted = int(entry.get("size") or 0)
                if code != 0 or (wanted and size == 0):
                    failed.append({"path": entry.get("path", ""),
                                   "error": "\n".join(lines[-2:])
                                   or "nothing could be read"})
                    with self.as_user():
                        try:
                            os.unlink(target)
                        except OSError:
                            pass
                else:
                    recovered.append({"path": entry.get("path", ""),
                                      "file": target, "size": size,
                                      "short": bool(wanted
                                                    and size < wanted)})
                done += wanted
                now = time.monotonic()
                if now - last >= PROGRESS_INTERVAL:
                    self.progress(request, min(done, total), total)
                    last = now
            self.progress(request, total, total)
        report = os.path.join(session, "recovered.json")
        with self.as_user():
            try:
                with open(report, "w", encoding="utf-8") as handle:
                    json.dump({"recovered": recovered, "failed": failed},
                              handle)
            except OSError:
                pass
        return {"session": session, "folder": root,
                "recovered": len(recovered), "failed": len(failed),
                "report": report}

    # ---- the recovery stick ---------------------------------------------------------

    def boot_chain(self):
        """How the stick will start the computer: {"signed", "vendor",
        "files": [(name on the stick under EFI/BOOT, source)], "mkimage"}.

        A signed shim and the GRUB signed with it, taken from this system,
        start with Secure Boot on. `fbx64.efi` is never taken: started from
        a removable drive it writes boot entries into the computer's
        firmware. Without anything signed, GRUB is built from its modules
        and Secure Boot has to be off. None when neither is possible.
        """
        def find(folder, *names):
            try:
                present = {n.lower(): n for n in os.listdir(folder)}
            except OSError:
                return None
            for name in names:
                if name.lower() in present:
                    path = os.path.join(folder, present[name.lower()])
                    if os.path.isfile(path):
                        return path
            return None

        for root in EFI_ROOTS:
            try:
                vendors = sorted(os.listdir(root))
            except OSError:
                continue
            for vendor in vendors:
                folder = os.path.join(root, vendor)
                if vendor.upper() == "BOOT" or not os.path.isdir(folder):
                    continue
                shim = find(folder, "shimx64.efi")
                grub = find(folder, "grubx64.efi")
                if shim and grub:
                    files = [("BOOTX64.EFI", shim), ("grubx64.efi", grub)]
                    manager = find(folder, "mmx64.efi")
                    if manager:
                        files.append(("mmx64.efi", manager))
                    return {"signed": True, "vendor": vendor.lower(),
                            "files": files}
        for shim, grub, manager in PACKAGED_SHIMS:
            if os.path.isfile(shim) and os.path.isfile(grub):
                files = [("BOOTX64.EFI", shim), ("grubx64.efi", grub)]
                if os.path.isfile(manager):
                    files.append(("mmx64.efi", manager))
                return {"signed": True, "vendor": self.os_id(),
                        "files": files}
        mkimage = self.find_tool("grub2-mkimage", "grub-mkimage")
        modules = next((d for d in GRUB_MODULE_DIRS
                        if os.path.isfile(os.path.join(d, "linux.mod"))),
                       None)
        if mkimage and modules:
            return {"signed": False, "vendor": "", "files": [],
                    "mkimage": [mkimage, "-O", "x86_64-efi", "-d", modules,
                                "-p", "/EFI/BOOT"] + list(GRUB_MODULES)}
        return None

    @staticmethod
    def os_id():
        try:
            with open(OS_RELEASE) as handle:
                for line in handle:
                    if line.startswith("ID="):
                        return line[3:].strip().strip('"').lower()
        except OSError:
            pass
        return "linux"

    @staticmethod
    def grub_config(uuid):
        """The boot menu: the recovery system, the same with messages on
        screen and a detailed log, and the firmware's settings."""
        line = "kss.stick=%s" % uuid
        return (
            "set timeout=5\n"
            "set default=0\n"
            "search --no-floppy --fs-uuid --set=root %s\n"
            "set gfxpayload=keep\n"
            "\n"
            "menuentry 'KSysSupervisor Recovery' {\n"
            "    linux /%s/vmlinuz %s quiet loglevel=3\n"
            "    initrd /%s/initrd.img\n"
            "}\n"
            "menuentry 'KSysSupervisor Recovery - troubleshooting (messages "
            "on screen, detailed log on the stick)' {\n"
            "    linux /%s/vmlinuz %s kss.debug loglevel=7\n"
            "    initrd /%s/initrd.img\n"
            "}\n"
            "menuentry 'Firmware settings (BIOS/UEFI)' {\n"
            "    fwsetup\n"
            "}\n" % (uuid, RESCUE_FOLDER, line, RESCUE_FOLDER,
                      RESCUE_FOLDER, line, RESCUE_FOLDER))

    def staged_files(self, request):
        """The kernel and the system the app put together, opened as the
        user who asked: only regular files of theirs, never through a
        symlink - a link in their folder cannot carry a file only root may
        read onto the stick. [(name, fd, size, sha256 the app reported)]."""
        stage = request.get("stage")
        if not isinstance(stage, str) or not os.path.isabs(stage) \
                or "\0" in stage or len(stage) > 4000:
            raise Refusal("That is not a folder.")
        expected = request.get("files")
        if not isinstance(expected, dict):
            raise Refusal("The request does not list the files to write.")
        owner = invoking_user()
        opened = []
        try:
            with self.as_user():
                for name in RESCUE_FILES:
                    want = expected.get(name)
                    if not isinstance(want, dict) or not isinstance(
                            want.get("sha256"), str):
                        raise Refusal("The request does not describe %s."
                                      % name)
                    path = os.path.join(os.path.normpath(stage), name)
                    try:
                        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW
                                     | os.O_CLOEXEC)
                    except OSError as exc:
                        raise Refusal("%s could not be opened: %s"
                                      % (path, exc.strerror or exc))
                    opened.append(fd)
                    info = os.fstat(fd)
                    if not stat.S_ISREG(info.st_mode):
                        raise Refusal("%s is not a plain file." % path)
                    if owner is not None and info.st_uid != owner[0]:
                        raise Refusal("%s does not belong to you, so it is "
                                      "not copied." % path)
                    if info.st_size != want.get("size"):
                        raise Refusal("%s changed after it was made. Make "
                                      "the stick again." % path)
        except BaseException:
            for fd in opened:
                os.close(fd)
            raise
        return [(name, fd, os.fstat(fd).st_size, expected[name]["sha256"])
                for name, fd in zip(RESCUE_FILES, opened)]

    def copy_in(self, request, fd, destination, done, total):
        """One file onto the mounted stick, hashed as it goes; returns the
        new count of bytes copied and the file's SHA-256."""
        digest = hashlib.sha256()
        os.makedirs(os.path.dirname(destination), exist_ok=True)
        offset = 0
        with open(destination, "wb") as out:
            while True:
                self.check_cancel()
                chunk = os.pread(fd, CHUNK, offset)
                if not chunk:
                    break
                out.write(chunk)
                digest.update(chunk)
                offset += len(chunk)
                done += len(chunk)
                self.progress(request, done, total)
            out.flush()
            os.fsync(out.fileno())
        return done, digest.hexdigest()

    def op_rescue_write(self, request):
        """Make a drive the recovery stick: one FAT32 partition (what every
        UEFI firmware reads) holding the boot loader, the kernel and the
        system the app put together. Everything on the drive is erased.

        MBR rather than GPT and an ordinary FAT partition rather than an
        EFI System one: firmware starts \\EFI\\BOOT\\BOOTX64.EFI from any FAT
        partition of a removable drive, and every system, Windows and
        macOS included, shows the stick and lets its free space be used.
        """
        verify = request.get("verify", True) is not False
        device = self.target(request)
        if device.is_partition:
            raise Refusal("The recovery stick takes a whole drive.")
        self.refuse_stacked(device)
        if device.size < RESCUE_MIN:
            raise Refusal("%s is too small: the recovery stick needs at "
                          "least %s." % (device.path,
                                         _megabytes(RESCUE_MIN)))
        if device.size > 2 ** 32 * device.logical_sector:
            raise Refusal("%s is larger than an MBR partition table can "
                          "describe (2 TiB). Use a smaller stick."
                          % device.path)
        chain = self.boot_chain()
        if chain is None:
            raise Refusal(
                "No boot loader for UEFI was found on this system: neither "
                "a signed shim with GRUB (in the EFI partition, or from the "
                "shim-signed and grub-efi-amd64-signed packages) nor GRUB's "
                "EFI modules (grub2-efi-x64-modules) to build one.")
        self.need("sfdisk", "wipefs", "blkid", "mount", "umount")
        self.need(*FILESYSTEMS["vfat"]["mkfs"])
        files = self.staged_files(request)
        try:
            payload = sum(size for _n, _fd, size, _s in files)
            if payload + 64 * MIB > device.size:
                raise Refusal("%s is too small for the recovery system "
                              "(%s)." % (device.path, _megabytes(payload)))
            mounted = bool(self.mounts_of(device))
            names = (["unmount"] if mounted else []) + [
                "erase", "table", "mkfs", "copy"] + (
                ["verify"] if verify else [])

            def begin(key, text, cancellable=False):
                self.step(request, names.index(key) + 1, len(names), key,
                          text, cancellable)

            with self.locked():
                if mounted:
                    begin("unmount", "Unmounting %s" % device.path, True)
                    self.unmount(device)
                self.check_cancel()
                self.assert_free(device)
                self.destroying = True
                begin("erase", "Erasing the old signatures on %s"
                      % device.path)
                for name in device.partitions():
                    try:
                        self.wipe_signatures(Device(name))
                    except Refusal:
                        pass
                self.wipe_signatures(device)
                begin("table", "Creating a new MBR partition table")
                volume = self.new_table(device, "dos", "c", bootable=True)
                begin("mkfs", "Creating the FAT32 filesystem")
                self.make_filesystem(self.mkfs_argv(
                    "vfat", volume, RESCUE_LABEL, None, None))
                self.settle()
                found = self.verify_filesystem(volume, "vfat", RESCUE_LABEL)
                uuid = found.get("UUID", "")
                if not FAT_ID_RE.match(uuid):
                    raise Refusal("The new filesystem's ID could not be "
                                  "read back.")

                begin("copy", "Copying the recovery system", True)
                sums = {}
                with self.mounted_somewhere(volume, "vfat") as point:
                    boot = os.path.join(point, "EFI", "BOOT")
                    os.makedirs(boot, exist_ok=True)
                    for name, source in chain["files"]:
                        target = os.path.join(boot, name)
                        shutil.copyfile(source, target)
                        sums["EFI/BOOT/" + name] = _sha256_file(target)
                    if not chain["signed"]:
                        target = os.path.join(boot, "BOOTX64.EFI")
                        self.tool(chain["mkimage"] + ["-o", target],
                                  "Building the boot loader", timeout=300)
                        sums["EFI/BOOT/BOOTX64.EFI"] = _sha256_file(target)
                    config = self.grub_config(uuid)
                    places = ["EFI/BOOT/grub.cfg"]
                    if chain["vendor"]:
                        places.append("EFI/%s/grub.cfg" % chain["vendor"])
                    for place in places:
                        target = os.path.join(point, *place.split("/"))
                        os.makedirs(os.path.dirname(target), exist_ok=True)
                        with open(target, "w") as handle:
                            handle.write(config)
                            handle.flush()
                            os.fsync(handle.fileno())
                        sums[place] = hashlib.sha256(
                            config.encode()).hexdigest()
                    done = 0
                    for name, fd, _size, wanted in files:
                        place = "%s/%s" % (RESCUE_FOLDER, name)
                        done, got = self.copy_in(
                            request, fd, os.path.join(point, RESCUE_FOLDER,
                                                      name), done, payload)
                        if got != wanted:
                            raise Refusal(
                                "%s changed after it was made (its "
                                "checksum differs). Make the stick again."
                                % name)
                        sums[place] = got
                    for folder in ("state", "logs"):
                        os.makedirs(os.path.join(point, "KSysSupervisor",
                                                 folder), exist_ok=True)
                    os.sync()
                self.cancellable = False

                if verify:
                    begin("verify", "Reading the stick back and comparing "
                          "it")
                    self.drop_caches(volume)
                    with self.mounted_somewhere(volume, "vfat",
                                                ("ro",)) as point:
                        for place, wanted in sorted(sums.items()):
                            path = os.path.join(point, *place.split("/"))
                            try:
                                got = _sha256_file(path)
                            except OSError as exc:
                                raise Refusal("%s cannot be read back from "
                                              "the stick: %s" % (
                                                  place, exc.strerror))
                            if got != wanted:
                                raise Refusal(
                                    "%s reads back differently from what "
                                    "was written. The stick may be failing;"
                                    " try another one." % place)
        finally:
            for _name, fd, _size, _sum in files:
                os.close(fd)
        return {"device": device.path, "volume": volume.path, "uuid": uuid,
                "secure_boot": chain["signed"], "vendor": chain["vendor"],
                "verified": verify, "size": payload}

    def drop_caches(self, volume):
        """What was just written is read back from the stick, not from
        memory."""
        try:
            fd = os.open(volume.path, os.O_RDONLY)
            try:
                os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
            finally:
                os.close(fd)
            with open("/proc/sys/vm/drop_caches", "w") as handle:
                handle.write("1\n")
        except OSError:
            pass

